---
/**
 * The enquiry form on /contact.
 *
 * `src/scripts/contact-form.ts` drives it through the `data-contact` hooks:
 * it checks the fields, says what's wrong under each one, and hands a finished
 * enquiry to the visitor's mail app — there is no endpoint behind it. Each
 * field's `data-field` is the name its error uses for it.
 *
 * A field's hover and focus are rings laid over it and faded in, so moving
 * through the form repaints nothing.
 */
import { BUDGETS, SERVICE_CHOICES } from "@/components/contact/copy.ts";
---

<form class="enquiry-form" data-contact novalidate>
  <div class="enquiry-form_row">
    <div class="enquiry-field">
      <label class="enquiry-field_label" for="contact-name">Your name</label>
      <span class="enquiry-field_box">
        <input
          class="enquiry-field_input"
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          aria-describedby="contact-name-error"
          data-field="your name"
          required
        />
        <span class="enquiry-field_ring" aria-hidden="true"></span>
      </span>
      <p class="enquiry-field_error" id="contact-name-error"></p>
    </div>

    <div class="enquiry-field">
      <label class="enquiry-field_label" for="contact-email">Email</label>
      <span class="enquiry-field_box">
        <input
          class="enquiry-field_input"
          id="contact-email"
          name="email"
          type="email"
          inputmode="email"
          autocomplete="email"
          aria-describedby="contact-email-error"
          data-field="your email"
          required
        />
        <span class="enquiry-field_ring" aria-hidden="true"></span>
      </span>
      <p class="enquiry-field_error" id="contact-email-error"></p>
    </div>
  </div>

  <div class="enquiry-form_row">
    <div class="enquiry-field">
      <label class="enquiry-field_label" for="contact-company">
        Company <span class="enquiry-field_hint">optional</span>
      </label>
      <span class="enquiry-field_box">
        <input
          class="enquiry-field_input"
          id="contact-company"
          name="company"
          type="text"
          autocomplete="organization"
        />
        <span class="enquiry-field_ring" aria-hidden="true"></span>
      </span>
    </div>

    <div class="enquiry-field">
      <label class="enquiry-field_label" for="contact-service">
        What do you need?
      </label>
      <span class="enquiry-field_box enquiry-field_select">
        <select class="enquiry-field_input" id="contact-service" name="service">
          <option value="">Not sure yet</option>
          {
            SERVICE_CHOICES.map((service) => (
              <option value={service}>{service}</option>
            ))
          }
        </select>
        <span class="enquiry-field_ring" aria-hidden="true"></span>
      </span>
    </div>
  </div>

  <fieldset class="enquiry-field">
    <legend class="enquiry-field_label">Budget</legend>
    <div class="enquiry-form_choices">
      {
        BUDGETS.map((budget, index) => (
          <label class="enquiry-choice">
            <input
              type="radio"
              name="budget"
              value={budget}
              checked={index === BUDGETS.length - 1}
            />
            <span>{budget}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="enquiry-field">
    <label class="enquiry-field_label" for="contact-brief">
      What are you building, and what's in the way?
    </label>
    <span class="enquiry-field_box">
      <textarea
        class="enquiry-field_input"
        id="contact-brief"
        name="brief"
        rows="5"
        aria-describedby="contact-brief-error"
        data-field="what you're building"
        required></textarea>
      <span class="enquiry-field_ring" aria-hidden="true"></span>
    </span>
    <p class="enquiry-field_error" id="contact-brief-error"></p>
  </div>

  <div class="enquiry-form_actions">
    <button class="btn btn-blue" type="submit"> Send it over </button>
    {
      /* Announced rather than only shown, so the outcome reaches someone who
         isn't looking at the button. */
    }
    <p
      class="enquiry-form_status"
      data-contact-status
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
</form>

<style is:global>
  @layer components {
    .enquiry-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding: clamp(1.25rem, 0.8rem + 2vw, 2.25rem);
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 1.25rem;
      box-shadow: 0 1.5rem 3rem -2rem rgb(13 25 40 / 0.25);
    }

    .enquiry-form_row {
      display: grid;
      gap: 1.5rem;
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    }

    .enquiry-field {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .enquiry-field_label {
      padding: 0;
      font-size: 0.9375rem;
      font-weight: 500;
    }

    /* A flex gap skips a fieldset's legend. */
    legend.enquiry-field_label {
      margin-bottom: 0.55rem;
    }

    .enquiry-field_hint {
      margin-left: 0.35rem;
      color: var(--text-faded);
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .enquiry-field_box {
      --_radius: 0.75rem;
      position: relative;
      display: block;

      /* Under the pointer: a darker ring, faded in. */
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        border: var(--border-width) solid
          color-mix(in srgb, var(--text) 35%, transparent);
        border-radius: var(--_radius);
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--duration-main);
      }

      @media (hover: hover) {
        &:hover::before {
          opacity: 1;
        }
      }
    }

    .enquiry-field_input {
      display: block;
      width: 100%;
      min-height: 3.25rem;
      padding: 0.85rem 1rem;
      background-color: var(--light-200);
      border: var(--border-width) solid var(--border);
      border-radius: var(--_radius);
      color: var(--text);
      font-size: 1rem;

      &:focus-visible {
        outline: none;
      }

      /* Marked invalid only once someone has been in the field, so an
         untouched form never opens red. */
      &:user-invalid,
      &[aria-invalid="true"] {
        border-color: #c4302b;
      }
    }

    /* In the field: the blue ring and its glow, faded in. */
    .enquiry-field_ring {
      position: absolute;
      inset: 0;
      border: var(--border-width) solid var(--brand-500);
      border-radius: var(--_radius);
      box-shadow: 0 0 0 3px
        color-mix(in srgb, var(--brand-500) 22%, transparent);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-main);

      .enquiry-field_input:focus-visible + & {
        opacity: 1;
      }
    }

    .enquiry-field_error {
      margin: 0;
      color: #b3261e;
      font-size: 0.875rem;

      &:empty {
        display: none;
      }
    }

    textarea.enquiry-field_input {
      min-height: 9rem;
      resize: vertical;
      line-height: 1.5;
    }

    /* The select keeps the browser's own control, with the arrow redrawn as
       a chevron so it matches the fields beside it. */
    .enquiry-field_select {
      & select {
        appearance: none;
        padding-right: 2.75rem;
        cursor: pointer;
      }

      &::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 1.15rem;
        width: 0.45rem;
        height: 0.45rem;
        border-right: 1.5px solid currentcolor;
        border-bottom: 1.5px solid currentcolor;
        rotate: 45deg;
        translate: 0 -70%;
        pointer-events: none;
      }
    }

    .enquiry-form_choices {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    /* The radio stays in the page for the keyboard and for screen readers;
       the label is what shows, and takes the focus ring. Chosen, it fills with
       ink: a layer faded in, with the words turning over partway through it,
       one repaint and not one per frame. */
    .enquiry-choice {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      min-height: 2.6rem;
      padding: 0 1.05rem;
      background-color: var(--light-200);
      border: var(--border-width) solid var(--border);
      border-radius: 0.65rem;
      font-size: 0.9375rem;
      cursor: pointer;
      transition: color 0s linear 0.08s;

      & input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset: calc(var(--border-width) * -1);
        border-radius: inherit;
        opacity: 0;
        transition: opacity var(--duration-main);
      }

      &::before {
        z-index: -1;
        background-color: var(--ink-900);
      }

      &::after {
        border: var(--border-width) solid
          color-mix(in srgb, var(--text) 35%, transparent);
      }

      @media (hover: hover) {
        &:hover::after {
          opacity: 1;
        }
      }

      &:has(input:checked) {
        color: var(--light-100);

        &::before {
          opacity: 1;
        }
      }

      &:has(input:focus-visible) {
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: var(--focus-offset);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .enquiry-field_box::before,
      .enquiry-field_ring,
      .enquiry-choice,
      .enquiry-choice::before,
      .enquiry-choice::after {
        transition: none;
      }
    }

    .enquiry-form_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.5rem;
      padding-top: 0.25rem;
    }

    .enquiry-form_status {
      margin: 0;
      font-size: 0.9375rem;

      &:empty {
        display: none;
      }

      &[data-ok] {
        color: var(--brand-700);
      }

      &[data-error] {
        color: #b3261e;
      }
    }
  }
</style>
