---
/**
 * The /contact hero's picture: the two of us, standing in front of the
 * logo's two strokes, with a client's word for it pinned to the corner.
 *
 * The strokes are drawn — two parallelograms at the slant, deep blue and
 * light blue, a gap apart — and the photograph is a cut-out, so the people
 * stand in front of the mark rather than inside a box. The depth between them
 * is a soft pool of shade painted once, not a filter on the cut-out.
 */
import Img from "@/components/Img.astro";
import founders from "@/assets/inparallel/founders.webp";
import portrait from "@/assets/inparallel/testimonials/intaker-joseph-rudolo-portrait.webp";
import { VIDEO_STORIES } from "@/data/parallel.ts";

/* Joseph Rudolo's line: the one about choosing us, for the page where
   people choose. */
const story = VIDEO_STORIES.find((item) => item.client === "Intaker");
---

<figure class="call-visual">
  <figcaption class="call-visual_caption">
    <span class="label">
      <span class="label_slash" aria-hidden="true">//</span>
      <span class="label_text">On the call</span>
    </span>
    <span class="call-visual_who">
      Aleksandar and Darko — both of us, on every project.
    </span>
  </figcaption>
  <div class="call-visual_stage">
    <span class="call-visual_stroke is-one" aria-hidden="true"></span>
    <span class="call-visual_stroke is-two" aria-hidden="true"></span>
    <Img
      src={founders}
      alt="Darko Milošević and Aleksandar Dumić, side by side"
      class="call-visual_photo"
      variant="constrained"
      sizes="(width >= 62rem) 30rem, 80vw"
      loading="eager"
      transparent
    />
  </div>

  {
    story && (
      <blockquote class="call-visual_quote">
        <p class="call-visual_text">
          “{story.quote[0]}
          {story.quote[1]}”
        </p>
        <footer class="call-visual_by">
          <Img
            src={portrait}
            alt=""
            class="call-visual_avatar"
            variant="densities"
            width={44}
            height={44}
          />
          <span>
            <span class="call-visual_name">{story.name}</span>
            <span class="call-visual_meta">
              {story.client}, {story.industry}
            </span>
          </span>
        </footer>
      </blockquote>
    )
  }
</figure>

<style is:global>
  @layer components {
    .call-visual {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 1rem + 1vw, 2rem);
      margin: 0;
      padding-bottom: 3rem;
      /* The mark is sized from the room it has, so it never runs off a
         narrow screen. */
      container-type: inline-size;
    }

    /* The mark at the size of the picture. Each stroke is a fifth of the
       height thick and leans by the slant over its height; the two stand a
       sliver apart, and the stage is exactly as wide as the pair. */
    .call-visual_stage {
      --_h: min(34rem, 88cqw);
      --_t: calc(var(--_h) * 0.2);
      --_gap: calc(var(--_h) * 0.06);
      --_lean: calc(var(--_h) * var(--slant-tan));
      position: relative;
      isolation: isolate;
      width: calc(var(--_t) * 2 + var(--_gap) + var(--_lean));
      height: var(--_h);
      margin-inline: auto;

      /* The shade behind the two of us, lifting them off the strokes. */
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background-image: radial-gradient(
          42% 58% at 50% 62%,
          rgb(6 10 19 / 0.5),
          transparent 72%
        );
      }
    }

    .call-visual_stroke {
      position: absolute;
      top: 0;
      bottom: 0;
      width: calc(var(--_t) + var(--_lean));
      clip-path: polygon(
        var(--_lean) 0,
        100% 0,
        calc(100% - var(--_lean)) 100%,
        0 100%
      );

      &.is-one {
        left: 0;
        background-image:
          repeating-linear-gradient(
            calc(90deg + var(--slant)),
            transparent 0 calc(1.6rem - 1px),
            rgb(255 255 255 / 0.1) calc(1.6rem - 1px) 1.6rem
          ),
          linear-gradient(180deg, #3b82f0, #133f8f);
      }

      &.is-two {
        left: calc(var(--_t) + var(--_gap));
        background-image:
          repeating-linear-gradient(
            calc(90deg + var(--slant)),
            transparent 0 calc(1.6rem - 1px),
            rgb(255 255 255 / 0.14) calc(1.6rem - 1px) 1.6rem
          ),
          linear-gradient(180deg, #a8c8ff, #3d6fc4);
      }
    }

    .call-visual_photo {
      position: absolute;
      bottom: 0;
      left: 50%;
      z-index: 2;
      width: auto;
      height: 100%;
      max-width: none;
      translate: -50% 0;
      object-fit: contain;
      object-position: bottom;
    }

    .call-visual_caption {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;

      & .label {
        color: rgb(255 255 255 / 0.7);
      }
    }

    .call-visual_who {
      color: var(--light-100);
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    /* A client's word for it, pinned over the foot of the picture. */
    .call-visual_quote {
      position: absolute;
      left: 0;
      bottom: 0;
      width: min(22rem, 85%);
      margin: 0;
      padding: 1.1rem 1.25rem;
      background-color: rgb(11 19 34 / 0.9);
      border: var(--border-width) solid rgb(255 255 255 / 0.12);
      border-radius: 1rem;
      box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.6);
    }

    .call-visual_text {
      margin: 0;
      color: var(--light-100);
      font-size: 1.05rem;
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.35;
    }

    .call-visual_by {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-top: 0.9rem;
      font-size: 0.875rem;
      line-height: 1.3;

      & > span {
        display: flex;
        flex-direction: column;
      }
    }

    .call-visual_avatar {
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      object-fit: cover;
      object-position: 50% 18%;
    }

    .call-visual_name {
      color: var(--light-100);
      font-weight: 500;
    }

    .call-visual_meta {
      color: rgb(255 255 255 / 0.6);
    }
  }
</style>
