---
/**
 * "Same brief. Different route." — the name, explained with a diagram.
 *
 * Four tracks of the same project. Run as a relay, each waits for the one
 * before it and passes a baton at every seam; run in parallel, they start
 * together and overlap, and the launch line moves up. The board arrives as a
 * relay and, once it is in view, falls into parallel by itself; the two
 * buttons let a reader compare. Every bar is a parallelogram leaning at the
 * logo's angle, so the "after" picture is the mark, repeated.
 *
 * The change runs on its own while the page scrolls, so everything that moves
 * here moves by `transform` and `opacity` alone.
 *
 * Under it, the five things clients say they didn't get last time.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import { RELAY_TRACKS, VALUES } from "@/data/parallel.ts";
---

<section id="why" class="relay theme-light" aria-labelledby="why-title">
  <div class="relay_inner">
    <SectionHead
      index="04"
      label="Why inParallel"
      align="center"
      headingId="why-title"
      lead="Most agencies run a relay: strategy hands to design, design to development, development to SEO — and every handoff drops something. We run the tracks side by side."
    >
      Same brief. <span class="serif">Different</span> route.
    </SectionHead>

    <figure class="relay_board" data-relay data-mode="relay">
      <div
        class="relay_switch"
        role="group"
        aria-label="Compare the two ways to run a project"
      >
        <button
          type="button"
          class="relay_switch_btn"
          data-relay-mode="relay"
          aria-pressed="true"
        >
          <span>The relay</span>
        </button>
        <button
          type="button"
          class="relay_switch_btn"
          data-relay-mode="parallel"
          aria-pressed="false"
        >
          <span class="slash-mark" aria-hidden="true"><i></i><i></i></span>
          <span>In parallel</span>
        </button>
        <span class="relay_switch_thumb" aria-hidden="true"></span>
      </div>

      <div class="relay_chart">
        <div class="relay_axis" aria-hidden="true">
          <span>Kickoff</span>
        </div>
        <ol class="relay_tracks" role="list">
          {
            RELAY_TRACKS.map((track, index) => (
              <li
                class="relay_track"
                style={`--i: ${index}; --relay-start: ${track.relay[0]}; --relay-end: ${track.relay[1]}; --parallel-start: ${track.parallel[0]}; --parallel-end: ${track.parallel[1]};`}
              >
                <span class="relay_track_name">{track.name}</span>
                <span class="relay_lane" aria-hidden="true">
                  <span class="relay_bar">
                    <span class="relay_bar_fill" />
                  </span>
                  {index > 0 && <span class="relay_baton" title="Handoff" />}
                </span>
              </li>
            ))
          }
        </ol>
        <div class="relay_launch" aria-hidden="true">
          <span class="relay_launch_line"></span>
          <span class="relay_launch_label">Launch</span>
        </div>
      </div>

      <figcaption class="relay_caption" aria-live="polite">
        <span class="relay_caption_text" data-relay-caption="relay">
          Four handoffs, four waits. Whatever the last team misread, the next
          one builds on.
        </span>
        <span class="relay_caption_text" data-relay-caption="parallel">
          Same scope, no handoffs. Design and build move together, and launch
          moves up.
        </span>
      </figcaption>
    </figure>

    <ul class="relay_values" role="list" data-anim-group data-stagger="0.07">
      {
        VALUES.map((value, index) => (
          <li class="relay_value" data-anim="rise">
            <span class="relay_value_index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="relay_value_title">{value.title}</h3>
            <p class="relay_value_text">{value.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const board = document.querySelector<HTMLElement>("[data-relay]");
  if (board) {
    const buttons = [
      ...board.querySelectorAll<HTMLButtonElement>("[data-relay-mode]"),
    ];
    let touched = false;
    const set = (mode: string) => {
      board.dataset.mode = mode;
      for (const button of buttons)
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.relayMode === mode),
        );
    };
    for (const button of buttons)
      button.addEventListener("click", () => {
        touched = true;
        set(button.dataset.relayMode ?? "relay");
      });

    /* Arrives as a relay; once a reader has had a look, it falls into
       parallel by itself — unless they've already picked one. */
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (still) set("parallel");
    else
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          window.setTimeout(() => {
            if (!touched) set("parallel");
          }, 1600);
        },
        { threshold: 0.55 },
      ).observe(board);
  }
</script>

<style is:global>
  @layer components {
    .relay {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--light-200);
    }

    .relay_inner {
      /* The site's container: the Lumos width, the site margin either side. */
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(3rem, 2rem + 3vw, 5rem);
    }

    /* ---- the board ------------------------------------------------------ */
    .relay_board {
      --_ease: cubic-bezier(0.7, 0, 0.2, 1);
      width: 100%;
      margin: 0;
      padding: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 1.25rem;
      box-shadow: 0 1.5rem 3rem -2rem rgb(13 25 40 / 0.25);
    }

    .relay_switch {
      position: relative;
      display: inline-grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: clamp(1.75rem, 1rem + 2vw, 2.75rem);
      padding: 0.3rem;
      background-color: var(--light-300);
      border-radius: 0.75rem;
    }

    .relay_switch_btn {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 2.5rem;
      padding: 0 1.1rem;
      border: 0;
      background: none;
      color: var(--ink-900);
      font: inherit;
      font-size: 0.9375rem;
      font-weight: 500;
      cursor: pointer;

      /* The words fade, rather than change colour, so the thumb sliding under
         them is the only thing being drawn. */
      & > * {
        transition: opacity 0.4s var(--ease-out);
      }

      &[aria-pressed="false"] > * {
        opacity: 0.62;
      }

      @media (hover: hover) {
        &[aria-pressed="false"]:hover > * {
          opacity: 0.9;
        }
      }

      & .slash-mark {
        height: 0.85em;
        --_w: 0.16em;
        --_gap: 0.1em;
      }
    }

    .relay_switch_thumb {
      position: absolute;
      inset: 0.3rem auto 0.3rem 0.3rem;
      width: calc(50% - 0.3rem);
      background-color: var(--light-100);
      border-radius: 0.55rem;
      box-shadow: 0 1px 3px rgb(13 25 40 / 0.12);
      transition: translate 0.6s var(--_ease);

      [data-mode="parallel"] & {
        translate: 100% 0;
      }
    }

    /* ---- the chart ------------------------------------------------------ */
    /* Everything on the time axis is placed in units of the chart's own width
       (`cqw`), because `transform` can't take a percentage of a parent.
       `--_axis` is how much of a lane time runs across: a bar's top right
       corner is a lean past its end, so a bar ending at 100 still stays in. */
    .relay_chart {
      --_names: 11rem;
      --_bh: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);
      --_lean: calc(var(--_bh) * var(--slant-tan));
      --_axis: calc(100cqw - var(--_names) - var(--_lean));
      position: relative;
      container-type: inline-size;
      display: grid;
      grid-template-columns: var(--_names) 1fr;
      row-gap: 0;
    }

    .relay_axis {
      grid-column: 2;
      display: flex;
      padding-bottom: 0.75rem;
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-faded);
    }

    .relay_tracks {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .relay_track {
      --_start: var(--relay-start);
      --_end: var(--relay-end);
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      align-items: center;
      min-height: clamp(3.25rem, 2.5rem + 2vw, 4.5rem);
      border-top: var(--border-width) solid var(--border-soft);

      &:last-child {
        border-bottom: var(--border-width) solid var(--border-soft);
      }

      [data-mode="parallel"] & {
        --_start: var(--parallel-start);
        --_end: var(--parallel-end);
      }
    }

    .relay_track_name {
      padding-right: var(--space-4);
      font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1rem);
      font-weight: 500;
    }

    .relay_lane {
      position: relative;
      height: 100%;
      /* The track itself: a faint hairline through the middle of the lane. */
      background-image: linear-gradient(var(--border-soft), var(--border-soft));
      background-size: 100% 1px;
      background-position: center;
      background-repeat: no-repeat;
    }

    /* A bar is a parallelogram: the mark's stroke, stretched along time. The
       frame is the whole axis, inset by half the lean: skewed from their
       middle, a bar's corners then land exactly on its start and end. */
    .relay_bar {
      position: absolute;
      top: 50%;
      left: calc(var(--_lean) / 2);
      width: var(--_axis);
      height: var(--_bh);
      translate: 0 -50%;
    }

    /* Moved along the axis, skewed, then scaled down to its length. The scale
       comes last in the list, so it runs before the skew and the lean stays
       the logo's at every length. The corners are drawn wide for the same
       reason: scaled, they arrive round. */
    .relay_bar_fill {
      position: absolute;
      inset: 0;
      border-radius: 1rem / 0.3rem;
      background-color: var(--brand-500);
      transform-origin: 0 50%;
      transform: translateX(calc(var(--_axis) * var(--_start) / 100))
        skewX(calc(var(--slant) * -1))
        scaleX(calc((var(--_end) - var(--_start)) / 100));
      transition: transform 1.1s var(--_ease) calc(var(--i) * 0.08s);

      .relay_track:nth-child(2) & {
        background-color: #3d7fe6;
      }
      .relay_track:nth-child(3) & {
        background-color: #5a95ef;
      }
      .relay_track:nth-child(4) & {
        background-color: var(--brand-300);
      }

      /* Run as a relay, every track is the same grey: the old way. It lies
         over the colour and fades off it. */
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background-color: color-mix(
          in srgb,
          var(--ink-900) 22%,
          var(--light-300)
        );
        transition: opacity 0.8s var(--ease-out);
      }

      [data-mode="parallel"] &::after {
        opacity: 0;
      }
    }

    /* The baton changing hands at the seam — only a relay has one. */
    .relay_baton {
      position: absolute;
      top: 50%;
      left: 0;
      width: 0.8rem;
      height: 0.8rem;
      translate: calc(var(--_axis) * var(--_start) / 100 - 0.4rem) -50%;
      border: 2px solid var(--ink-900);
      border-radius: 50%;
      background-color: var(--light-100);
      transition:
        opacity 0.4s,
        scale 0.5s var(--ease-out),
        translate 1.1s var(--_ease) calc(var(--i) * 0.08s);

      [data-mode="parallel"] & {
        opacity: 0;
        scale: 0.2;
      }
    }

    /* The launch line rides the furthest bar's end. */
    .relay_launch {
      --_at: 100;
      position: absolute;
      top: 0;
      bottom: -0.25rem;
      left: calc(var(--_names) + var(--_lean));
      pointer-events: none;
      translate: calc(var(--_axis) * var(--_at) / 100) 0;
      transition: translate 1.2s var(--_ease) 0.2s;

      [data-mode="parallel"] & {
        --_at: 60;
      }
    }

    .relay_launch_line {
      position: absolute;
      top: 1.75rem;
      bottom: 0;
      width: 0;
      border-left: 1.5px dashed var(--ink-900);
    }

    /* At the end of the axis, as a relay, the tag stands inside the line so it
       stays on the board; it centres on the line as the line moves up. */
    .relay_launch_label {
      position: absolute;
      top: 0;
      translate: calc(-100% + 0.5rem) 0;
      transition: translate 1.2s var(--_ease) 0.2s;
      padding: 0.25rem 0.5rem;
      border-radius: 0.35rem;
      background-color: var(--ink-900);
      color: var(--light-100);
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      white-space: nowrap;

      [data-mode="parallel"] & {
        translate: -50% 0;
      }
    }

    .relay_caption {
      display: grid;
      margin-top: 1.75rem;
      color: var(--text-muted);
      font-size: 0.9375rem;
    }

    /* One caption out, then the other in — never both at once. The one
       that's out is hidden outright, so it isn't read out as well; the
       caption is a live region, so the change is announced. */
    .relay_caption_text {
      grid-area: 1 / 1;
      transition: opacity 0.5s var(--ease-out) 0.25s;

      [data-mode="relay"] &[data-relay-caption="parallel"],
      [data-mode="parallel"] &[data-relay-caption="relay"] {
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.25s ease-in,
          visibility 0s 0.25s;
      }
    }

    /* ---- values --------------------------------------------------------- */
    .relay_values {
      width: 100%;
      display: grid;
      /* All five in one row once there is room; three over two before that,
         every row filled; one to a row on a phone. */
      grid-template-columns: minmax(0, 1fr);

      @media (width >= 48rem) {
        grid-template-columns: repeat(6, minmax(0, 1fr));
      }

      @media (width >= 75rem) {
        grid-template-columns: repeat(5, minmax(0, 1fr));
      }
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .relay_value {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.5rem;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 1rem;

      @media (width >= 48rem) and (width < 75rem) {
        grid-column: span 2;

        &:nth-child(n + 4) {
          grid-column: span 3;
        }
      }
    }

    .relay_value_index {
      font-family: var(--mono-family);
      font-size: 0.75rem;
      color: var(--brand-500);
    }

    .relay_value_title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 500;
      letter-spacing: -0.015em;
    }

    .relay_value_text {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    /* ---- narrower ------------------------------------------------------- */
    @media (width < 48rem) {
      .relay_chart {
        --_names: 6.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .relay_bar_fill,
      .relay_bar_fill::after,
      .relay_baton,
      .relay_launch,
      .relay_launch_label,
      .relay_switch_btn > *,
      .relay_switch_thumb {
        transition: none;
      }
    }
  }
</style>
