---
import type { HTMLAttributes } from "astro/types";
import ArrowCircle from "./ArrowCircle.astro";

interface Props extends HTMLAttributes<"a"> {
  href?: string;
  /** Rotates the arrow to point up-right, as the card links in the design do. */
  diagonal?: boolean;
}

const { href = "#", diagonal = false, class: className, ...rest } = Astro.props;
---

<a
  class:list={["arrow-link", className]}
  href={href}
  {...rest}
>
  <span class="arrow-link_label"><slot /></span>
  <ArrowCircle diagonal={diagonal} class="arrow-link_icon" />
</a>

<style is:global>
  @layer components {
    .arrow-link {
      display: inline-flex;
      align-items: center;
      gap: 0.8125rem;
      color: inherit;
      font-size: var(--text-main);
      font-weight: var(--primary-semibold);
      line-height: var(--line-height-medium);
      text-decoration: none;
      white-space: nowrap;
    }

    /* The label steps back as the arrow goes through. */
    .arrow-link_label {
      transition: translate 0.5s var(--ease-move);
    }

    /* The ring stands clear of the box by more than the label's step, or the
       label would walk into it. */
    .arrow-link:focus-visible {
      outline-offset: 0.75rem;
    }

    .arrow-link:focus-visible .arrow-link_label {
      translate: -0.5rem 0;
    }

    @media (hover: hover) {
      .arrow-link:hover .arrow-link_label {
        translate: -0.5rem 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .arrow-link_label {
        transition: none;
      }
      .arrow-link:is(:hover, :focus-visible) .arrow-link_label {
        translate: 0 0;
      }
    }
  }
</style>
