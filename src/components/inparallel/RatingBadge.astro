---
import type { HTMLAttributes } from "astro/types";
import Stars from "@/components/inparallel/Stars.astro";

interface Props extends HTMLAttributes<"div"> {
  score?: string;
  source?: string;
  /**
   * - `glass` — the translucent chip used on the hero (default)
   * - `outline` — the white, bordered chip used on light sections
   */
  variant?: "glass" | "outline";
}

const {
  score = "5.0",
  source = "Clutch",
  variant = "glass",
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "rating-badge",
    variant,
    variant === "glass" && "pill-glass",
    className,
  ]}
  {...rest}
  aria-label={`Rated ${score} out of 5 on ${source}`}
>
  <span class="rating-badge_score" aria-hidden="true">{score}</span>
  <Stars aria-hidden="true" />
  <span class="rating-badge_source" aria-hidden="true">{source}</span>
</div>

<style is:global>
  @layer components {
    .rating-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-small);
      font-size: var(--text-small);
      line-height: 1;
      white-space: nowrap;

      &.outline {
        background-color: var(--background-2);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-main);
      }
    }

    .rating-badge_score {
      font-weight: var(--primary-medium);
    }

    .rating-badge_source {
      color: var(--text-muted);
    }
  }
</style>
