---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Icon.astro";
import { SOCIAL_PROOF } from "@/consts.ts";
import jobSuccess from "@/assets/inparallel/icons/upwork-job-success.svg";

interface Props extends HTMLAttributes<"div"> {
  /** The figure itself. Defaults to the site-wide proof in `consts.ts`. */
  score?: string;
  /** Where the figure comes from — a claim is worth nothing unattributed. */
  source?: string;
  /**
   * - `glass` — the translucent chip used on the hero (default)
   * - `outline` — the white, bordered chip used on light sections
   */
  variant?: "glass" | "outline";
}

const {
  score = SOCIAL_PROOF.score,
  source = SOCIAL_PROOF.source,
  variant = "glass",
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "rating-badge",
    variant,
    variant === "glass" && "pill-glass",
    className,
  ]}
  {...rest}
  aria-label={`${score} ${source}`}
>
  <Icon src={jobSuccess} class="rating-badge_mark" aria-hidden="true" />
  <span class="rating-badge_score" aria-hidden="true">{score}</span>
  <span class="rating-badge_source" aria-hidden="true">{source}</span>
</div>

<style is:global>
  @layer components {
    .rating-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-small);
      font-size: var(--text-small);
      line-height: 1;
      white-space: nowrap;

      &.outline {
        background-color: var(--background-2);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-main);
      }
    }

    /* Upwork draws the ring for a white card, so on a dark chip it takes the
       palette's light blue through `currentColor` instead. */
    .rating-badge_mark {
      --_size: 1.125rem;
      color: var(--brand-300);
    }

    .rating-badge.outline .rating-badge_mark {
      color: var(--brand-500);
    }

    .rating-badge_score {
      font-weight: var(--primary-medium);
    }

    .rating-badge_source {
      color: var(--text-muted);
    }
  }
</style>
