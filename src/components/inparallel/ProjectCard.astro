---
import Img from "@/components/Img.astro";
import ArrowCircle from "./ArrowCircle.astro";
import type { Project } from "@/utils/content.ts";
import glowDiagonal from "@/assets/inparallel/glow-diagonal.webp";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
---

<a class="case_card surface" href={`/work/${project.id}`}>
  <Img src={glowDiagonal} class="surface-glow case_glow" transparent />

  <div class="case_card_top">
    <span class="logo-chip">
      <Img
        src={data.logo}
        alt={data.client}
        class="logo-chip_mark"
        transparent
      />
    </span>
    <p class="case_headline heading-split inline">
      {data.headline}{" "}
      <em>{data.headlineMuted}</em>
    </p>
  </div>

  <div class="case_card_foot">
    <span class="stat">
      <span class="stat_value">{data.stat}</span>
      <span class="stat_label">{data.statLabel}</span>
    </span>
    <ArrowCircle diagonal class="case_arrow" />
  </div>
</a>

<style is:global>
  @layer components {
    .case_card {
      display: flex;
      flex-direction: column;
      align-items: start;
      justify-content: space-between;
      gap: var(--space-5);
      height: 100%;
      padding: 1.5625rem;
      background-color: rgb(255 255 255 / 0.03);
      border: var(--border-width) solid var(--border);
      color: inherit;
      text-decoration: none;
      --arrow-fill: var(--lane-accent, var(--brand-500));
      --arrow-ink: var(--dark-900);

      /* Hover lifts the whole surface a shade, as a fade on a layer of its
         own: nothing repaints but the arrow. */
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background-color: color-mix(in srgb, var(--text) 5%, transparent);
        opacity: 0;
        transition: opacity 0.35s var(--ease-soft);
        pointer-events: none;
      }
    }

    @media (hover: hover) {
      .case_card:hover::after {
        opacity: 1;
      }
    }

    .case_card:focus-visible::after {
      opacity: 1;
    }

    /* The bar the design rakes across the card at 15°. */
    .case_glow {
      top: -3.33rem;
      left: 31.6%;
      width: 18.86rem;
      height: 45.34rem;
      max-width: none;
      rotate: 15deg;
    }

    /* On a service's page the card's light is that service's. */
    .has-lane .case_glow {
      display: none;
    }

    .has-lane .case_card {
      background-image: linear-gradient(
        to top right,
        transparent 55%,
        color-mix(in srgb, var(--lane-accent) 14%, transparent)
      );
    }

    .case_card_top {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
    }

    .case_headline {
      font-size: var(--h5);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-medium);
      letter-spacing: var(--letter-spacing-tight);
    }

    .case_card_foot {
      width: 100%;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-4);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
      /* Eases down with the narrow card of a mid-sized screen, so the figure
         keeps to one line beside the arrow. */
      --_stat-size: clamp(2.25rem, 1rem + 2.4vw, 3rem);

      & .stat_value {
        white-space: nowrap;
      }
    }

    @media (width < 62rem) {
      .case_card {
        height: auto;
        min-height: 22rem;
      }
    }
  }
</style>
