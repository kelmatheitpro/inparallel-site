---
/**
 * One dialog serves every play button on the page. Buttons carry the details
 * on `data-` attributes and the dialog reads them when it opens, so adding a
 * video is a data change rather than another dialog.
 *
 * A button with `data-video` plays that file and one with `data-youtube` opens
 * the frame; with neither, the dialog shows the still and its attribution.
 */
---

<dialog class="lightbox" data-lightbox aria-label="Video">
  <button
    class="lightbox_close"
    type="button"
    data-lightbox-close
    aria-label="Close"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
      <path
        d="M5 5l14 14M19 5L5 19"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"></path>
    </svg>
  </button>

  <div class="lightbox_stage">
    <iframe
      class="lightbox_frame"
      data-lightbox-frame
      title="Video"
      allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
      hidden></iframe>
    <video
      class="lightbox_video"
      data-lightbox-video
      controls
      playsinline
      hidden></video>
    <img class="lightbox_poster" data-lightbox-poster alt="" hidden />
  </div>

  <p class="lightbox_caption" data-lightbox-caption></p>
</dialog>

<style is:global>
  @layer components {
    .lightbox {
      /* The height is what limits it on a phone held sideways: the stage, the
         close button over it and the caption under it all have to fit, or
         there's no way out of the dialog. */
      width: min(64rem, 92vw, (100dvh - 9rem) * 16 / 9);
      max-width: none;
      /* A modal dialog centres itself on `margin: auto`, and the reset's
         `* { margin: 0 }` takes that away — without this it opens in the top
         left corner of the screen. */
      margin: auto;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--light-100);
      overflow: visible;
      opacity: 0;
      scale: 0.98;
      transition:
        opacity var(--duration-main) var(--ease-out),
        scale var(--duration-main) var(--ease-out),
        overlay var(--duration-main) allow-discrete,
        display var(--duration-main) allow-discrete;

      /* Solid rather than blurred: a blur the size of the screen is redrawn
         for as long as anything behind it moves, and the page keeps moving. */
      &::backdrop {
        background-color: rgb(11 10 12 / 0.92);
        opacity: 0;
        transition:
          opacity var(--duration-main) var(--ease-out),
          overlay var(--duration-main) allow-discrete,
          display var(--duration-main) allow-discrete;
      }

      &[open] {
        opacity: 1;
        scale: 1;
      }

      &[open]::backdrop {
        opacity: 1;
      }
    }

    /* Where a modal fades in from, and out to as it closes: without the two
       discrete properties above it leaves the top layer in a single frame. */
    @starting-style {
      .lightbox[open] {
        opacity: 0;
        scale: 0.98;
      }

      .lightbox[open]::backdrop {
        opacity: 0;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .lightbox,
      .lightbox::backdrop {
        transition: none;
      }
    }

    .lightbox_stage {
      position: relative;
      border-radius: var(--radius-card);
      overflow: clip;
      background-color: var(--dark-900);
      aspect-ratio: 16 / 9;
    }

    .lightbox_video,
    .lightbox_poster,
    .lightbox_frame {
      /* The reset gives images and video `display: block`; a frame is inline
         unless it is told otherwise, and inline leaves a strip of the stage
         showing under it. */
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
      object-fit: cover;
    }

    .lightbox_caption {
      padding-top: var(--space-4);
      font-size: var(--text-small);
      color: rgb(255 255 255 / 0.7);
      text-align: center;
    }

    .lightbox_close {
      position: absolute;
      top: calc(var(--space-5) * -1 - 1.5rem);
      right: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border: var(--border-width) solid rgb(255 255 255 / 0.3);
      border-radius: var(--radius-round);
      color: var(--light-100);
      transition:
        background-color var(--duration-main),
        border-color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          background-color: rgb(255 255 255 / 0.12);
          border-color: rgb(255 255 255 / 0.6);
        }
      }
    }
  }
</style>
