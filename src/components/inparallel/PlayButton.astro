---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/Icon.astro";
import play from "@/assets/inparallel/icons/play.svg";

interface Props extends HTMLAttributes<"button"> {
  /** Names what is being played, for screen readers. */
  label: string;
  /** Video file to play. Without one the dialog shows the still instead. */
  video?: string;
  /** A YouTube id, for a clip that lives there rather than in the project. */
  youtube?: string;
  /** Still shown in the dialog, and as the video's poster. */
  poster?: string;
  /** Line printed under the player. */
  caption?: string;
  /** `small` is the 40px disc, `large` the 64px one, `tile` the white square
   *  on the film cards. */
  size?: "small" | "large" | "tile";
}

const {
  label,
  video,
  youtube,
  poster,
  caption,
  size = "large",
  class: className,
  ...rest
} = Astro.props;
---

<button
  class:list={["play-button", size, className]}
  type="button"
  aria-label={label}
  data-lightbox-open
  data-video={video}
  data-youtube={youtube}
  data-poster={poster}
  data-caption={caption}
  {...rest}
>
  {
    size === "tile" ? (
      <svg viewBox="0 0 14 14" aria-hidden="true">
        <path
          d="M3.46 2.73a1.07 1.07 0 0 0-.14.53v7.47a1.07 1.07 0 0 0 1.6.92l6.4-3.73a1.07 1.07 0 0 0 0-1.85L4.92 2.35a1.07 1.07 0 0 0-1.46.38Z"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="1.83"
          stroke-linecap="round"
        />
      </svg>
    ) : (
      <Icon src={play} class="play-button_icon" />
    )
  }
</button>

<style is:global>
  @layer components {
    /* `:where`, so a card placing its button absolutely keeps that whichever
       stylesheet lands first. */
    :where(.play-button) {
      position: relative;
    }

    .play-button {
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: var(--radius-round);
      transition: transform var(--duration-main) var(--ease-out);

      /* What rises behind it on hover is a soft disc, faded in. A shadow
         filter would be raster work on every frame of the scale. */
      &::after {
        content: "";
        position: absolute;
        inset: -0.75rem;
        z-index: -1;
        border-radius: inherit;
        background-image: radial-gradient(
          closest-side,
          rgb(0 0 0 / 0.35),
          transparent
        );
        opacity: 0;
        transition: opacity var(--duration-main) var(--ease-out);
        pointer-events: none;
      }

      @media (hover: hover) {
        &:hover {
          transform: scale(1.06);
        }

        &:hover::after {
          opacity: 1;
        }
      }
    }

    /* The artwork is a 64px disc; `small` is the same disc drawn smaller
       rather than a second asset. */
    .play-button_icon {
      --_size: 4rem;
    }

    .play-button.small .play-button_icon {
      --_size: 2.5rem;
    }

    /* The white square: a play control that sits in a corner of its picture
       rather than across the face in the middle of it. */
    .play-button.tile {
      flex-shrink: 0;
      width: 3rem;
      height: 3rem;
      padding: 0;
      background-color: var(--light-100);
      border-radius: 0.75rem;
      box-shadow: 0 2px 4px rgb(0 0 0 / 0.18);
      color: var(--ink-900);
      opacity: 0.94;
      cursor: pointer;
      transition: scale 0.3s var(--ease-soft);

      /* The ring round it on hover, here from the start and faded in. */
      &::after {
        inset: -5px;
        border-radius: calc(0.75rem + 5px);
        background-image: none;
        background-color: rgb(255 255 255 / 0.25);
        transition: opacity 0.3s var(--ease-soft);
      }

      & svg {
        width: 0.875rem;
        height: 0.875rem;
      }

      @media (hover: hover) {
        &:hover {
          transform: none;
          scale: 1.08;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .play-button,
      .play-button.tile {
        transition: none;
      }

      .play-button:hover,
      .play-button.tile:hover {
        transform: none;
        scale: 1;
      }
    }
  }
</style>
