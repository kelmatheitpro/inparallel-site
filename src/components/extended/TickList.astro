---
/**
 * A list of plain statements, each bulleted with the mark's two strokes and
 * set between hairlines — the shape the home page's service lanes use.
 * `columns` lets a long list run in two on wide screens.
 */
interface Props {
  items: readonly string[];
  columns?: 1 | 2;
}

const { items, columns = 1 } = Astro.props;
---

<ul class:list={["tick-list", columns === 2 && "is-two"]} role="list">
  {
    items.map((item) => (
      <li class="tick-list_item">
        <span class="tick-list_mark" aria-hidden="true" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>

<style is:global>
  @layer components {
    .tick-list {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      column-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: var(--border-width) solid var(--border-soft);

      @media (width >= 48rem) {
        &.is-two {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    }

    .tick-list_item {
      display: flex;
      align-items: baseline;
      gap: 1.1rem;
      padding-block: 1rem;
      border-bottom: var(--border-width) solid var(--border-soft);
      line-height: 1.5;
    }

    /* Two short strokes at the slant, standing on the line's baseline. */
    .tick-list_mark {
      flex: none;
      position: relative;
      top: 0.1em;
      width: 0.26rem;
      height: 0.85rem;
      margin-right: 0.42rem;
      background-color: var(--brand-500);
      transform: skewX(calc(var(--slant) * -1));
      box-shadow: 0.42rem 0 0 var(--brand-300);
    }
  }
</style>
