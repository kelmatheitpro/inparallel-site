---
/**
 * The rest of the menu, for the shapes the two main models don't cover —
 * eight short entries under a parallel rule each, four to a row on wide
 * screens.
 */
import { ARRANGEMENTS } from "@/data/extended-team.ts";
---

<ul class="arrangements" role="list" data-anim-group data-stagger="0.05">
  {
    ARRANGEMENTS.map((item, index) => (
      <li class="arrangement" data-anim="rise">
        <span class="rule-pair" aria-hidden="true">
          <i />
          <i />
        </span>
        <span class="arrangement_index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3 class="arrangement_name">{item.name}</h3>
        <p class="arrangement_text">{item.text}</p>
      </li>
    ))
  }
</ul>

<style is:global>
  @layer components {
    .arrangements {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
      gap: 2.5rem clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
      margin: 0;
      padding: 0;
      list-style: none;

      @media (width >= 75rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .arrangement {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;

      & .rule-pair {
        margin-bottom: 0.6rem;
      }
    }

    .arrangement_index {
      color: var(--text-faded);
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.06em;
    }

    .arrangement_name {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.2;
    }

    .arrangement_text {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.55;
    }
  }
</style>
