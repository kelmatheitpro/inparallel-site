---
/**
 * What the studio doesn't do, said as flatly as the page says what it does:
 * a short run of chips, each crossed out with the mark's two strokes turned
 * into an X.
 */
interface Props {
  items: readonly string[];
  /** Names the list for screen readers. */
  label?: string;
}

const { items, label = "What we don't do" } = Astro.props;
---

<div class="not-list">
  <span class="label not-list_title">
    <span class="label_slash" aria-hidden="true">//</span>
    <span class="label_text">{label}</span>
  </span>
  <ul class="not-list_items" role="list" aria-label={label}>
    {
      items.map((item) => (
        <li class="not-list_item">
          <span class="not-list_mark" aria-hidden="true">
            <i />
            <i />
          </span>
          {item}
        </li>
      ))
    }
  </ul>
</div>

<style is:global>
  @layer components {
    .not-list {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .not-list_items {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .not-list_item {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      min-height: 2.75rem;
      padding: 0.5rem 1rem 0.5rem 0.85rem;
      border: var(--border-width) dashed var(--border);
      border-radius: 0.65rem;
      color: var(--text-muted);
      font-size: 0.9375rem;
      line-height: 1.3;
    }

    /* The two strokes, crossed. */
    .not-list_mark {
      position: relative;
      flex: none;
      width: 0.85rem;
      height: 0.85rem;

      & > i {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 1.5px;
        height: 100%;
        margin: -50% 0 0 -0.75px;
        background-color: var(--text-faded);
        rotate: 45deg;
      }

      & > i + i {
        rotate: -45deg;
      }
    }
  }
</style>
