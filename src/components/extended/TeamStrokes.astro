---
/**
 * The hero picture on the two partner pages: a team, drawn as the logo's
 * strokes.
 *
 * Every person is a stroke leaning at the slant. Theirs stand in a quiet
 * row; ours are the two bright ones from the mark, standing in line with
 * them — working in parallel with the team, not off to one side of it.
 *
 *   <TeamStrokes
 *     title="In parallel with your team"
 *     groups={[
 *       { label: "Your team", count: 4, tone: "faint" },
 *       { label: "Two Webflow developers", count: 2, tone: "bright" },
 *     ]}
 *   />
 */
interface Group {
  label: string;
  count: number;
  /** `faint` for the client's people, `white` for one person, `bright` for us. */
  tone: "faint" | "white" | "bright";
}

interface Props {
  title: string;
  groups: Group[];
}

const { title, groups } = Astro.props;
---

<figure class="team-strokes">
  <figcaption class="team-strokes_title">
    <span class="label">
      <span class="label_slash" aria-hidden="true">//</span>
      <span class="label_text">{title}</span>
    </span>
  </figcaption>

  <div class="team-strokes_row" aria-hidden="true">
    {
      groups.map((group) => (
        <div class:list={["team-strokes_group", `is-${group.tone}`]}>
          <div class="team-strokes_set">
            {Array.from({ length: group.count }, () => (
              <span class="team-strokes_stroke" />
            ))}
          </div>
          <span class="team-strokes_caption">{group.label}</span>
        </div>
      ))
    }
  </div>

  {/* The picture says it in strokes; this says it in words. */}
  <p class="sr-only">
    {groups.map((group) => group.label).join(", working alongside ")}.
  </p>
</figure>

<style is:global>
  @layer components {
    .team-strokes {
      --_h: clamp(11rem, 7rem + 11vw, 16.5rem);
      --_lean: calc(var(--_h) * var(--slant-tan));
      --_t: calc(var(--_h) * 0.13);
      --_gap: calc(var(--_h) * 0.045);
      display: flex;
      flex-direction: column;
      gap: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem);
      margin: 0;
      padding: clamp(1.25rem, 0.8rem + 1.5vw, 2rem);
      background-color: rgb(20 28 44 / 0.88);
      border: var(--border-width) solid rgb(255 255 255 / 0.1);
      border-radius: 1.25rem;
      box-shadow: 0 2.5rem 5rem -2.5rem rgb(0 0 0 / 0.7);
    }

    .team-strokes_title {
      margin: 0;

      & .label {
        color: rgb(255 255 255 / 0.7);
      }
    }

    .team-strokes_row {
      display: flex;
      align-items: start;
      justify-content: center;
    }

    /* Groups stand three gaps apart; strokes within a group, one. Each
       neighbour overlaps the last by the lean, so the gap is even all the
       way up the strokes. */
    .team-strokes_group + .team-strokes_group {
      margin-left: calc(var(--_gap) * 3.5 - var(--_lean));
    }

    .team-strokes_set {
      display: flex;
      height: var(--_h);
    }

    .team-strokes_stroke {
      flex: none;
      width: calc(var(--_t) + var(--_lean));
      clip-path: polygon(
        var(--_lean) 0,
        100% 0,
        calc(100% - var(--_lean)) 100%,
        0 100%
      );
    }

    .team-strokes_stroke + .team-strokes_stroke {
      margin-left: calc(var(--_gap) - var(--_lean));
    }

    .is-faint .team-strokes_stroke {
      background-image:
        repeating-linear-gradient(
          calc(90deg + var(--slant)),
          transparent 0 calc(1.2rem - 1px),
          rgb(255 255 255 / 0.06) calc(1.2rem - 1px) 1.2rem
        ),
        linear-gradient(
          180deg,
          rgb(255 255 255 / 0.16),
          rgb(255 255 255 / 0.05)
        );
    }

    .is-white .team-strokes_stroke {
      background-image: linear-gradient(
        180deg,
        var(--light-100),
        rgb(255 255 255 / 0.55)
      );
    }

    /* Ours are the logo's two: deep blue, then the light one. */
    .is-bright .team-strokes_stroke {
      background-image:
        repeating-linear-gradient(
          calc(90deg + var(--slant)),
          transparent 0 calc(1.2rem - 1px),
          rgb(255 255 255 / 0.12) calc(1.2rem - 1px) 1.2rem
        ),
        linear-gradient(180deg, #3b82f0, #133f8f);
    }

    .is-bright .team-strokes_stroke + .team-strokes_stroke {
      background-image:
        repeating-linear-gradient(
          calc(90deg + var(--slant)),
          transparent 0 calc(1.2rem - 1px),
          rgb(255 255 255 / 0.16) calc(1.2rem - 1px) 1.2rem
        ),
        linear-gradient(180deg, #a8c8ff, #3d6fc4);
    }

    /* The caption stands at the strokes' feet, where the group starts. */
    .team-strokes_caption {
      display: block;
      max-width: calc(var(--_t) * 3 + var(--_gap) * 2);
      margin-top: 0.9rem;
      color: rgb(255 255 255 / 0.6);
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      line-height: 1.35;
      text-transform: uppercase;

      .is-bright & {
        color: var(--brand-300);
      }
    }
  }
</style>
