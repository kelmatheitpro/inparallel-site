---
/**
 * Who wrote this, at the foot of the article: the portrait on navy, large,
 * with a card laid over its edge carrying the name and role, a line on what
 * they write about, and where to find more of them.
 *
 * Whether the two sit side by side depends on the width of the column the
 * block is in, not the screen, so it holds up beside the contents as well.
 */
import Img from "@/components/Img.astro";
import ArrowCircle from "@/components/inparallel/ArrowCircle.astro";
import { AUTHORS } from "@/data/about.ts";

interface Props {
  author: keyof typeof AUTHORS;
  class?: string;
}

const { author: key, class: className } = Astro.props;
const author = AUTHORS[key];
---

<aside
  class:list={["post-author", className]}
  aria-labelledby="post-author-name"
>
  <div class="post-author_inner">
    <div class="post-author_media">
      <Img
        src={author.photo}
        alt={author.name}
        class="post-author_photo"
        variant="constrained"
        sizes="(width >= 40rem) 28rem, 94vw"
      />
    </div>
    <div class="post-author_body">
      <p class="label post-author_label">
        <span class="label_slash" aria-hidden="true">//</span>
        <span class="label_text">Written by</span>
      </p>
      <p class="post-author_name" id="post-author-name">{author.name}</p>
      <p class="post-author_role">{author.role} · inParallel</p>
      <p class="post-author_bio">{author.bio}</p>
      <div class="post-author_links">
        <a class="post-author_link" href="/about">
          About the studio
          <ArrowCircle bare />
        </a>
        {
          author.linkedin && (
            <a
              class="post-author_link"
              href={author.linkedin}
              target="_blank"
              rel="noopener"
            >
              LinkedIn
              <span class="sr-only">(opens in a new tab)</span>
              <ArrowCircle bare diagonal />
            </a>
          )
        }
      </div>
    </div>
  </div>
</aside>

<style is:global>
  @layer components {
    .post-author {
      container-type: inline-size;
    }

    .post-author_inner {
      display: flex;
      flex-direction: column;
    }

    /* A cut-out, so it stands on the navy the way it does in the hero. */
    .post-author_media {
      position: relative;
      height: clamp(20rem, 86vw, 24.375rem);
      overflow: clip;
      background-color: var(--dark-900);
      border-radius: var(--radius-large);
    }

    .post-author_photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 0;
    }

    .post-author_body {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 0.8rem;
      margin: -4rem 0.75rem 0;
      padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
      background-color: var(--light-100);
      border-radius: var(--radius-large);
      box-shadow: 0 1.25rem 2.5rem -1.75rem rgb(13 25 40 / 0.4);
    }

    @container (width >= 40rem) {
      .post-author_inner {
        flex-direction: row;
        align-items: center;
      }

      .post-author_media {
        flex: 0 0 53.6%;
        height: 24.375rem;
      }

      .post-author_body {
        flex: 0 0 52.5%;
        margin: 0 0 0 -6.1%;
      }
    }

    .post-author_label {
      margin: 0 0 0.25rem;

      /* The trim boxes are for text, not for a row of label parts. */
      &::before,
      &::after {
        display: none;
      }
    }

    .post-author_name {
      margin: 0;
      color: var(--text);
      font-size: 1.5rem;
      font-weight: 500;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }

    .post-author_role {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .post-author_bio {
      max-width: 34rem;
      margin: 0.4rem 0 0;
      color: color-mix(in srgb, var(--text) 82%, transparent);
      line-height: 1.55;
    }

    .post-author_links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.5rem;
      margin-top: 0.6rem;
    }

    /* A hairline under the link, and over it a brand line that draws across
       under the pointer. */
    .post-author_link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.25rem;
      color: var(--text);
      font-size: 0.9375rem;
      font-weight: 500;
      text-decoration: none;

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset: auto 0 0.2rem;
        height: var(--border-width);
        background-color: var(--border);
      }

      &::after {
        background-color: var(--brand-500);
        transform: scaleX(0);
        transform-origin: 100% 50%;
        transition: transform 0.45s var(--ease-move);
      }

      &:focus-visible::after {
        transform: scaleX(1);
        transform-origin: 0 50%;
      }

      @media (hover: hover) {
        &:hover::after {
          transform: scaleX(1);
          transform-origin: 0 50%;
        }
      }
    }
  }
</style>
