---
/**
 * "In this article" — a page's sections, from its `h2`s. Articles use it;
 * so do the legal pages, under their own `title`.
 *
 * A list of jumps down the page, on a hairline track that fills as the reader
 * moves through the text. The section they are in is marked on the track with
 * one stroke of the mark and named as the current location (`aria-current`).
 * On a narrow screen the list waits shut under its title, so it doesn't stand
 * between the reader and the article. Without JavaScript it is a plain list
 * of links.
 */
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  title?: string;
  class?: string;
}

const { headings, title = "In this article", class: className } = Astro.props;
const sections = headings.filter((heading) => heading.depth === 2);
---

{
  sections.length > 0 && (
    <nav
      class:list={["post-toc", className]}
      aria-labelledby="post-toc-title"
      data-post-toc
    >
      <details class="post-toc_box">
        <summary class="post-toc_head">
          <span class="label post-toc_title" id="post-toc-title">
            <span class="label_slash" aria-hidden="true">
              //
            </span>
            <span class="label_text">{title}</span>
          </span>
          <span class="post-toc_chevron" aria-hidden="true" />
        </summary>
        <div class="post-toc_scroll">
          <ol class="post-toc_list" role="list">
            {sections.map((heading) => (
              <li class="post-toc_item">
                <a class="post-toc_link" href={`#${heading.slug}`}>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </div>
      </details>
      {/* Beside the text the list is always out. Settled here, before the
          page paints, so it doesn't flash shut on the way. */}
      <script is:inline>
        document.currentScript.previousElementSibling.open =
        matchMedia("(min-width: 62rem)").matches;
      </script>
    </nav>
  )
}

<script>
  import { getLenis } from "@/scripts/motion.ts";

  for (const toc of document.querySelectorAll<HTMLElement>("[data-post-toc]")) {
    const box = toc.querySelector("details");
    const head = toc.querySelector("summary");
    const scroller = toc.querySelector<HTMLElement>(".post-toc_scroll");
    const list = toc.querySelector<HTMLElement>("ol");
    const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    const targets = links
      .map((link) =>
        document.getElementById(decodeURIComponent(link.hash.slice(1))),
      )
      .filter((target): target is HTMLElement => Boolean(target));
    if (!box || !head || !scroller || !list || !targets.length) continue;

    const wide = window.matchMedia("(min-width: 62rem)");
    const fit = () => {
      box.open = wide.matches;
      head.tabIndex = wide.matches ? -1 : 0;
    };
    wide.addEventListener("change", fit);
    fit();
    head.addEventListener("click", (event) => {
      if (wide.matches) event.preventDefault();
    });

    let current = -1;

    const paint = () => {
      links.forEach((link, i) => {
        if (i === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });

      /* The track fills to the foot of the section being read. */
      const link = links[current];
      const fill = link
        ? (link.offsetTop + link.offsetHeight) / list.offsetHeight
        : 0;
      list.style.setProperty("--toc-fill", fill.toFixed(4));

      /* Taller than the screen allows, the list keeps its place in view and
         takes the wheel for itself; otherwise the page scrolls as it does
         everywhere else. */
      const overflows = scroller.scrollHeight > scroller.clientHeight;
      scroller.toggleAttribute("data-lenis-prevent", overflows);
      if (link && overflows)
        scroller.scrollTop = link.offsetTop - scroller.clientHeight / 3;
    };

    /* The section being read is the last one whose heading has passed a line
       a third of the way down the screen. Watched rather than measured on
       every frame of the scroll, so reading costs the page nothing. */
    const passed = new Set<number>();
    const line = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const index = targets.indexOf(entry.target as HTMLElement);
          if (entry.isIntersecting) passed.add(index);
          else passed.delete(index);
        }
        const next = passed.size ? Math.max(...passed) : -1;
        if (next === current) return;
        current = next;
        paint();
      },
      { rootMargin: "1000000px 0px -66.6% 0px" },
    );
    for (const target of targets) line.observe(target);
    paint();

    /* The list only has a height to fill while it's open, and its lines
       re-wrap with the width. */
    box.addEventListener("toggle", paint);
    window.addEventListener("resize", paint, { passive: true });

    /* Headings keep clear of the nav with `scroll-margin`, which is what puts
       them in the right place when a link is opened from outside. The smooth
       scroll's own anchor handling would add the nav's height again, so the
       jump is made here; the focus moves with it, as a plain link's would. */
    links.forEach((link, i) => {
      link.addEventListener("click", (event) => {
        const lenis = getLenis();
        const target = targets[i];
        if (!lenis || !target) return;
        event.preventDefault();
        event.stopPropagation();
        lenis.scrollTo(target, { duration: 1.1 });
        history.replaceState(null, "", link.hash);
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .post-toc_head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 2.75rem;
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }

      &:focus-visible {
        outline: var(--focus-width) solid var(--text);
        outline-offset: 0.25rem;
        border-radius: 0.25rem;
      }

      /* Beside the text it is only the list's title. */
      @media (width >= 62rem) {
        min-height: 0;
        cursor: default;
      }
    }

    .post-toc_title {
      margin: 0;
    }

    .post-toc_chevron {
      flex: none;
      width: 0.55rem;
      height: 0.55rem;
      margin-right: 0.3rem;
      border-right: 1.5px solid currentcolor;
      border-bottom: 1.5px solid currentcolor;
      color: var(--text-muted);
      transform: translateY(-0.15rem) rotate(45deg);
      transition: transform 0.35s var(--ease-out);

      [open] > summary > & {
        transform: translateY(0.1rem) rotate(-135deg);
      }

      @media (width >= 62rem) {
        display: none;
      }
    }

    /* However long the list, the sticky column stays inside the screen. */
    .post-toc_scroll {
      margin-top: 0.75rem;

      @media (width >= 62rem) {
        margin-top: 1.1rem;
        max-height: max(12.5rem, calc(100svh - var(--nav-height) - 17rem));
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }
    }

    [open] > .post-toc_scroll {
      animation: post-toc-open 0.35s var(--ease-out);
    }

    @keyframes post-toc-open {
      from {
        opacity: 0;
        transform: translateY(-0.4rem);
      }
    }

    /* The track, and over it the part already read: a line scaled, not a
       height changed, so the fill costs no layout. */
    .post-toc_list {
      position: relative;
      display: flex;
      flex-direction: column;
      margin: 0 0 0 0.2rem;
      padding: 0;
      list-style: none;

      &::before,
      &::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--border-width);
        background-color: var(--border);
      }

      &::after {
        width: 0.125rem;
        background-color: var(--brand-500);
        transform: scaleY(var(--toc-fill, 0));
        transform-origin: 50% 0;
        transition: transform 0.5s var(--ease-out);
      }
    }

    .post-toc_link {
      position: relative;
      display: block;
      padding: 0.5rem 0 0.5rem 1.1rem;
      color: var(--text);
      font-size: 0.9375rem;
      line-height: 1.35;
      text-decoration: none;
      text-wrap: pretty;
      opacity: 0.62;
      transition: opacity var(--duration-main);

      /* One stroke of the mark, riding the track beside the current
         section. */
      &::before {
        content: "";
        position: absolute;
        top: 0.55rem;
        bottom: 0.55rem;
        left: 0.08rem;
        z-index: 1;
        width: 0.3rem;
        background-color: var(--brand-500);
        transform: skewX(calc(var(--slant) * -1)) scaleY(0);
        transform-origin: 50% 0;
        transition: transform 0.45s var(--ease-out);
      }

      &[aria-current] {
        opacity: 1;

        &::before {
          transform: skewX(calc(var(--slant) * -1)) scaleY(1);
        }
      }

      &:focus-visible {
        opacity: 1;
        outline-offset: -0.125rem;
      }

      @media (hover: hover) {
        &:hover {
          opacity: 1;
        }
      }
    }
  }
</style>
