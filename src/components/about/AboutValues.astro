---
/**
 * "The rules we work by." — the studio's values, as a ledger.
 *
 * The same five the home page lists under the relay (`VALUES`), given room:
 * one row each between parallel rules, the index in the margin, the rule's
 * name large and what it means in practice beside it.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import { VALUES } from "@/data/parallel.ts";
---

<section class="about-values theme-light" aria-labelledby="about-values-title">
  <div class="about-values_inner">
    <SectionHead
      index="05"
      label="Values"
      headingId="about-values-title"
      lead="What we hold to on every project, whatever its size."
    >
      The rules we <span class="serif">work</span> by.
    </SectionHead>

    <ol class="about-values_list" role="list">
      {
        VALUES.map((value, index) => (
          <li class="about-value">
            <span
              class="rule-pair about-value_rule"
              aria-hidden="true"
              data-anim="rule"
            >
              <i />
              <i />
            </span>
            <span class="about-value_index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="about-value_title">{value.title}</h3>
            <p class="about-value_text">{value.text}</p>
          </li>
        ))
      }
    </ol>
    <span
      class="rule-pair about-values_close"
      aria-hidden="true"
      data-anim="rule"
    >
      <i></i>
      <i></i>
    </span>
  </div>
</section>

<style is:global>
  @layer components {
    .about-values {
      padding-block: var(--section-space-large);
      background-color: var(--light-200);
    }

    .about-values_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
    }

    .about-values_list {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* The ledger closes on the same rule it opens with, tight under the
       last row rather than a section gap away. */
    .about-values_close {
      margin-top: calc(clamp(2.5rem, 1.75rem + 2.5vw, 4rem) * -1);
    }

    /* Index, name and meaning across one row on a wide screen; the meaning
       drops under the name on a narrow one. */
    .about-value {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr);
      column-gap: 1rem;
      row-gap: 0.6rem;
      padding-bottom: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);

      @media (width >= 48rem) {
        grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.25fr);
        column-gap: var(--space-6);
        align-items: baseline;
      }
    }

    .about-value_rule {
      grid-column: 1 / -1;
      margin-bottom: clamp(1.5rem, 1.1rem + 1vw, 2.25rem);
    }

    .about-value_index {
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--brand-500);
    }

    .about-value_title {
      margin: 0;
      font-size: clamp(1.6rem, 1.25rem + 1.2vw, 2.4rem);
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .about-value_text {
      grid-column: 2;
      max-width: 34rem;
      margin: 0;
      color: var(--text-muted);
      font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
      line-height: 1.5;

      @media (width >= 48rem) {
        grid-column: 3;
      }
    }
  }
</style>
