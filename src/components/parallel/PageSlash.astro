---
/**
 * The page change: the next page is cut in over the last one along an edge
 * that leans at the logo's angle, with the mark's two strokes riding that
 * edge — the same cut the headings make, at the size of the screen.
 *
 * Built on cross-document view transitions, so it costs the navigation
 * nothing: the browser holds the old page while the new one loads, then
 * plays the cut. Where those aren't supported, or the reader has asked for
 * less motion, pages simply change. `is-arriving` is on the root only while a
 * transition runs, which is the only time the strokes exist.
 *
 * Nothing here animates but transforms, so all of it runs on the compositor.
 * It plays while the new page is at its busiest, booting its scripts, and a
 * `clip-path` would have to wait for that work between every two frames. So
 * the edge is a real box, masked to lean, carried across the screen, while the
 * page inside moves the exact opposite way and stays where it is.
 */
---

<div class="page-slash" aria-hidden="true">
  <i></i><i></i>
</div>

<script is:inline>
  /* Left while its own cut still runs, a page goes back to being a plain page
     first, or the next cut would have nothing to play over. */
  addEventListener("pageswap", function () {
    document.documentElement.classList.remove("is-arriving");
  });
</script>

<style is:global>
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  /* Arriving, the page goes by a name of its own, so it isn't paired with the
     one it replaces: a pair gets the browser's own group animation, which
     runs width and height on the main thread. */
  html.is-arriving {
    view-transition-name: page-cut;
  }

  /* The old page stays put underneath; the new one is uncovered over it. */
  ::view-transition-old(root),
  ::view-transition-new(page-cut) {
    animation: none;
  }

  /* The edge: a box as wide as the screen plus the lean, masked so everything
     past a line from its top right corner, at the mark's angle, is gone. The
     mask does the leaning because a skew would resample the page twice and
     leave it soft until the last frame; this way the box only slides. */
  ::view-transition-group(page-cut) {
    --_width: calc(100vw + 62.5vh);
    --_edge: calc(var(--_width) * cos(32deg));
    left: calc(var(--_width) * -1);
    width: var(--_width);
    mask-image: linear-gradient(
      122deg,
      #000 calc(var(--_edge) - 1px),
      transparent calc(var(--_edge) + 1px)
    );
    animation: page-cut-edge 0.8s cubic-bezier(0.7, 0, 0.2, 1) both;
  }

  /* The page, waiting just past that box and held still against it. Both run
     the same timing, so at every frame the two moves add up to nothing. */
  ::view-transition-image-pair(page-cut) {
    inset: 0 auto 0 100%;
    width: 100vw;
    animation: page-cut-hold 0.8s cubic-bezier(0.7, 0, 0.2, 1) both;
  }

  @keyframes page-cut-edge {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100vw + 62.5vh));
    }
  }

  @keyframes page-cut-hold {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100vw - 62.5vh));
    }
  }

  @layer components {
    .page-slash {
      position: fixed;
      inset-block: 0;
      left: 0;
      z-index: 200;
      display: none;
      width: calc(62.5vh + 3rem);
      pointer-events: none;
      view-transition-name: page-slash;

      & > i {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0.9rem;
        height: 100%;
        background-color: var(--brand-500);
        transform-origin: 0 100%;
        transform: skewX(-32deg);
      }

      & > i + i {
        left: 1.45rem;
        width: 0.45rem;
        background-color: var(--brand-300);
      }
    }

    html.is-arriving .page-slash {
      display: block;
    }
  }

  ::view-transition-group(page-slash) {
    animation: none;
  }

  ::view-transition-old(page-slash) {
    display: none;
  }

  /* The strokes' feet run along the foot of the cut. */
  ::view-transition-new(page-slash) {
    animation: page-slash-ride 0.8s cubic-bezier(0.7, 0, 0.2, 1) both;
  }

  @keyframes page-slash-ride {
    from {
      transform: translateX(calc(-62.5vh - 1.5rem));
    }
    to {
      transform: translateX(100vw);
    }
  }
</style>
