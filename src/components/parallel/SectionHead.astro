---
/**
 * A section's opening: its `// 02 — Work` label, the heading cut in along
 * the slant, and an optional lead and link.
 *
 *   <SectionHead index="02" label="Work" align="center">
 *     Every project, measured by its results
 *   </SectionHead>
 *
 * The heading is the default slot, so it can carry markup — a `.serif`
 * accent, a line break. `tag` keeps the outline right when the section
 * isn't a top-level one.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Two-digit position on the page, shown after the strokes. */
  index?: string;
  /** What the section is, in a word or two. */
  label?: string;
  /** One or two sentences under the heading. */
  lead?: string;
  align?: "start" | "center";
  tag?: "h1" | "h2" | "h3";
  /** Heading size: `display` for page openers, `h2` for sections. */
  size?: "display" | "h2" | "h3";
  /** Id for the heading, so the section can be labelled by it. */
  headingId?: string;
}

const {
  index,
  label,
  lead,
  align = "start",
  tag: Tag = "h2",
  size = "h2",
  headingId,
  class: className,
  ...rest
} = Astro.props;

const hasAside = Astro.slots.has("aside");
---

<div
  class:list={[
    "section-head-p",
    `is-${align}`,
    hasAside && "has-aside",
    className,
  ]}
  {...rest}
>
  <div class="section-head-p_main">
    {
      (index || label) && (
        <p class="label section-head-p_label" data-anim="label">
          <span class="label_slash" aria-hidden="true">
            //
          </span>
          <span class="label_text">
            {index && <span class="label_index">{index}</span>}
            {index && label && " — "}
            {label}
          </span>
        </p>
      )
    }
    <Tag
      class:list={["section-head-p_title", `is-${size}`, "heading"]}
      id={headingId}
      data-anim="slash"
    >
      <slot />
    </Tag>
    {lead && <p class="section-head-p_lead">{lead}</p>}
  </div>
  {
    hasAside && (
      <div class="section-head-p_aside">
        <slot name="aside" />
      </div>
    )
  }
</div>

<style is:global>
  @layer components {
    .section-head-p {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);

      &.is-center {
        align-items: center;
        text-align: center;
      }

      &.has-aside {
        @media (width >= 62rem) {
          flex-direction: row;
          align-items: end;
          justify-content: space-between;
        }
      }
    }

    .section-head-p_main {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      max-width: 56rem;

      .is-center & {
        align-items: center;
      }
    }

    .section-head-p_label {
      margin: 0;
    }

    .section-head-p_title {
      margin: 0;
      font-weight: 500;
      text-wrap: balance;

      &.is-display {
        font-size: clamp(2.75rem, 1.7rem + 4.2vw, 5.5rem);
        line-height: 0.98;
        letter-spacing: -0.045em;
      }

      &.is-h2 {
        font-size: clamp(2.25rem, 1.55rem + 2.6vw, 4rem);
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      &.is-h3 {
        font-size: clamp(1.75rem, 1.35rem + 1.4vw, 2.5rem);
        line-height: 1.08;
        letter-spacing: -0.03em;
      }
    }

    .section-head-p_lead {
      max-width: 38rem;
      margin: 0;
      color: var(--text-muted);
      font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
      line-height: 1.55;
      text-wrap: pretty;
    }

    .section-head-p_aside {
      flex: none;
    }
  }
</style>
