---
/**
 * "Read next" — the following study, as one wide card: its picture on one
 * side, its mark, headline and number on the other. The last study hands on
 * to the first, so a reader never reaches a dead end.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import ArrowCircle from "@/components/inparallel/ArrowCircle.astro";
import StudyPanel from "@/components/work/StudyPanel.astro";
import Img from "@/components/Img.astro";
import type { Project } from "@/utils/content.ts";
import { logoHeight } from "@/data/work.ts";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { id, data } = project;
---

<section class="study-next theme-light" aria-labelledby="next-title">
  <div class="study-next_inner">
    <SectionHead label="Next study" headingId="next-title">
      Read next
      <a slot="aside" class="btn btn-ghost" href="/work"> All work </a>
    </SectionHead>

    <a
      class="next-card theme-dark"
      href={`/work/${id}`}
      data-cursor="Read next"
    >
      <StudyPanel
        project={project}
        size="wide"
        sizes="(width >= 62rem) min(52vw, 46rem), 92vw"
        windowSizes="(width >= 62rem) min(39vw, 35rem), 70vw"
        class="next-card_panel"
      />
      <div class="next-card_body">
        <span class="next-card_top">
          <Img
            src={data.logo}
            alt=""
            class="next-card_logo"
            style={`--_h: ${logoHeight(data.logo)};`}
            transparent
          />
          <span class="next-card_industry">{data.industry}</span>
        </span>
        <h3 class="next-card_title heading-split inline">
          <span class="sr-only">{data.client}: </span>
          {data.headline}{" "}
          <em>{data.headlineMuted}</em>
        </h3>
        <span class="next-card_foot">
          <span class="next-card_stat">
            <span class="next-card_value">{data.stat}</span>
            <span class="next-card_label">{data.statLabel}</span>
          </span>
          <span class="next-card_go" aria-hidden="true">
            <ArrowCircle bare />
          </span>
        </span>
      </div>
    </a>
  </div>
</section>

<style is:global>
  @layer components {
    .study-next {
      padding-block: var(--section-space-large);
      background-color: var(--light-200);
    }

    .study-next_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(2rem, 1.25rem + 2vw, 3rem);
    }

    .next-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
      padding: 0.5rem;
      background-color: var(--dark-900);
      border-radius: 1.5rem;
      color: var(--light-100);
      text-decoration: none;
      box-shadow: 0 2rem 4rem -2.5rem rgb(13 25 40 / 0.6);

      @media (width >= 62rem) {
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      }

      &:focus-visible {
        outline-color: var(--brand-500);
      }
    }

    .next-card_panel {
      border-radius: 1.1rem;
    }

    .next-card_body {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    }

    .next-card_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .next-card_logo {
      width: auto;
      height: var(--_h, 1.6rem);
      max-width: 10rem;
    }

    .next-card_industry {
      color: rgb(255 255 255 / 0.6);
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .next-card_title {
      margin: 0;
      font-size: clamp(1.5rem, 1.15rem + 1.2vw, 2.25rem);
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.03em;
      text-wrap: pretty;
    }

    .next-card_foot {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1.5rem;
      margin-top: auto;
      padding-top: 1.5rem;
      border-top: var(--border-width) solid rgb(255 255 255 / 0.12);
    }

    .next-card_stat {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .next-card_value {
      background-image: var(--heading-fill);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: var(--heading-ink);
      font-size: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.05em;
      padding-bottom: 0.08em;
    }

    .next-card_label {
      color: rgb(255 255 255 / 0.6);
      font-size: 0.9375rem;
    }

    /* The way on: a stroke-shaped button the arrow sits in. */
    .next-card_go {
      position: relative;
      isolation: isolate;
      display: grid;
      place-items: center;
      width: 3.75rem;
      height: 2.75rem;
      color: var(--ink-900);

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: 0.5rem;
        background-color: var(--light-100);
        transform: skewX(calc(var(--slant) * -1));
      }
    }
  }
</style>
