---
/**
 * "Measured after launch, not before." — the figures the studies report,
 * each drawn as two strokes to scale.
 *
 * A row is one figure: the number as the study states it, what it measures,
 * and two parallel bars — what it is measured against and what shipped,
 * mobile and desktop, or the two weeks of a sprint — drawn as the row scrolls
 * in, the second a beat behind the first. The study it comes from closes the
 * row and links to it.
 *
 * The figures live in `src/data/work.ts`. Each one is checked against its
 * study when the page is built: a figure the study doesn't state, or a study
 * that isn't published, stops the build rather than reaching the page.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import ArrowCircle from "@/components/inparallel/ArrowCircle.astro";
import { getProjects } from "@/utils/content.ts";
import { MEASURES, WORK_INDEX } from "@/data/work.ts";

const studies = await getProjects();

const rows = MEASURES.map((measure) => {
  const study = studies.find(({ id }) => id === measure.study);
  if (!study)
    throw new Error(
      `[work] A figure on /work points at "${measure.study}", which isn't a published study.`,
    );
  const stated = [
    study.data.stat,
    ...study.data.results.map(({ value }) => value),
  ];
  if (!stated.includes(measure.figure))
    throw new Error(
      `[work] "${measure.figure}" isn't a figure the ${study.data.client} study states (it states ${stated.join(", ")}).`,
    );
  /* Two blue strokes are the mark itself: the first in the brand blue, the
     second in its light tint. Grey is only ever the old way. */
  const both = measure.strokes.every(({ tone }) => tone === "after");
  const strokes = measure.strokes.map((stroke, index) => ({
    ...stroke,
    tint:
      stroke.tone === "before"
        ? "is-before"
        : both && index === 1
          ? "is-light"
          : "is-after",
  }));
  return { ...measure, strokes, study };
});

const { index, label, lead } = WORK_INDEX.measures;
---

<section
  id="results"
  class="measures theme-light"
  aria-labelledby="results-title"
>
  <div class="measures_inner">
    <SectionHead
      index={index}
      label={label}
      lead={lead}
      headingId="results-title"
    >
      Measured after launch, <br />not before.
    </SectionHead>

    <ol class="measures_list" role="list">
      {
        rows.map((row) => (
          <li class="measure">
            <div class="measure_rule rule-pair" data-anim="rule">
              <i />
              <i />
            </div>

            <p
              class:list={[
                "measure_figure",
                row.figure.length > 4 && "is-long",
              ]}
              data-anim="count"
            >
              {row.figure}
            </p>

            <div class="measure_body">
              <h3 class="measure_name">{row.measure}</h3>
              <div class="measure_strokes" data-anim="rule">
                {row.strokes.map((stroke, line) => (
                  <>
                    <span class="measure_key" style={`grid-row: ${line + 1};`}>
                      {stroke.key}
                    </span>
                    <i
                      class:list={["measure_bar", stroke.tint]}
                      style={`grid-row: ${line + 1}; --_len: ${stroke.length.toFixed(4)}; --_start: ${(stroke.start ?? 0).toFixed(4)};`}
                    />
                    <span
                      class="measure_value"
                      style={`grid-row: ${line + 1}; --_len: ${stroke.length.toFixed(4)}; --_start: ${(stroke.start ?? 0).toFixed(4)};`}
                    >
                      {stroke.value}
                    </span>
                  </>
                ))}
              </div>
            </div>

            <a class="measure_study" href={`/work/${row.study.id}`}>
              <span class="measure_client">{row.study.data.client}</span>
              <span class="measure_industry">
                {row.study.data.industry}
                <span class="sr-only"> — read the study</span>
              </span>
              <ArrowCircle bare class="measure_arrow" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style is:global>
  @layer components {
    .measures {
      padding-block: var(--section-space-large);
      background-color: var(--light-200);
    }

    .measures_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    }

    .measures_list {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
      border-bottom: var(--border-width) solid var(--border-soft);
    }

    /* ---- a row ---------------------------------------------------------- */
    .measure {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "rule rule"
        "figure study"
        "body body";
      align-items: center;
      gap: 1.25rem 2rem;
      padding-bottom: clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);

      @media (width >= 62rem) {
        grid-template-columns:
          minmax(12rem, 17rem)
          minmax(0, 1fr)
          minmax(9rem, 12rem);
        grid-template-areas:
          "rule rule rule"
          "figure body study";
        column-gap: clamp(2rem, 1rem + 2.5vw, 3.5rem);
      }
    }

    .measure_rule {
      grid-area: rule;
      margin-bottom: clamp(0.75rem, 0.25rem + 1.5vw, 1.5rem);
    }

    .measure_figure {
      grid-area: figure;
      margin: 0;
      font-size: clamp(3.25rem, 2rem + 4.5vw, 6.25rem);
      font-weight: 500;
      line-height: 0.9;
      letter-spacing: -0.055em;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;

      /* A figure with a unit in words ("2 weeks") is set a size down, so it
         keeps to its column. */
      &.is-long {
        font-size: clamp(2.6rem, 1.6rem + 3vw, 4.25rem);
        letter-spacing: -0.045em;
      }
    }

    .measure_body {
      grid-area: body;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      min-width: 0;
    }

    .measure_name {
      margin: 0;
      font-family: var(--mono-family);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      line-height: 1.3;
      text-transform: uppercase;
      color: var(--text);
    }

    /* ---- the two strokes ------------------------------------------------ */
    /* Key on the left, the track on the right; the bar and the value share
       the track, the value written just past the bar's end. The track keeps
       room at its end for the longest value. */
    .measure_strokes {
      --_room: 6.5rem;
      --_h: clamp(0.8rem, 0.65rem + 0.4vw, 1.05rem);
      display: grid;
      grid-template-columns: minmax(5.5rem, 8.5rem) minmax(0, 1fr);
      align-items: center;
      row-gap: 0.55rem;
    }

    .measure_key {
      grid-column: 1;
      padding-right: 1rem;
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      line-height: 1.2;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    /* A bar is the mark's stroke: a parallelogram leaning at the slant. */
    .measure_bar {
      grid-column: 2;
      display: block;
      width: calc(var(--_len) * (100% - var(--_room)));
      min-width: calc(var(--_h) * 1.6);
      height: var(--_h);
      margin-left: calc(var(--_start) * (100% - var(--_room)));
      clip-path: polygon(
        calc(var(--_h) * var(--slant-tan)) 0,
        100% 0,
        calc(100% - var(--_h) * var(--slant-tan)) 100%,
        0 100%
      );

      &.is-before {
        background-color: color-mix(
          in srgb,
          var(--ink-900) 22%,
          var(--light-300)
        );
      }

      &.is-after {
        background-color: var(--brand-500);
      }

      &.is-light {
        background-color: var(--brand-300);
      }
    }

    .measure_value {
      grid-column: 2;
      justify-self: start;
      margin-left: calc(
        (var(--_start) + var(--_len)) * (100% - var(--_room)) + 0.75rem
      );
      font-family: var(--mono-family);
      font-size: 0.8125rem;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
      color: var(--text);
    }

    /* ---- the study ------------------------------------------------------ */
    .measure_study {
      grid-area: study;
      justify-self: end;
      display: grid;
      grid-template-columns: auto auto;
      grid-template-areas:
        "client arrow"
        "industry arrow";
      align-items: center;
      column-gap: 0.85rem;
      row-gap: 0.2rem;
      color: inherit;
      text-align: right;
      text-decoration: none;

      @media (hover: hover) {
        &:hover .measure_client::after {
          transform: none;
        }
      }
    }

    /* Hover draws a line under the name, from the arrow's side. */
    .measure_client {
      grid-area: client;
      justify-self: end;
      position: relative;
      font-weight: 500;

      &::after {
        content: "";
        position: absolute;
        inset: auto 0 -0.1em;
        height: 1px;
        background-color: var(--brand-500);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.45s var(--ease-out);
      }
    }

    .measure_industry {
      grid-area: industry;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .measure_arrow {
      --arrow-ink: var(--brand-500);
      grid-area: arrow;
      color: var(--brand-500);
    }

    @media (width < 48rem) {
      /* The line break is for the two-line setting: narrower than that it
         would strand "launch," on a line of its own. */
      .measures_inner h2 br {
        display: none;
      }

      .measure_strokes {
        --_room: 5.5rem;
        grid-template-columns: minmax(0, 5.25rem) minmax(0, 1fr);
      }
    }
  }
</style>
