---
/**
 * A page's questions: the heading on the left — it stays in view while the
 * answers scroll on wide screens — and the answers on the right, one open
 * at a time.
 *
 *   <Questions index="05" label="Questions" items={FAQ} name="pricing">
 *     Questions, answered up front
 *     <p slot="foot">Something else? <a href="/contact">Ask it</a></p>
 *   </Questions>
 *
 * `before` takes anything that belongs in the section ahead of the
 * questions — a list of what isn't offered, say.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import FaqList from "@/components/pricing/FaqList.astro";

interface Props {
  index?: string;
  label?: string;
  items: { question: string; answer: string | null; todo?: string }[];
  /** Groups the answers, so opening one closes the rest. */
  name: string;
  theme?: "light" | "dark";
  id?: string;
}

const {
  index,
  label = "Questions",
  items,
  name,
  theme = "light",
  id = "questions",
} = Astro.props;

const titleId = `${id}-title`;
---

<section
  id={id}
  class:list={["questions", `theme-${theme}`]}
  aria-labelledby={titleId}
>
  <div class="questions_inner">
    {
      Astro.slots.has("before") && (
        <div class="questions_before">
          <slot name="before" />
        </div>
      )
    }
    <div class="questions_grid">
      <div class="questions_head">
        <SectionHead index={index} label={label} headingId={titleId}>
          <slot />
        </SectionHead>
        {
          Astro.slots.has("foot") && (
            <div class="questions_foot">
              <slot name="foot" />
            </div>
          )
        }
      </div>
      <FaqList items={items} name={name} />
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    /* Cream on a light section, navy on a dark one: both are the theme's own
       background. */
    .questions {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--background);
    }

    .questions_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    }

    .questions_before {
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
    }

    .questions_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);

      @media (width >= 62rem) {
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        align-items: start;
        gap: clamp(3rem, 1rem + 5vw, 7rem);
      }
    }

    .questions_head {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;

      @media (width >= 62rem) {
        position: sticky;
        top: calc(var(--nav-height) + 2rem);
      }
    }

    .questions_foot {
      color: var(--text-muted);

      & p {
        margin: 0;
      }
    }
  }
</style>
