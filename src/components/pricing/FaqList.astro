---
/**
 * A list of questions that open one at a time.
 *
 * Built on `<details>` and `<summary>`: the browser supplies the button, the
 * expanded state, the keyboard and the announcement, and sharing a `name`
 * makes the group close one answer as another opens.
 *
 * Nothing animates a height, which would ask for layout on every frame. The
 * rows take their new places at once and slide there from where they were,
 * on transforms alone (see the script below), and the answer fades in.
 *
 * The marker is the mark's two strokes: a plus while the answer is closed,
 * leaning side by side once it is open.
 */
import Todo from "@/components/pricing/Todo.astro";

interface Item {
  question: string;
  /** `null` while the answer is still to be written. */
  answer: string | null;
  /** Something the owner still has to supply, shown as a visible TODO. */
  todo?: string;
}

interface Props {
  items: Item[];
  /** Groups the answers, so opening one closes the rest. */
  name: string;
}

const { items, name } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item" name={name}>
        <summary class="faq-item_q">
          <span class="faq-item_text">{item.question}</span>
          <span class="faq-item_icon" aria-hidden="true">
            <i />
            <i />
          </span>
        </summary>
        <div class="faq-item_a">
          {item.answer && <p class="faq-item_answer">{item.answer}</p>}
          {item.todo && <Todo>{item.todo}</Todo>}
        </div>
      </details>
    ))
  }
</div>

<script>
  const calm = matchMedia("(prefers-reduced-motion: reduce)");

  for (const list of document.querySelectorAll<HTMLElement>(".faq-list")) {
    const rows = [...list.querySelectorAll<HTMLElement>(".faq-item")];

    list.addEventListener("click", (event) => {
      if (calm.matches) return;
      if (!(event.target as Element).closest("summary")) return;
      const before = rows.map((row) => row.getBoundingClientRect().top);

      /* The browser opens the answer when this click is over, and the next
         frame is the first one painted with it open: each row is put back
         where it was for that frame and slides the difference. */
      requestAnimationFrame(() => {
        rows.forEach((row, index) => {
          for (const running of row.getAnimations()) running.cancel();
          const shift = before[index]! - row.getBoundingClientRect().top;
          if (Math.abs(shift) < 0.5) return;
          row.animate(
            { transform: [`translateY(${shift}px)`, "translateY(0)"] },
            { duration: 450, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
          );
        });
      });
    });
  }
</script>

<style is:global>
  @layer components {
    .faq-list {
      width: 100%;
      border-top: var(--border-width) solid var(--border-soft);
    }

    /* Opaque, and later rows paint over earlier ones: a row sliding down
       uncovers the answer above it instead of passing over its words. */
    .faq-item {
      position: relative;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border-soft);
    }

    .faq-item[open] .faq-item_a {
      animation: faq-answer 0.45s var(--ease-out);
    }

    @keyframes faq-answer {
      from {
        opacity: 0;
        transform: translateY(-0.4rem);
      }
    }

    .faq-item_q {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-5);
      padding-block: 1.35rem;
      font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.3;
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }

      &:focus-visible {
        outline-offset: 0.25rem;
        border-radius: 0.25rem;
      }
    }

    /* Two strokes: crossed while closed, leaning side by side once open. */
    .faq-item_icon {
      position: relative;
      flex: none;
      width: 1.6rem;
      height: 1.6rem;

      & > i {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 2px;
        height: 1rem;
        margin: -0.5rem 0 0 -1px;
        background-color: currentcolor;
        transition: transform 0.45s var(--ease-out);

        /* Open, the strokes take the mark's two blues: a layer faded in. */
        &::after {
          content: "";
          position: absolute;
          inset: 0;
          background-color: var(--brand-500);
          opacity: 0;
          transition: opacity 0.45s var(--ease-out);
        }
      }

      & > i + i {
        transform: rotate(90deg);

        &::after {
          background-color: var(--brand-300);
        }
      }
    }

    .faq-item[open] .faq-item_icon > i {
      transform: translateX(-0.2rem) rotate(var(--slant));

      &::after {
        opacity: 1;
      }
    }

    .faq-item[open] .faq-item_icon > i + i {
      transform: translateX(0.2rem) rotate(var(--slant));
    }

    .faq-item_text {
      transition: opacity var(--duration-main);
    }

    @media (hover: hover) {
      .faq-item_q:hover .faq-item_text {
        opacity: 0.6;
      }
    }

    .faq-item_a {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 0.85rem;
      max-width: 44rem;
      padding-bottom: 1.5rem;
    }

    .faq-item_answer {
      margin: 0;
      color: var(--text-muted);
      line-height: 1.6;
    }

    @media (prefers-reduced-motion: reduce) {
      .faq-item[open] .faq-item_a {
        animation: none;
      }

      .faq-item_icon > i,
      .faq-item_icon > i::after,
      .faq-item_text {
        transition: none;
      }
    }
  }
</style>
