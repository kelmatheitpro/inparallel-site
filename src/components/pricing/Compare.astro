---
/**
 * "How we compare" — an in-house team, a traditional agency and the studio,
 * one question at a time.
 *
 * It is a table, marked up with table roles so a screen reader reads it as
 * one while a grid draws it. The studio's column is a navy card standing
 * behind the cells it holds, two opposite corners cut along the slant, each
 * answer bulleted with the mark's two strokes. On narrow screens the table
 * folds into one question per block, the three answers under it, labelled.
 */
import Icon from "@/components/Icon.astro";
import SectionHead from "@/components/parallel/SectionHead.astro";
import logo from "@/assets/inparallel/logo.svg";
import { COMPARE, COMPARE_COLUMNS } from "@/data/pricing.ts";

interface Props {
  index?: string;
}

const { index = "01" } = Astro.props;
---

<section
  id="compare"
  class="compare theme-light"
  aria-labelledby="compare-title"
>
  <div class="compare_inner">
    <SectionHead
      index={index}
      label="The options"
      align="center"
      headingId="compare-title"
    >
      How we compare
    </SectionHead>

    <div
      class="compare_table"
      role="table"
      aria-labelledby="compare-title"
      style={`--rows: ${COMPARE.length + 1};`}
      data-anim="rise"
    >
      <div class="compare_card" aria-hidden="true"></div>

      <div class="compare_row is-head" role="row" style="grid-row: 1;">
        <span class="compare_cell is-corner" role="columnheader">
          <span class="sr-only">Question</span>
        </span>
        <span class="compare_cell is-name" role="columnheader">
          {COMPARE_COLUMNS.inHouse}
        </span>
        <span class="compare_cell is-name" role="columnheader">
          {COMPARE_COLUMNS.agency}
        </span>
        <span class="compare_cell is-name is-us" role="columnheader">
          <Icon
            src={logo}
            class="compare_logo"
            variant="full-width"
            role="img"
            aria-label={COMPARE_COLUMNS.us}
          />
        </span>
      </div>

      {
        /* Rows are placed by number: the card already holds the last column
           of every row, and only an explicit position may share a cell. */
        COMPARE.map((row, at) => (
          <div class="compare_row" role="row" style={`grid-row: ${at + 2};`}>
            <span class="compare_cell is-question" role="rowheader">
              {row.question}
            </span>
            <span
              class="compare_cell"
              role="cell"
              data-col={COMPARE_COLUMNS.inHouse}
            >
              {row.inHouse}
            </span>
            <span
              class="compare_cell"
              role="cell"
              data-col={COMPARE_COLUMNS.agency}
            >
              {row.agency}
            </span>
            <span
              class="compare_cell is-us"
              role="cell"
              data-col={COMPARE_COLUMNS.us}
            >
              <span class="slash-mark compare_mark" aria-hidden="true">
                <i />
                <i />
              </span>
              <span>{row.us}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  @layer components {
    .compare {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--light-200);
    }

    .compare_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    }

    /* ---- the table, wide ------------------------------------------------ */
    .compare_table {
      /* The corner cut on the studio's card: a rise of --_h, leaning --_c. */
      --_h: 2.25rem;
      --_c: calc(var(--_h) * var(--slant-tan));
      position: relative;
      display: grid;
      grid-template-columns:
        minmax(9rem, 0.9fr) minmax(0, 1fr) minmax(0, 1fr)
        minmax(0, 1.2fr);
      grid-template-rows: repeat(var(--rows), auto);
      column-gap: clamp(1rem, 0.5rem + 1.5vw, 2rem);
    }

    .compare_row {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      align-items: center;
      border-bottom: var(--border-width) solid var(--border-soft);

      &:last-child {
        border-bottom: 0;
      }
    }

    .compare_cell {
      position: relative;
      z-index: 1;
      padding-block: 1.15rem;
      color: var(--text-muted);
      font-size: 0.975rem;
      line-height: 1.4;
    }

    .compare_cell.is-question {
      color: var(--text);
      font-weight: 500;
    }

    .compare_row.is-head .compare_cell {
      padding-block: 1.5rem 1.1rem;
      color: var(--text-faded);
      font-size: 0.9375rem;
    }

    /* The studio's column: a navy card behind its cells, reaching a little
       past the table at both ends, corners cut along the slant. */
    .compare_card {
      grid-column: 4;
      grid-row: 1 / -1;
      position: relative;
      z-index: 0;
      margin-block: -1.25rem;
      background-color: var(--dark-900);
      background-image:
        repeating-linear-gradient(
          calc(90deg + var(--slant)),
          transparent 0 calc(1.75rem - 1px),
          rgb(255 255 255 / 0.04) calc(1.75rem - 1px) 1.75rem
        ),
        radial-gradient(
          90% 45% at 70% 0%,
          rgb(42 109 218 / 0.45),
          transparent 70%
        );
      border-radius: 0.35rem;
      clip-path: polygon(
        var(--_c) 0,
        100% 0,
        100% calc(100% - var(--_h)),
        calc(100% - var(--_c)) 100%,
        0 100%,
        0 var(--_h)
      );
      box-shadow: 0 2rem 4rem -2rem rgb(13 25 40 / 0.5);
    }

    .compare_cell.is-us {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      align-self: stretch;
      padding-inline: 1.5rem;
      color: var(--light-100);
      border-top: var(--border-width) solid rgb(255 255 255 / 0.08);
    }

    .compare_row.is-head .compare_cell.is-us,
    .compare_row.is-head + .compare_row .compare_cell.is-us {
      border-top: 0;
    }

    .compare_row.is-head .compare_cell.is-us {
      justify-content: center;
      padding-block: 1.75rem 1.25rem;
    }

    .compare_logo.icon {
      width: clamp(6.5rem, 5rem + 2vw, 8rem);
      color: var(--light-100);
    }

    .compare_mark {
      flex: none;
      height: 0.9rem;
      --_w: 0.18rem;
      --_gap: 0.14rem;

      & > i {
        background-color: var(--brand-300);
      }

      & > i + i {
        background-color: var(--light-100);
      }
    }

    /* ---- narrower: one question at a time ------------------------------ */
    @media (width < 62rem) {
      .compare_table {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .compare_card {
        display: none;
      }

      /* The column names stay for a screen reader; each answer carries its
         own label on screen instead. */
      .compare_row.is-head {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }

      .compare_row {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.35rem;
        padding: 1.25rem;
        background-color: var(--light-100);
        border: var(--border-width) solid var(--border-soft);
        border-radius: 1rem;

        &:last-child {
          border-bottom: var(--border-width) solid var(--border-soft);
        }
      }

      .compare_cell {
        padding-block: 0.35rem;
        font-size: 0.9375rem;

        &[data-col]::before {
          content: attr(data-col);
          display: block;
          margin-bottom: 0.2rem;
          color: var(--text-faded);
          font-family: var(--mono-family);
          font-size: 0.6875rem;
          letter-spacing: 0.08em;
          text-transform: uppercase;
        }
      }

      .compare_cell.is-question {
        padding-bottom: 0.5rem;
        font-size: 1.125rem;
        letter-spacing: -0.01em;
      }

      /* The studio's answer, in its navy, under the other two. */
      .compare_cell.is-us {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: 0.75rem;
        margin-top: 0.4rem;
        padding: 0.9rem 1rem;
        background-color: var(--dark-900);
        border: 0;
        border-radius: 0.6rem;

        /* The studio's name keeps its own casing. */
        &::before {
          grid-column: 1 / -1;
          color: rgb(255 255 255 / 0.55);
          letter-spacing: 0.02em;
          text-transform: none;
        }
      }
    }
  }
</style>
