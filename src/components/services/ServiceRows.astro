---
/**
 * "Four services, one senior crew" — the four, one row each.
 *
 * Every row opens with its lane: a panel in the service's colour whose right
 * edge is cut at the logo's angle, lettered with its number and name. The
 * rest of the row is the service in brief — its claim, what it includes, its
 * two figures — and the way to its own page.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import LaneTick from "./LaneTick.astro";
import ServiceObject from "./ServiceObject.astro";
import { SERVICES_P } from "@/data/offer.ts";
import { SERVICE_PAGES, laneStyle } from "@/data/service-pages.ts";

interface Props {
  index: string;
}

const { index } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");

/* The shape each object holds in its row: the one that reads best small. */
const SERVICE_REST = [3, 1, 2, 1];
---

<section id="services" class="rows theme-light" aria-labelledby="rows-title">
  <div class="rows_inner">
    <SectionHead
      index={index}
      label="Services"
      headingId="rows-title"
      lead="Pick the one that matches where your site is today. Each has a page of its own, with the process and the work behind it."
    >
      Four services, <br />one senior crew
    </SectionHead>

    <ol class="rows_list" role="list">
      {
        SERVICES_P.map((service, position) => {
          const page = SERVICE_PAGES[service.slug];
          return (
            <li
              class="svc-row"
              id={service.slug}
              style={laneStyle(service)}
              data-anim="rise"
              data-scene-host
            >
              <div class="svc-row_lane">
                <div class="svc-row_sheet" aria-hidden="true" />
                <p class="svc-row_count">
                  <span class="sr-only">
                    Service {position + 1} of {SERVICES_P.length}
                  </span>
                  <span aria-hidden="true">
                    {pad(position + 1)} / {pad(SERVICES_P.length)}
                  </span>
                </p>
                <h3 class="svc-row_name">{service.name}</h3>
                <ServiceObject
                  service={service}
                  rest={SERVICE_REST[position]}
                  class="svc-row_object"
                />
              </div>

              <div class="svc-row_body">
                <div class="svc-row_lead">
                  <p class="svc-row_claim">{service.headline.join(" ")}</p>
                  {page && <p class="svc-row_text">{page.overview}</p>}
                </div>

                <div class="svc-row_facts">
                  <ul class="svc-row_list" role="list">
                    {(page?.highlights ?? service.includes).map((item) => (
                      <li>
                        <LaneTick />
                        {item}
                      </li>
                    ))}
                  </ul>
                  {page && (
                    <dl class="svc-row_stats">
                      {page.facts.map((fact) => (
                        <div class="svc-row_stat">
                          <dt>{fact.label}</dt>
                          <dd>{fact.value}</dd>
                        </div>
                      ))}
                    </dl>
                  )}
                </div>

                <a
                  class="btn btn-blue svc-row_link"
                  href={`/services/${service.slug}`}
                >
                  Explore {service.name}
                </a>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style is:global>
  @layer components {
    /* The service's object has what's left of its lane under the name, so it
       can't reach the name however many lines that wraps to, and it stands to
       the left, where the lane is widest at that height. Past the lane's edge
       a glow or a shadow would only be a smudge on the card. */
    .svc-row_object {
      flex: 1;
      width: 72%;
      height: auto;
      min-height: 0;
      margin: -0.35rem 0 -1.4rem -0.75rem;
      pointer-events: none;

      & :is(.sc-glow, .sc-shadow, .sc-floor) {
        display: none;
      }
    }

    .rows {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--light-200);
    }

    .rows_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    }

    .rows_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .svc-row {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 1.25rem;
      scroll-margin-top: calc(var(--nav-height) + 1rem);
    }

    /* ---- the lane ------------------------------------------------------- */
    /* The lane narrows towards its foot, so its name is lettered near the
       top, where the colour is widest. */
    .svc-row_lane {
      position: relative;
      isolation: isolate;
      min-height: 23rem;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      padding: 1.6rem 1.75rem 1.75rem;
      color: var(--light-100);
    }

    /* The colour is a skewed sheet pinned at its top right: its right edge
       leans at exactly the logo's angle however tall the row grows, and the
       ribs drawn upright on it come out along the slant. Only the sheet is
       clipped: the object stands free of it, so it has nothing to mask. */
    .svc-row_sheet {
      position: absolute;
      inset: 0;
      z-index: -1;
      overflow: clip;
      border-radius: 1.2rem 0 0 1.2rem;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        transform: skewX(calc(var(--slant) * -1));
        transform-origin: 100% 0;
        background-color: var(--lane-dark);
        background-image:
          repeating-linear-gradient(
            90deg,
            transparent 0 calc(1.75rem - 1px),
            rgb(255 255 255 / 0.07) calc(1.75rem - 1px) 1.75rem
          ),
          radial-gradient(
            110% 80% at 85% 0%,
            color-mix(in srgb, var(--lane-accent) 65%, transparent),
            transparent 70%
          ),
          linear-gradient(
            200deg,
            color-mix(in srgb, var(--lane-accent) 32%, var(--lane-dark)),
            var(--lane-dark) 70%
          );
      }
    }

    .svc-row_count {
      margin: 0;
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      color: var(--lane-soft);
    }

    .svc-row_name {
      max-width: 10ch;
      margin: 0;
      font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.6rem);
      font-weight: 500;
      line-height: 1;
      letter-spacing: -0.035em;
    }

    /* ---- the brief ------------------------------------------------------ */
    /* The claim and the button share the left column, the button at its
       foot; what it includes takes the right. Stacked, the button comes
       last. */
    .svc-row_body {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        "lead facts"
        "link facts";
      column-gap: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
      row-gap: 1.75rem;
      padding: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
    }

    .svc-row_lead {
      grid-area: lead;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 0.9rem;
    }

    .svc-row_claim {
      margin: 0;
      font-size: clamp(1.4rem, 1.15rem + 0.8vw, 1.85rem);
      font-weight: 500;
      line-height: 1.12;
      letter-spacing: -0.03em;
      text-wrap: balance;
    }

    .svc-row_text {
      margin: 0;
      color: var(--text-muted);
      line-height: 1.5;
      text-wrap: pretty;
    }

    .svc-row_link {
      grid-area: link;
      align-self: end;
      justify-self: start;
    }

    .svc-row_facts {
      grid-area: facts;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .svc-row_list {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: var(--border-width) solid var(--border-soft);

      & li {
        display: flex;
        align-items: center;
        gap: 0.875rem;
        padding-block: 0.8rem;
        border-bottom: var(--border-width) solid var(--border-soft);
      }
    }

    .svc-row_stats {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2.5rem;
      margin: auto 0 0;
    }

    .svc-row_stat {
      display: flex;
      flex-direction: column-reverse;
      gap: 0.35rem;

      & dd {
        margin: 0;
        font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1;
      }

      & dt {
        color: var(--text-muted);
        font-size: 0.875rem;
      }
    }

    /* ---- narrower ------------------------------------------------------- */
    /* The lane is a band now: the object stands beside the name. */
    @media (width < 62rem) {
      .svc-row {
        grid-template-columns: minmax(0, 1fr);
      }
      .svc-row_lane {
        min-height: 12.5rem;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-template-rows: auto 1fr;
        align-items: start;
      }
      .svc-row_sheet {
        border-radius: 1.2rem 1.2rem 0 0;
      }
      .svc-row_object {
        grid-area: 1 / 2 / 3 / 3;
        width: 100%;
        height: 100%;
        margin: -0.5rem 0 -1rem -1rem;
      }
    }

    @media (width < 48rem) {
      .svc-row_body {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto;
        grid-template-areas:
          "lead"
          "facts"
          "link";
      }
    }

    /* Too narrow to share a line: back under the name. */
    @media (width < 30rem) {
      .svc-row_lane {
        min-height: 18.5rem;
        display: flex;
      }
      .svc-row_object {
        height: auto;
        width: 72%;
        margin: -0.35rem 0 -1.25rem -0.75rem;
      }
    }
  }
</style>
