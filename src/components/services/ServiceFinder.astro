---
/**
 * "Not sure what you need?" — pick the sentence closest to yours and we say
 * which service it is.
 *
 * The sentences are a native radio group (arrow keys move between them, and
 * the choice is announced), and the reply sits in a polite live region, so a
 * screen reader hears the answer as it changes. Each option's marker is the
 * stop from the service pages' process: one outlined stroke, filled into the
 * mark in its service's colour once chosen.
 *
 * Without JavaScript the first answer shows and the rest wait; the links to
 * every service are on the page above either way.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import LaneTick from "./LaneTick.astro";
import { SERVICES_P } from "@/data/offer.ts";
import { ASKS, ANSWERS, laneStyle } from "@/data/service-pages.ts";

interface Props {
  index: string;
}

const { index } = Astro.props;
const service = (slug: string) => {
  const found = SERVICES_P.find((item) => item.slug === slug);
  if (!found)
    throw new Error(`The finder points to an unknown service: ${slug}`);
  return found;
};
---

<section id="find" class="finder theme-light" aria-labelledby="finder-title">
  <div class="finder_inner">
    <SectionHead
      index={index}
      label="Find yours"
      align="center"
      headingId="finder-title"
      lead="Pick the sentence closest to yours, and we'll point you to the right service."
    >
      Not sure what <br />you need?
    </SectionHead>

    <div class="finder_board" data-finder>
      <fieldset class="finder_asks">
        <legend class="finder_legend">Where you are today</legend>
        {
          ASKS.map((ask, position) => (
            <label class="finder_ask" style={laneStyle(service(ask.service))}>
              <input
                class="finder_radio"
                type="radio"
                name="finder"
                value={String(position)}
                checked={position === 0}
              />
              <span class="finder_mark" aria-hidden="true">
                <i />
                <i />
              </span>
              <span class="finder_say">{ask.text}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="finder_reply" aria-live="polite">
        {
          ASKS.map((ask, position) => {
            const match = service(ask.service);
            return (
              <div
                class="finder_answer"
                data-answer={position}
                hidden={position !== 0}
                style={laneStyle(match)}
              >
                <p class="finder_heard" aria-hidden="true">
                  {ask.text}
                </p>
                <div class="finder_bubble">
                  <div class="finder_from" aria-hidden="true">
                    <span class="finder_avatar">
                      <span class="slash-mark">
                        <i />
                        <i />
                      </span>
                    </span>
                    inParallel
                  </div>
                  <p class="finder_then">
                    Then you want
                    <span class="finder_chip">
                      <LaneTick />
                      {match.name}
                    </span>
                    <span class="sr-only">.</span>
                  </p>
                  <p class="finder_text">{ANSWERS[ask.service]}</p>
                  <a
                    class="btn btn-blue finder_link"
                    href={`/services/${match.slug}`}
                  >
                    Explore {match.name}
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script>
  for (const board of document.querySelectorAll<HTMLElement>("[data-finder]")) {
    const answers = [...board.querySelectorAll<HTMLElement>("[data-answer]")];
    board.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      if (input.name !== "finder") return;
      for (const answer of answers)
        answer.hidden = answer.dataset.answer !== input.value;
    });
  }
</script>

<style is:global>
  @layer components {
    .finder {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--light-200);
    }

    .finder_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(3rem, 2rem + 3vw, 4.5rem);
    }

    .finder_board {
      width: min(100%, 66rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(1.5rem, 1rem + 2vw, 3rem);
      align-items: start;
    }

    /* ---- the sentences -------------------------------------------------- */
    .finder_asks {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
      margin: 0;
      padding: 0;
      border: 0;
    }

    .finder_legend {
      margin-bottom: 0.75rem;
      padding: 0;
      font-family: var(--mono-family);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .finder_ask {
      position: relative;
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border: var(--border-width) solid var(--border-soft);
      border-radius: 0.85rem;
      background-color: transparent;
      cursor: pointer;
      transition:
        background-color 0.3s var(--ease-out),
        border-color 0.3s var(--ease-out);

      @media (hover: hover) {
        &:hover {
          border-color: var(--border);
        }
      }

      &:has(:checked) {
        background-color: var(--light-100);
        border-color: color-mix(in srgb, var(--lane-dark) 40%, transparent);
        box-shadow: 0 0.75rem 1.5rem -1.25rem rgb(13 25 40 / 0.35);
      }

      &:has(:focus-visible) {
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: var(--focus-offset);
      }
    }

    /* The input stays in the page for the keyboard and screen readers; the
       stroke beside the sentence is what the eye reads. */
    .finder_radio {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      margin: 0;
      opacity: 0;
      cursor: pointer;
    }

    .finder_mark {
      flex: none;
      display: inline-flex;
      gap: 0.16rem;
      height: 1.25rem;

      & > i {
        display: block;
        width: 0.38rem;
        height: 100%;
        border: 1px solid var(--border);
        border-radius: 0.08rem;
        transform: skewX(calc(var(--slant) * -1));
        transition:
          background-color 0.35s var(--ease-out),
          border-color 0.35s var(--ease-out),
          opacity 0.35s var(--ease-out);
      }

      & > i + i {
        opacity: 0;
      }

      .finder_ask:has(:checked) & > i {
        background-color: var(--lane-dark);
        border-color: var(--lane-dark);
      }

      .finder_ask:has(:checked) & > i + i {
        opacity: 1;
        background-color: color-mix(
          in srgb,
          var(--lane-accent) 80%,
          var(--lane-dark)
        );
        border-color: transparent;
      }
    }

    .finder_say {
      font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
      font-weight: 500;
      line-height: 1.3;
    }

    /* ---- the reply ------------------------------------------------------ */
    .finder_reply {
      min-width: 0;
    }

    .finder_answer {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      animation: finder-in 0.55s var(--ease-out) both;

      &[hidden] {
        display: none;
      }
    }

    @keyframes finder-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }

    /* What they said, as a sent message. */
    .finder_heard {
      align-self: end;
      max-width: 85%;
      margin: 0;
      padding: 0.8rem 1.1rem;
      border-radius: 1rem 1rem 0.3rem 1rem;
      background-color: var(--ink-900);
      color: var(--light-100);
      font-size: 1rem;
    }

    .finder_bubble {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 1rem;
      padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
      overflow: clip;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 1.25rem 1.25rem 1.25rem 0.3rem;
      box-shadow: 0 1.5rem 3rem -2rem rgb(13 25 40 / 0.3);
      background-image: radial-gradient(
        70% 60% at 100% 0%,
        color-mix(in srgb, var(--lane-accent) 16%, transparent),
        transparent 70%
      );
    }

    .finder_from {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .finder_avatar {
      display: inline-grid;
      place-items: center;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 0.5rem;
      background-color: var(--dark-900);

      & .slash-mark {
        height: 0.95rem;
        --_w: 0.16rem;
        --_gap: 0.12rem;
      }
    }

    /* A flex row: the type system's leading-trim pseudo-elements would
       become stray items in it, so they're switched off here. */
    .finder_then {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.75rem;
      margin: 0;
      color: var(--text-muted);
      font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
      font-weight: 500;
      line-height: 1.15;
      letter-spacing: -0.03em;

      &::before,
      &::after {
        content: none;
      }
    }

    /* The service, set in its own colour. */
    .finder_chip {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.3rem 0.85rem 0.35rem 0.7rem;
      border-radius: 0.6rem;
      background-color: color-mix(
        in srgb,
        var(--lane-accent) 22%,
        var(--light-100)
      );
      color: var(--ink-900);

      & .lane-tick {
        height: 1.1rem;
      }
    }

    .finder_text {
      max-width: 32rem;
      margin: 0;
      color: var(--text-muted);
      font-size: 1.0625rem;
      line-height: 1.5;
    }

    .finder_link {
      margin-top: 0.5rem;
    }

    /* ---- narrower ------------------------------------------------------- */
    @media (width < 48rem) {
      .finder_board {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .finder_answer {
        animation: none;
      }
      .finder_ask,
      .finder_mark > i {
        transition: none;
      }
    }
  }
</style>
