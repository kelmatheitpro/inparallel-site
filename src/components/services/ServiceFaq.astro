---
/**
 * The questions people ask before the first call, as an accordion.
 *
 * Native `<details>`: keyboard and screen readers get a real disclosure
 * without a line of script, and sharing a `name` keeps one answer open at a
 * time. Where the browser can animate a `<details>`, the answer slides open,
 * and the marker's plus comes apart into two leaning strokes — the mark — as
 * it does.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import Copy from "./Copy.astro";
import type { Faq } from "@/data/service-pages.ts";

interface Props {
  items: Faq[];
  index: string;
  theme?: "light" | "dark";
  /** Lane colours for the markers, when the page belongs to one service. */
  style?: string;
}

const { items, index, theme = "dark", style } = Astro.props;
---

<section
  id="faq"
  class:list={["svc-faq", `theme-${theme}`, theme === "dark" && "on-lane"]}
  style={style}
  aria-labelledby="faq-title"
>
  <div class="svc-faq_inner">
    <SectionHead index={index} label="FAQ" align="center" headingId="faq-title">
      What people ask <br />before the first call
    </SectionHead>

    <div class="svc-faq_list">
      {
        items.map((item) => (
          <details class="svc-faq_item" name="services-faq">
            <summary class="svc-faq_q">
              <span class="svc-faq_text">{item.question}</span>
              <span class="svc-faq_icon" aria-hidden="true">
                <i />
                <i />
              </span>
            </summary>
            <div class="svc-faq_a">
              <p>
                <Copy text={item.answer} />
              </p>
            </div>
          </details>
        ))
      }
    </div>

    <p class="svc-faq_more">
      Something else on your mind? <a href="/contact">Ask it on the call</a>
    </p>
  </div>
</section>

<style is:global>
  @layer components {
    .svc-faq {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--background);

      &.theme-dark {
        background-color: var(--lane-dark, var(--dark-900));
      }

      &.theme-light {
        background-color: var(--light-200);
      }
    }

    .svc-faq_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    }

    .svc-faq_list {
      width: min(100%, 52rem);
      border-top: var(--border-width) solid var(--border-soft);
    }

    .svc-faq_item {
      border-bottom: var(--border-width) solid var(--border-soft);
    }

    .svc-faq_q {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding-block: 1.4rem;
      list-style: none;
      cursor: pointer;
      font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.3;

      &::-webkit-details-marker {
        display: none;
      }

      &:focus-visible {
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: var(--focus-offset);
        border-radius: 0.25rem;
      }

      .svc-faq.theme-dark &:focus-visible {
        outline-color: var(--brand-300);
      }

      @media (hover: hover) {
        &:hover .svc-faq_text {
          color: var(--text-muted);
        }
      }
    }

    .svc-faq_text {
      transition: color var(--duration-main);
    }

    /* Closed, two strokes cross in a plus. Open, both lean to the slant and
       stand apart: the mark. */
    .svc-faq_icon {
      position: relative;
      flex: none;
      width: 1.6rem;
      height: 1.6rem;
      border: var(--border-width) solid var(--border);
      border-radius: 50%;

      & > i {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 2px;
        height: 0.8rem;
        background-color: var(--lane-accent, var(--brand-300));
        translate: -50% -50%;
        transition:
          rotate 0.45s var(--ease-out),
          translate 0.45s var(--ease-out);
      }

      & > i:first-child {
        rotate: 90deg;
      }

      .svc-faq.theme-light & > i {
        background-color: var(--lane-dark, var(--brand-500));
      }
    }

    .svc-faq_item[open] .svc-faq_icon > i {
      rotate: calc(var(--slant) * 1);
    }

    .svc-faq_item[open] .svc-faq_icon > i:first-child {
      translate: calc(-50% - 0.2rem) -50%;
    }

    .svc-faq_item[open] .svc-faq_icon > i:last-child {
      translate: calc(-50% + 0.2rem) -50%;
    }

    .svc-faq_a {
      padding-bottom: 1.5rem;

      & p {
        max-width: 44rem;
        margin: 0;
        color: var(--text-muted);
        font-size: 1.0625rem;
        line-height: 1.6;
        text-wrap: pretty;
      }
    }

    .svc-faq_more {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9375rem;
      text-align: center;

      & a {
        color: var(--text);
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 0.25em;
        text-decoration-color: var(--border);

        @media (hover: hover) {
          &:hover {
            text-decoration-color: currentcolor;
          }
        }
      }
    }

    /* Where a <details> can animate its height, the answer slides open. */
    @supports selector(::details-content) {
      @media (prefers-reduced-motion: no-preference) {
        .svc-faq_item {
          interpolate-size: allow-keywords;

          &::details-content {
            block-size: 0;
            overflow: clip;
            transition:
              block-size 0.45s var(--ease-out),
              content-visibility 0.45s allow-discrete;
          }

          &[open]::details-content {
            block-size: auto;
          }
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .svc-faq_icon > i {
        transition: none;
      }
    }
  }
</style>
