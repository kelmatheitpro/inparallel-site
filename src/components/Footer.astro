---
import Icon from "@/components/Icon.astro";
import Img from "@/components/Img.astro";
import jobSuccess from "@/assets/inparallel/icons/upwork-job-success.svg";
import SocialIcon from "@/components/inparallel/SocialIcon.astro";
import logo from "@/assets/inparallel/logo.svg";
import footerGlow from "@/assets/inparallel/footer-glow.webp";
import footerLines from "@/assets/inparallel/footer-lines.svg";
import glowLine from "@/assets/inparallel/glow-line.webp";
import { SITE_NAME, CONTACT_EMAIL, SOCIAL_PROOF } from "@/consts.ts";
import { FOOTER_COLUMNS, SOCIALS, LOCATIONS } from "@/data/home.ts";
import { getProjects } from "@/utils/content.ts";
import ViewToggle from "@/components/parallel/ViewToggle.astro";

const year = new Date().getFullYear();

/* The closing ask points at /contact; on that page it would point at itself. */
const onContact = Astro.url.pathname.replace(/\/+$/, "") === "/contact";

/* The studies past the two the home page leads with, so the cards don't
   repeat the screens right above them. */
const samples = (await getProjects()).slice(2).flatMap(({ data }) => {
  const shot = data.media.card ?? data.media.desktop;
  return shot ? [shot] : [];
});
---

<footer class="footer_wrap theme-dark" id="contact">
  {
    /* The bloom is a picture and the two lines are vectors, cut from one piece
       of artwork. The bloom is all blur, which a small file holds perfectly and
       a live SVG filter would redraw on every tile; the lines have to stay
       sharp at any density, and without a filter they cost nothing. */
  }
  <Img src={footerGlow} class="footer_glow" transparent />
  <Img src={footerLines} class="footer_glow" transparent />
  <Img src={glowLine} class="footer_line" transparent />

  <div class="footer_inner">
    {/* ---- closing call to action ---------------------------------------- */}
    <div class="footer_cta" hidden={onContact}>
      <div class="footer_cta_body">
        <h2 class="footer_cta_title heading" data-anim="slash">
          Let's build the site <br />your product&nbsp;deserves.
        </h2>
        <p class="footer_cta_text">
          A 30-minute call. You leave with a plan and an estimate — whether you
          hire us or not.
        </p>

        <div class="footer_cta_actions">
          <a class="btn" href="/contact">
            Book an intro call
          </a>
          <a class="btn btn-ghost" href="/work">See our work</a>
        </div>
      </div>

      {
        /* Three screens from the studies, floating beside the heading: each
           drifts on its own, and they shy away from the pointer (the outer
           span is the shy part, `float-cards.ts`, the inner the drift). */
      }
      <div class="footer_cards" aria-hidden="true" data-float-cards>
        {
          ["one", "two", "three"].map((position, index) => (
            <span class:list={["footer_card", position]} data-float-card>
              <span class="footer_card_face">
                {samples[index] && (
                  <Img
                    src={samples[index]}
                    class="footer_card_screen"
                    variant="constrained"
                    sizes="13rem"
                  />
                )}
              </span>
            </span>
          ))
        }
      </div>
    </div>

    {
      /* ---- sitemap -------------------------------------------------------- */
    }
    <div class="footer_main">
      <div class="footer_brand">
        <a class="footer_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>

        <p class="footer_blurb">
          A Webflow studio for teams that treat the web as a growth channel.
        </p>

        <p class="footer_rating">
          <Icon
            src={jobSuccess}
            class="footer_rating_mark"
            aria-hidden="true"
          />
          <span class="footer_rating_score">{SOCIAL_PROOF.score}</span>
          <span>{SOCIAL_PROOF.source}</span>
        </p>

        <ul class="footer_socials">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  class="footer_social"
                  href={social.href}
                  aria-label={social.label}
                  rel="me noopener"
                  target="_blank"
                >
                  <SocialIcon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="footer_columns" aria-label="Footer">
        {
          FOOTER_COLUMNS.map((column) => (
            <div class="footer_column">
              <h3 class="footer_column_title">{column.title}</h3>
              <ul class="footer_links">
                {column.links.map((link) => (
                  <li>
                    <a class="footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    {
      /* ---- locations and the brief form ----------------------------------- */
    }
    <div class="footer_tiles">
      {
        LOCATIONS.map((location) => (
          <article class="footer_place">
            <Img
              src={location.image}
              alt=""
              class="footer_place_image"
              variant="constrained"
              sizes="(width >= 62rem) 30vw, 92vw"
            />
            <div class="footer_place_body">
              <h3 class="footer_place_title">{location.title}</h3>
              <p class="footer_place_text">{location.text}</p>
            </div>
          </article>
        ))
      }

      <form class="footer_brief" data-brief novalidate>
        <h3 class="footer_brief_title">Have a brief ready?</h3>

        {
          /* The form's answer takes the place of this line rather than a new
             one under the field, so saying it moves nothing on the page.
             Announced rather than just shown, so the outcome reaches someone
             who isn't looking at the field. */
        }
        <div class="footer_brief_note">
          <p class="footer_brief_text">
            Send it over — same-day estimate, no strings.
          </p>
          <p
            class="footer_brief_status"
            data-brief-status
            role="status"
            aria-live="polite"
          >
          </p>
        </div>

        <div class="footer_brief_row">
          <label class="sr-only" for="brief-email">Your email address</label>
          <input
            class="footer_brief_input"
            id="brief-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder="you@company.com"
            required
          />
          <button class="btn btn-blue footer_brief_send" type="submit">
            Send
          </button>
        </div>
      </form>
    </div>

    <div class="footer_bottom">
      <p>&copy; {year} inParallel. All rights reserved.</p>
      <ViewToggle />
      <p class="footer_bottom_note">
        <span class="slash-mark" aria-hidden="true"><i></i><i></i></span>
        Designed and built in parallel.
      </p>
    </div>

    {
      /* The name, as wide as the footer, sinking off its bottom edge. The
         logo is the mask and a lit gradient the ink, so it reads as light on
         the page rather than one more thing to read. */
    }
    <div
      class="footer_wordmark"
      aria-hidden="true"
      data-wordmark
      style={`--_mark: url("${logo.src}")`}
    >
      <i class="footer_wordmark_lamp"></i>
    </div>
  </div>
</footer>

<script>
  /* The hero's lamp, once more: a light behind the name that follows the
     pointer across the footer and fades when it leaves. Fine pointers only;
     the name reads the same without it. The light is slid, not redrawn: the
     letters are a mask as wide as the page, and repainting under it on every
     move is the kind of work that makes a page stutter. */
  const mark = document.querySelector<HTMLElement>("[data-wordmark]");
  const lamp = mark?.querySelector<HTMLElement>(".footer_wordmark_lamp");
  const footer = mark?.closest("footer");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (mark && lamp && footer && fine && !still) {
    let frame = 0;
    let x = 0;
    let y = 0;
    const paint = () => {
      frame = 0;
      const box = mark.getBoundingClientRect();
      lamp.style.transform = `translate(${x - box.left}px, ${y - box.top}px)`;
    };
    footer.addEventListener(
      "pointermove",
      (event) => {
        x = event.clientX;
        y = event.clientY;
        mark.classList.add("is-lit");
        if (!frame) frame = requestAnimationFrame(paint);
      },
      { passive: true },
    );
    footer.addEventListener("pointerleave", () =>
      mark.classList.remove("is-lit"),
    );
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-medium) var(--space-8);
      padding-inline: var(--site-margin);
      background-color: var(--dark-900);
      color: var(--light-100);
      overflow: clip;
    }

    /* Both backdrops are decoration: pinned to the footer box and out of the
       pointer path so nothing above them stops being clickable. */
    .footer_glow,
    .footer_line {
      position: absolute;
      pointer-events: none;
      user-select: none;
      z-index: 0;
    }

    /* The artwork is 2678 × 1700 — far larger than the footer — so the crop
       is what places the bloom. This lands it in the right half, with the
       darker top-left corner over the closing call to action. */
    .footer_glow {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 62% 35%;
    }

    .footer_line {
      top: 0;
      right: 12%;
      width: 60rem;
      max-width: none;
      height: 100%;
      opacity: 0.9;
    }

    .footer_inner {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    /* ---- closing call to action ----------------------------------------- */
    .footer_cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
      padding-bottom: var(--section-space-small);
      border-bottom: var(--border-width) solid rgb(255 255 255 / 0.15);
    }

    .footer_cta_body {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 1.5rem;
    }

    .footer_cta_title {
      margin: 0;
      padding-top: 0;
      font-size: clamp(2.25rem, 1.5rem + 2.6vw, 4rem);
      font-weight: 500;
      line-height: 1.02;
      letter-spacing: -0.04em;
    }

    .footer_cta_text {
      max-width: 30rem;
      margin: 0;
      color: rgb(255 255 255 / 0.65);
      font-size: 1.0625rem;
      line-height: 1.55;
    }

    .footer_cta_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    /* Three cards pinned to one box so their tilts don't disturb the row. */
    .footer_cards {
      position: relative;
      flex: none;
      width: 22rem;
      height: 16rem;
    }

    .footer_card {
      position: absolute;
      display: block;

      &.one {
        --_tilt: -6deg;
        --_time: 6.5s;
        --_wait: 0s;
        --_rise: 0.55rem;
        top: 0.5rem;
        left: 0;
        width: 13rem;
        height: 8rem;
      }
      &.two {
        --_tilt: -9deg;
        --_time: 5.2s;
        --_wait: -2.1s;
        --_rise: 0.8rem;
        top: 6.5rem;
        right: 0;
        width: 7rem;
        height: 5rem;
      }
      &.three {
        --_tilt: 3deg;
        --_time: 7.4s;
        --_wait: -4.3s;
        --_rise: 0.65rem;
        top: 9.5rem;
        left: 3.5rem;
        width: 9rem;
        height: 5.75rem;
      }
    }

    /* Each at its own pace, so they never settle into a rhythm. Only `translate`
       and `rotate`: the compositor runs this without the page doing anything. */
    .footer_card_face {
      display: block;
      width: 100%;
      height: 100%;
      overflow: clip;
      background-color: var(--light-100);
      border: var(--border-width) solid rgb(255 255 255 / 0.15);
      border-radius: 0.75rem;
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
      rotate: var(--_tilt);
      animation: footer-float var(--_time) ease-in-out var(--_wait) infinite
        alternate;

      .is-away & {
        animation-play-state: paused;
      }

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }

    @keyframes footer-float {
      from {
        translate: -0.15rem calc(var(--_rise) * -1);
        rotate: calc(var(--_tilt) - 1.4deg);
      }
      to {
        translate: 0.15rem var(--_rise);
        rotate: calc(var(--_tilt) + 1.4deg);
      }
    }

    .footer_card_screen {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
    }

    /* ---- sitemap --------------------------------------------------------- */
    .footer_main {
      display: grid;
      gap: var(--space-8);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      padding-block: var(--space-8);
    }

    .footer_brand {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
      max-width: 22rem;
    }

    .footer_logo {
      display: block;
      width: 10.5rem;
      color: inherit;
      transition: opacity var(--duration-main);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .footer_blurb {
      color: rgb(255 255 255 / 0.7);
      line-height: var(--line-height-large);
    }

    .footer_rating_mark {
      --_size: 1.125rem;
      color: var(--brand-300);
    }

    .footer_rating_score {
      font-weight: var(--primary-medium);
    }

    .footer_rating {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.5rem 0.875rem;
      background-color: rgb(0 0 0 / 0.5);
      border: var(--border-width) solid rgb(255 255 255 / 0.15);
      border-radius: var(--radius-round);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_socials {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer_social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: var(--border-width) solid rgb(255 255 255 / 0.2);
      border-radius: var(--radius-round);
      color: inherit;
      transition:
        background-color var(--duration-main),
        border-color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          background-color: rgb(255 255 255 / 0.1);
          border-color: rgb(255 255 255 / 0.5);
        }
      }
    }

    .footer_columns {
      display: grid;
      gap: var(--space-8);
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));

      /* In a row of three the last column holds the email address, which can't
         break, so it takes the width it needs and the other two share the
         rest. Left to thirds it runs past the page's margin. */
      @media (width >= 36rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) max-content;
      }
    }

    .footer_column {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    .footer_column_title {
      color: rgb(255 255 255 / 0.5);
      font-size: var(--text-small);
      font-weight: var(--primary-regular);
      letter-spacing: var(--letter-spacing-normal);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* The link in hand comes up and draws its line out from the left, and the
       rest of its column steps back. All of it is opacity and a transform, so
       a pointer running down the column costs no paint. */
    .footer_link {
      position: relative;
      display: inline-block;
      color: var(--light-100);
      font-size: var(--text-small);
      text-decoration: none;
      opacity: 0.85;
      transition: opacity 0.3s ease;

      &::after {
        content: "";
        position: absolute;
        inset: auto 0 -0.125rem;
        height: 1px;
        background-color: currentcolor;
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
        pointer-events: none;
      }

      &:focus-visible {
        opacity: 1;
      }

      &:focus-visible::after {
        transform: scaleX(1);
      }

      @media (hover: hover) {
        &:hover {
          opacity: 1;
        }

        &:hover::after {
          transform: scaleX(1);
        }
      }
    }

    @media (hover: hover) {
      .footer_column:has(.footer_link:hover) .footer_link:not(:hover) {
        opacity: 0.4;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .footer_link,
      .footer_link::after {
        transition: none;
      }
    }

    /* ---- locations and the brief form ------------------------------------ */
    .footer_tiles {
      display: grid;
      gap: var(--space-5);
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    }

    .footer_place {
      position: relative;
      display: flex;
      align-items: end;
      min-height: 9.375rem;
      padding: var(--space-4);
      border-radius: var(--radius-card);
      overflow: clip;
    }

    .footer_place_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Enough of a wash for the label to hold contrast over any frame. */
    .footer_place::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(
        to bottom,
        rgb(11 10 12 / 0.1),
        rgb(11 10 12 / 0.85)
      );
    }

    .footer_place_body {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer_place_title {
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
    }

    .footer_place_text {
      color: rgb(255 255 255 / 0.7);
      font-size: var(--text-small);
    }

    .footer_brief {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5);
      background-color: rgb(255 255 255 / 0.04);
      border: var(--border-width) solid rgb(255 255 255 / 0.15);
      border-radius: var(--radius-card);
    }

    .footer_brief_title {
      font-size: var(--h6);
      font-weight: var(--primary-medium);
    }

    /* The line and the answer share one cell, and trade places by fading. */
    .footer_brief_note {
      display: grid;

      & > * {
        grid-area: 1 / 1;
        transition: opacity 0.25s var(--ease-soft);
      }

      &:has(.footer_brief_status:not(:empty)) .footer_brief_text {
        opacity: 0;
      }
    }

    .footer_brief_text {
      color: rgb(255 255 255 / 0.6);
      font-size: var(--text-small);
    }

    .footer_brief_row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }

    .footer_brief_input {
      flex: 1 0 0;
      min-width: 0;
      padding: 0.875rem 1rem;
      background-color: transparent;
      border: var(--border-width) solid rgb(255 255 255 / 0.2);
      border-radius: var(--radius-main);
      color: var(--light-100);
      font-size: var(--text-small);
      transition: border-color var(--duration-main);

      &::placeholder {
        color: rgb(255 255 255 / 0.4);
      }
      &:focus-visible {
        border-color: var(--brand-300);
        outline: none;
      }
      &[aria-invalid="true"] {
        border-color: #ff8080;
      }
    }

    /* The site's button, at the height of the field it sits beside. */
    .btn.footer_brief_send {
      --_pad: 1.25rem;
      align-self: stretch;
      min-height: 0;
      border-radius: var(--radius-main);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_brief_status {
      font-size: var(--text-small);

      &:empty {
        opacity: 0;
      }
      &[data-ok] {
        color: var(--brand-300);
      }
      &[data-error] {
        color: #ff8080;
      }
    }

    /* ---- bottom bar ------------------------------------------------------ */
    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-top: var(--space-8);
      color: rgb(255 255 255 / 0.5);
      font-size: var(--text-small);
    }

    .footer_bottom_note {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: rgb(255 255 255 / 0.45);

      & .slash-mark {
        height: 0.8rem;
        --_w: 0.14rem;
        --_gap: 0.12rem;
      }
    }

    /* ---- wordmark -------------------------------------------------------- */
    /* Sized off the logo's own proportions, and pulled down through the
       footer's bottom padding so the lower fifth of the letters is cut off
       by the page's edge. */
    .footer_wordmark {
      position: relative;
      width: 100%;
      aspect-ratio: 670.97 / 119;
      margin-bottom: calc(var(--space-8) * -1 - 3.25vw);
      background-image: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--brand-300) 30%, transparent),
        transparent 90%
      );
      -webkit-mask: var(--_mark) center / 100% 100% no-repeat;
      mask: var(--_mark) center / 100% 100% no-repeat;

      /* The lamp: a soft light under the letters, wherever the pointer is. */
      &.is-lit .footer_wordmark_lamp {
        opacity: 1;
      }
    }

    /* Centred on its own top left corner, which is the point the script moves. */
    .footer_wordmark_lamp {
      position: absolute;
      top: -18rem;
      left: -18rem;
      width: 36rem;
      height: 36rem;
      background-image: radial-gradient(
        closest-side,
        color-mix(in srgb, var(--brand-300) 75%, transparent),
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.8s var(--ease-out);
      will-change: transform;
    }

    /* ---- narrower --------------------------------------------------------- */
    @media (width < 62rem) {
      .footer_cta {
        flex-direction: column;
        align-items: start;
      }
      .footer_cards {
        width: 100%;
        max-width: 22rem;
      }
      .footer_main {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (width < 30rem) {
      .footer_brief_row {
        flex-wrap: wrap;
      }
      .btn.footer_brief_send {
        width: 100%;
        min-height: 2.875rem;
      }
    }
  }
</style>
