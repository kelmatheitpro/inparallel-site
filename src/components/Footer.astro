---
import Icon from "@/components/Icon.astro";
import Img from "@/components/Img.astro";
import Heading from "@/components/Heading.astro";
import Stars from "@/components/inparallel/Stars.astro";
import SocialIcon from "@/components/inparallel/SocialIcon.astro";
import logo from "@/assets/inparallel/logo.svg";
import footerGlow from "@/assets/inparallel/footer-glow.svg";
import glowLine from "@/assets/inparallel/glow-line.svg";
import arrowCircle from "@/assets/inparallel/icons/arrow-circle.svg";
import arrowDiagonal from "@/assets/inparallel/icons/arrow-diagonal.svg";
import { SITE_NAME, CONTACT_EMAIL } from "@/consts.ts";
import { FOOTER_COLUMNS, SOCIALS, LOCATIONS } from "@/data/home.ts";

const year = new Date().getFullYear();
---

<footer class="footer_wrap theme-dark" id="contact">
  <Img src={footerGlow} class="footer_glow" transparent />
  <Img src={glowLine} class="footer_line" transparent />

  <div class="footer_inner">
    {/* ---- closing call to action ---------------------------------------- */}
    <div class="footer_cta">
      <div class="footer_cta_body">
        <Heading tag="h2" variant="h3" class="heading-split">
          Every great website <em>starts with a conversation</em>
        </Heading>

        <div class="footer_cta_actions">
          <a class="footer_button" href={`mailto:${CONTACT_EMAIL}`}
            >Book a call</a
          >
          <a class="footer_mail" href={`mailto:${CONTACT_EMAIL}`}>
            {CONTACT_EMAIL}
            <Icon src={arrowCircle} class="footer_mail_icon" />
          </a>
        </div>
      </div>

      {
        /* The three tilted cards the design floats beside the heading — the
           work samples that drop in here are still to come. */
      }
      <div class="footer_cards" aria-hidden="true">
        <span class="footer_card one"></span>
        <span class="footer_card two"></span>
        <span class="footer_card three"></span>
      </div>
    </div>

    {
      /* ---- sitemap -------------------------------------------------------- */
    }
    <div class="footer_main">
      <div class="footer_brand">
        <a class="footer_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>

        <p class="footer_blurb">
          A Webflow studio for teams that treat the web as a growth channel.
        </p>

        <p class="footer_rating">
          <span>Clutch</span>
          <Stars aria-hidden="true" />
          <span>5.0</span>
        </p>

        <ul class="footer_socials">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  class="footer_social"
                  href={social.href}
                  aria-label={social.label}
                  rel="me noopener"
                  target="_blank"
                >
                  <SocialIcon name={social.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav class="footer_columns" aria-label="Footer">
        {
          FOOTER_COLUMNS.map((column) => (
            <div class="footer_column">
              <h3 class="footer_column_title">{column.title}</h3>
              <ul class="footer_links">
                {column.links.map((link) => (
                  <li>
                    <a class="footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    {
      /* ---- locations and the brief form ----------------------------------- */
    }
    <div class="footer_tiles">
      {
        LOCATIONS.map((location) => (
          <article class="footer_place">
            <Img
              src={location.image}
              alt=""
              class="footer_place_image"
              variant="constrained"
              sizes="(width >= 62rem) 30vw, 92vw"
            />
            <div class="footer_place_body">
              <h3 class="footer_place_title">{location.title}</h3>
              <p class="footer_place_text">{location.text}</p>
            </div>
          </article>
        ))
      }

      <form class="footer_brief" data-brief novalidate>
        <h3 class="footer_brief_title">Have a brief ready?</h3>
        <p class="footer_brief_text">
          Send it over — same-day estimate, no strings.
        </p>

        <div class="footer_brief_row">
          <label class="sr-only" for="brief-email">Your email address</label>
          <input
            class="footer_brief_input"
            id="brief-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder={CONTACT_EMAIL}
            required
          />
          <button class="footer_brief_send" type="submit">
            Send
            <Icon src={arrowDiagonal} class="footer_brief_arrow" />
          </button>
        </div>

        {
          /* Announced rather than just shown, so the outcome reaches someone
             who isn't looking at the field. */
        }
        <p
          class="footer_brief_status"
          data-brief-status
          role="status"
          aria-live="polite"
        >
        </p>
      </form>
    </div>

    <div class="footer_bottom">
      <p>&copy; {year} inparallel studio. All rights reserved.</p>
      <p class="footer_bottom_note">Made in Webflow, obviously.</p>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-medium) var(--space-8);
      padding-inline: var(--site-margin);
      background-color: var(--dark-900);
      color: var(--light-100);
      overflow: clip;
    }

    /* Both backdrops are decoration: pinned to the footer box and out of the
       pointer path so nothing above them stops being clickable. */
    .footer_glow,
    .footer_line {
      position: absolute;
      pointer-events: none;
      user-select: none;
      z-index: 0;
    }

    /* The artwork is 2678 × 1700 — far larger than the footer — so the crop
       is what places the bloom. This lands it in the right half, with the
       darker top-left corner over the closing call to action. */
    .footer_glow {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 62% 35%;
    }

    .footer_line {
      top: 0;
      right: 12%;
      width: 60rem;
      max-width: none;
      height: 100%;
      opacity: 0.9;
    }

    .footer_inner {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    /* ---- closing call to action ----------------------------------------- */
    .footer_cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-8);
      padding-bottom: var(--section-space-small);
      border-bottom: var(--border-width) solid rgb(255 255 255 / 0.15);
    }

    .footer_cta_body {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-8);
    }

    .footer_cta_actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-5);
    }

    .footer_button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem 2.25rem;
      background-color: var(--brand-500);
      border-radius: var(--radius-main);
      box-shadow: var(--shadow-button-inset);
      color: var(--light-100);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      text-decoration: none;
      filter: drop-shadow(var(--shadow-brand));
      transition:
        background-color var(--duration-main),
        translate var(--duration-main) var(--ease-out);
      @media (hover: hover) {
        &:hover {
          translate: 0 -2px;
          background-color: color-mix(in srgb, var(--brand-500), white 12%);
        }
      }
    }

    .footer_mail {
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      color: inherit;
      font-size: var(--text-main);
      font-weight: var(--primary-semibold);
      text-decoration: none;
    }

    .footer_mail_icon {
      --_size: 2rem;
      transition: transform var(--duration-main) var(--ease-out);
    }

    @media (hover: hover) {
      .footer_mail:hover .footer_mail_icon {
        transform: translateX(0.25rem);
      }
    }

    /* Three cards pinned to one box so their tilts don't disturb the row. */
    .footer_cards {
      position: relative;
      flex: none;
      width: 22rem;
      height: 16rem;
    }

    .footer_card {
      position: absolute;
      display: block;
      background-color: var(--light-100);
      border-radius: 0.75rem;
      box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);

      &.one {
        top: 0.5rem;
        left: 0;
        width: 13rem;
        height: 8rem;
        rotate: -6deg;
      }
      &.two {
        top: 6.5rem;
        right: 0;
        width: 7rem;
        height: 5rem;
        rotate: -9deg;
      }
      &.three {
        top: 9.5rem;
        left: 3.5rem;
        width: 9rem;
        height: 5.75rem;
        rotate: 3deg;
      }
    }

    /* ---- sitemap --------------------------------------------------------- */
    .footer_main {
      display: grid;
      gap: var(--space-8);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      padding-block: var(--space-8);
    }

    .footer_brand {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
      max-width: 22rem;
    }

    .footer_logo {
      display: block;
      width: 10.5rem;
      color: inherit;
      transition: opacity var(--duration-main);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .footer_blurb {
      color: rgb(255 255 255 / 0.7);
      line-height: var(--line-height-large);
    }

    .footer_rating {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.5rem 0.875rem;
      background-color: rgb(0 0 0 / 0.5);
      border: var(--border-width) solid rgb(255 255 255 / 0.15);
      border-radius: var(--radius-round);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_socials {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer_social {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: var(--border-width) solid rgb(255 255 255 / 0.2);
      border-radius: var(--radius-round);
      color: inherit;
      transition:
        background-color var(--duration-main),
        border-color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          background-color: rgb(255 255 255 / 0.1);
          border-color: rgb(255 255 255 / 0.5);
        }
      }
    }

    .footer_columns {
      display: grid;
      gap: var(--space-8);
      grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    }

    .footer_column {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
    }

    .footer_column_title {
      color: rgb(255 255 255 / 0.5);
      font-size: var(--text-small);
      font-weight: var(--primary-regular);
      letter-spacing: var(--letter-spacing-normal);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer_link {
      color: var(--light-100);
      font-size: var(--text-small);
      text-decoration: none;
      transition: color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          color: var(--brand-300);
        }
      }
    }

    /* ---- locations and the brief form ------------------------------------ */
    .footer_tiles {
      display: grid;
      gap: var(--space-5);
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    }

    .footer_place {
      position: relative;
      display: flex;
      align-items: end;
      min-height: 9.375rem;
      padding: var(--space-4);
      border-radius: var(--radius-card);
      overflow: clip;
    }

    .footer_place_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Enough of a wash for the label to hold contrast over any frame. */
    .footer_place::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(
        to bottom,
        rgb(11 10 12 / 0.1),
        rgb(11 10 12 / 0.85)
      );
    }

    .footer_place_body {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }

    .footer_place_title {
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
    }

    .footer_place_text {
      color: rgb(255 255 255 / 0.7);
      font-size: var(--text-small);
    }

    .footer_brief {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5);
      background-color: rgb(255 255 255 / 0.04);
      border: var(--border-width) solid rgb(255 255 255 / 0.15);
      border-radius: var(--radius-card);
    }

    .footer_brief_title {
      font-size: var(--h6);
      font-weight: var(--primary-medium);
    }

    .footer_brief_text {
      color: rgb(255 255 255 / 0.6);
      font-size: var(--text-small);
    }

    .footer_brief_row {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-top: var(--space-3);
    }

    .footer_brief_input {
      flex: 1 0 0;
      min-width: 0;
      padding: 0.875rem 1rem;
      background-color: transparent;
      border: var(--border-width) solid rgb(255 255 255 / 0.2);
      border-radius: var(--radius-main);
      color: var(--light-100);
      font-size: var(--text-small);
      transition: border-color var(--duration-main);

      &::placeholder {
        color: rgb(255 255 255 / 0.4);
      }
      &:focus-visible {
        border-color: var(--brand-300);
        outline: none;
      }
    }

    .footer_brief_send {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 0.875rem 1.25rem;
      background-color: var(--brand-500);
      border: 0;
      border-radius: var(--radius-main);
      color: var(--light-100);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      white-space: nowrap;
      transition: background-color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          background-color: color-mix(in srgb, var(--brand-500), white 12%);
        }
      }
    }

    .footer_brief_arrow {
      --_size: 0.625rem;
      width: 0.625rem;
      height: auto;
    }

    /* Empty until the form has something to say, so it takes no room. */
    .footer_brief_status {
      font-size: var(--text-tiny);
      line-height: var(--line-height-large);

      &:empty {
        display: none;
      }
      &[data-ok] {
        color: var(--brand-300);
      }
      &[data-error] {
        color: #ff8080;
      }
    }

    /* ---- bottom bar ------------------------------------------------------ */
    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-top: var(--space-8);
      color: rgb(255 255 255 / 0.5);
      font-size: var(--text-small);
    }

    .footer_bottom_note {
      color: rgb(255 255 255 / 0.35);
    }

    /* ---- narrower --------------------------------------------------------- */
    @media (width < 62rem) {
      .footer_cta {
        flex-direction: column;
        align-items: start;
      }
      .footer_cards {
        width: 100%;
        max-width: 22rem;
      }
      .footer_main {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (width < 30rem) {
      .footer_brief_row {
        flex-wrap: wrap;
      }
      .footer_brief_send {
        width: 100%;
        justify-content: center;
      }
    }
  }
</style>
