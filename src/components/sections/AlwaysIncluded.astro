---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import { ALWAYS_INCLUDED } from "@/data/services.ts";
---

<Section theme="light" containerClass="container-narrow">
  <div class="section-head" data-reveal>
    <Heading tag="h2" class="heading-split inline">
      In everything we ship. <em>Not a premium tier.</em>
    </Heading>
  </div>

  {
    /* A definition list rather than cards: these are terms of the deal, and
       they read faster as a list of terms than as six boxes. */
  }
  <dl class="included" data-reveal>
    {
      ALWAYS_INCLUDED.map((item) => (
        <div class="included_row">
          <dt class="included_term">{item.title}</dt>
          <dd class="included_text">{item.text}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<style is:global>
  @layer components {
    .included {
      width: 100%;
      display: grid;
      gap: 0;
      grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
      margin: 0;
    }

    .included_row {
      display: grid;
      gap: var(--space-2) var(--space-5);
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
      align-items: baseline;
      padding-block: var(--space-5);
      border-top: var(--border-width) solid var(--border-soft);
    }

    .included_term {
      font-weight: var(--primary-semibold);
      font-size: var(--text-small);
    }

    .included_text {
      margin: 0;
      color: var(--text-muted);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
    }

    @media (width < 40rem) {
      .included_row {
        grid-template-columns: minmax(0, 1fr);
      }
    }
  }
</style>
