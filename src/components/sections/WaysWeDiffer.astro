---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Icon from "@/components/Icon.astro";
import { DIFFERENTIATORS } from "@/data/home.ts";
import crew from "@/assets/inparallel/icons/crew.svg";
import theatre from "@/assets/inparallel/icons/theatre.svg";

/* Two of the five marks ship as artwork; the other three are drawn from the
   same bordered boxes the design builds them from. */
const artwork = { crew, star: theatre } as const;
---

<Section
  id="why"
  theme="light"
  class="differ"
  containerClass="differ_container"
>
  <div class="differ_intro">
    <Heading tag="h2" variant="h1" class="heading-split">
      Same brief, <em>different altitude.</em>
    </Heading>
    <Paragraph class="text-muted">
      Five things clients tell us they didn't get from their last agency.
    </Paragraph>
    <a class="differ_cta" href="/contact">Put us to the test</a>
  </div>

  <ul class="differ_list">
    {
      DIFFERENTIATORS.map((item) => (
        <li class="differ_item">
          <span class="differ_icon" aria-hidden="true">
            {item.icon in artwork ? (
              <Icon
                src={artwork[item.icon as keyof typeof artwork]}
                class="differ_art"
              />
            ) : (
              <span class:list={["differ_shape", item.icon]}>
                <span /> <span /> <span /> <span />
              </span>
            )}
          </span>

          <div class="differ_body">
            <h3 class="differ_title">{item.title}</h3>
            <p class="differ_text">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style is:global>
  @layer components {
    /* Two columns that don't share a width: the intro is as wide as its copy
       and the list takes the rest, which is the design's 200px split. */
    .differ_container {
      flex-direction: row;
      align-items: start;
      gap: clamp(var(--space-8), 8vw, 12.5rem);
    }

    .differ_intro {
      flex: none;
      max-width: 26rem;
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
    }

    .differ_cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: var(--space-5);
      padding: 1.25rem 2.25rem;
      background-color: var(--brand-500);
      border-radius: var(--radius-main);
      box-shadow: var(--shadow-button-inset);
      color: var(--light-100);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      text-decoration: none;
      transition: background-color var(--duration-main);
      @media (hover: hover) {
        &:hover {
          background-color: var(--brand-700);
        }
      }
    }

    .differ_list {
      flex: 1 0 0;
      min-width: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .differ_item {
      display: flex;
      align-items: start;
      gap: var(--space-5);
      padding-block: 1.875rem;
      border-bottom: var(--border-width) solid var(--border);
    }

    .differ_icon {
      flex: none;
      position: relative;
      width: 2.25rem;
      height: 2.25rem;
    }

    .differ_art {
      --_size: 2.25rem;
      color: #111111;
    }

    .differ_body {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .differ_title {
      font-size: var(--h5);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-small);
      letter-spacing: var(--letter-spacing-tight);
    }

    .differ_text {
      color: var(--text-muted);
      line-height: var(--line-height-large);
    }

    /* ---- the three drawn marks ------------------------------------------
       Each is the same 36px box with a 2.25px rule, so only the parts that
       differ are set per shape. One span of the four carries the brand color,
       which is what marks each one. */
    .differ_shape {
      position: absolute;
      inset: 0;
      display: block;

      & > span {
        position: absolute;
        display: block;
        border: 2.25px solid #111111;
      }
    }

    /* A ring inside a ring. */
    .differ_shape.target {
      border: 2.25px solid #000000;
      border-radius: var(--radius-round);
      padding: 0.5625rem;

      & > span:first-child {
        position: static;
        width: 100%;
        height: 100%;
        border-color: var(--brand-500);
        border-radius: var(--radius-round);
      }
      & > span:not(:first-child) {
        display: none;
      }
    }

    /* Four squares; the top-right one is the brand one. */
    .differ_shape.grid > span {
      width: 1.0625rem;
      height: 1.0625rem;
      border-radius: 4px;
    }
    .differ_shape.grid > span:nth-child(1) {
      top: 0;
      left: 0;
    }
    .differ_shape.grid > span:nth-child(2) {
      top: 0;
      right: 0;
      border-color: var(--brand-500);
    }
    .differ_shape.grid > span:nth-child(3) {
      top: 1.1875rem;
      left: 0;
    }
    .differ_shape.grid > span:nth-child(4) {
      top: 1.1875rem;
      right: 0;
    }

    /* Three bars of different heights, sitting on one baseline. */
    .differ_shape.chart > span:nth-child(1) {
      inset: 1.125rem 1.625rem 0 0;
    }
    .differ_shape.chart > span:nth-child(2) {
      inset: 0 0.8125rem;
    }
    .differ_shape.chart > span:nth-child(3) {
      inset: 1.4375rem 0 0 1.625rem;
    }
    .differ_shape.chart > span:nth-child(4) {
      display: none;
    }

    @media (width < 62rem) {
      .differ_container {
        flex-direction: column;
      }
      .differ_intro {
        max-width: none;
      }
    }
  }
</style>
