---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import RatingBadge from "@/components/inparallel/RatingBadge.astro";
import { AUTOMATION_TOOLS } from "@/data/services.ts";
import { QUOTE_WITHIN } from "@/data/services.ts";
import webflowBadge from "@/assets/inparallel/webflow-badge.png";
---

{
  /* The standing-behind-it section. Deliberately three things we can point at
     rather than a wall of awards: a partner status, a public review score and a
     promise with a number in it. Two of the three are already on the home
     page's hero, so this is the same claim in the same words. */
}
<Section theme="light" containerClass="container-narrow">
  <div class="section-head centered" data-reveal>
    <Heading tag="h2" class="heading-split creds_title">
      What we'll put in writing.{" "}
      <em>And what you can check yourself.</em>
    </Heading>
  </div>

  <ul class="creds grid-cards" data-reveal>
    <li class="cred surface-solid">
      <Img src={webflowBadge} alt="" class="cred_badge" transparent />
      <p class="cred_value">Professional Partner</p>
      <p class="cred_label">
        Listed in Webflow's own partner directory, where you can verify it.
      </p>
    </li>

    <li class="cred surface-solid">
      <RatingBadge variant="outline" class="cred_rating" />
      <p class="cred_value">Five out of five</p>
      <p class="cred_label">
        Every review public, written by a client who paid for the work.
      </p>
    </li>

    <li class="cred surface-solid">
      <p class="cred_stamp" aria-hidden="true">14</p>
      <p class="cred_value">Days of free fixes</p>
      <p class="cred_label">
        After handover, bugs are ours and not billed — and the quote arrives
        within {QUOTE_WITHIN}.
      </p>
    </li>
  </ul>

  <div class="tools" data-reveal>
    <p class="tools_label">Connects to whatever you already run</p>
    <ul class="tools_list">
      {AUTOMATION_TOOLS.map((tool) => <li class="pill-tag">{tool}</li>)}
    </ul>
  </div>
</Section>

<style is:global>
  @layer components {
    .creds_title {
      max-width: 24ch;
      margin-inline: auto;
      text-align: center;
      text-wrap: balance;
    }

    .creds {
      --_min: 17rem;
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .cred {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      min-height: 14rem;
      padding: var(--space-6);
      border: var(--border-width) solid var(--border-soft);
      border-radius: var(--radius-card);
    }

    .cred_badge {
      width: 2.75rem;
      height: auto;
    }

    .cred_rating {
      align-self: start;
    }

    /* A number standing in for a badge on the card that hasn't got one. */
    .cred_stamp {
      font-size: var(--h2);
      font-weight: var(--primary-semibold);
      letter-spacing: var(--letter-spacing-tighter);
      line-height: 0.85;
      color: var(--brand-500);
    }

    .cred_value {
      margin-top: auto;
      font-size: var(--text-large);
      font-weight: var(--primary-medium);
    }

    .cred_label {
      color: var(--text-muted);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
    }

    .tools {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--space-4) var(--space-6);
      padding-top: var(--space-6);
      border-top: var(--border-width) solid var(--border-soft);
    }

    .tools_label {
      color: var(--text-faded);
      font-size: var(--text-small);
    }

    .tools_list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
