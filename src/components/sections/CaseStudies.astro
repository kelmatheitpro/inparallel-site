---
/**
 * "Every project, measured by its results" — two studies, each a panel and
 * the study's card, the side swapping every other row.
 *
 * On a service's own page it runs in that service's colour, with the study
 * closest to the service first.
 */
import SectionHead from "@/components/parallel/SectionHead.astro";
import CaseVisual from "@/components/inparallel/CaseVisual.astro";
import ProjectCard from "@/components/inparallel/ProjectCard.astro";
import ProjectGallery from "@/components/inparallel/ProjectGallery.astro";
import { getProjects } from "@/utils/content.ts";
import { laneStyle } from "@/data/service-pages.ts";
import type { Service } from "@/data/offer.ts";

interface Props {
  index?: string;
  /** The service whose page this is, for its colour. */
  service?: Service;
  /** The study that leads, on a service's page. */
  lead?: string;
}

const { index = "02", service, lead } = Astro.props;

/* The studies with a panel; the rest live on /work. */
const projects = (await getProjects())
  .filter(({ data }) => data.media.screens)
  .sort((a, b) => Number(b.id === lead) - Number(a.id === lead))
  .slice(0, 2);
---

<section
  id="work"
  class:list={["cases", "theme-dark", service && "has-lane on-lane"]}
  style={service ? laneStyle(service) : undefined}
  aria-labelledby="work-title"
>
  <div class="cases_inner">
    <SectionHead
      index={index}
      label="Work"
      align="center"
      headingId="work-title"
    >
      Every project, <br class="cases_break" />measured by its results
    </SectionHead>

    {
      projects.map((project, position) => (
        /* The rows alternate which side the panel is on; the markup stays
           panel-then-card so the reading order doesn't change with it. */
        <div
          class:list={["case_row", position % 2 === 1 && "reversed"]}
          data-anim="rise"
        >
          <CaseVisual project={project} class="case_panel" />
          <ProjectCard project={project} />
        </div>
      ))
    }
  </div>
</section>

<ProjectGallery />

<style is:global>
  @layer components {
    .cases {
      padding-block: var(--section-space-large, 8rem) var(--space-8);
      background-color: var(--dark-900);

      &.has-lane {
        --case-tag: var(--lane-dark);
        background-color: var(--lane-dark);
      }
    }

    /* The section's own padding clears the bar on a jump to it, so nothing of
       the section above is left showing between the two. Lenis, where it runs,
       allows for the bar itself. */
    .cases:target {
      scroll-margin-top: var(--nav-height);
    }

    html.lenis .cases:target {
      scroll-margin-top: 0;
    }

    .cases_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: 1.5625rem;
    }

    .cases_inner > .section-head-p {
      margin-bottom: clamp(2rem, 1rem + 3vw, 4rem);
    }

    /* A minimum, not a height: the row eases down with the panel's width so the
       screens keep their proportions, and the card beside it can still ask
       for more. */
    .case_row {
      width: 100%;
      min-height: clamp(27rem, 42vw, 31.25rem);
      display: grid;
      gap: 1.5625rem;
      grid-template-columns: minmax(0, 915fr) minmax(0, 400fr);
    }

    .case_row.reversed {
      grid-template-columns: minmax(0, 400fr) minmax(0, 915fr);
    }

    .case_row.reversed .case_panel {
      order: 2;
    }

    .case_row + .case_row {
      margin-top: 1.5625rem;
    }

    @media (width < 62rem) {
      .case_row,
      .case_row.reversed {
        min-height: 0;
        gap: 1rem;
        grid-template-columns: minmax(0, 1fr);
      }
      .case_row.reversed .case_panel {
        order: 0;
      }
      .case_row + .case_row {
        margin-top: 0;
      }
      .cases_inner {
        gap: 2.5rem;
      }
    }

    /* On a phone the second line won't fit whole, and a set break would leave
       "results" alone on a third: the heading balances itself instead. */
    @media (width < 30rem) {
      .cases_break {
        display: none;
      }
    }
  }
</style>
