---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import { getClients, getProjects } from "@/utils/content.ts";

interface Props {
  /** Only show clients whose case study lists one of these services. */
  services: string[];
  title: string;
  titleMuted: string;
}

const { services, title, titleMuted } = Astro.props;

/* A client and its case study are separate files, joined by the client's name.
   The wall is filtered by what was actually done on the project, so a lane only
   shows the logos it earned. */
const [clients, projects] = await Promise.all([getClients(), getProjects()]);

const wall = clients
  .map((client) => ({
    client,
    project: projects.find((p) => p.data.client === client.data.name),
  }))
  .filter(({ project }) =>
    project?.data.services.some((used) => services.includes(used)),
  );

/**
 * Split into three standing columns rather than left to a grid.
 *
 * The rules between them have to run the full height of the wall, which a grid
 * can't do with a border on a cell — so the columns are real elements and the
 * logos are dealt into them here. Earlier columns take the extra when the count
 * doesn't divide.
 */
const COLUMNS = 3;
const per = Math.ceil(wall.length / COLUMNS);
const columns = Array.from({ length: COLUMNS }, (_, index) =>
  wall.slice(index * per, index * per + per),
).filter((column) => column.length > 0);
---

<Section
  theme="light"
  paddingTop="large"
  paddingBottom="large"
  containerClass="container-narrow"
  class="wall"
>
  <div class="wall_grid" data-reveal>
    <Heading tag="h2" class="heading-split wall_title">
      {title}
      <em>{titleMuted}</em>
    </Heading>

    <div class="wall_columns">
      {
        columns.map((column) => (
          <ul class="wall_column">
            {column.map(({ client, project }) => {
              /* The logo is the target, not just the pill under it — so the
                 whole cell is the link when there is a study to open. */
              const Cell = project ? "a" : "div";
              return (
                <li>
                  <Cell
                    class:list={["wall_cell", project && "is-linked"]}
                    href={project ? `/work/${project.id}` : undefined}
                  >
                    <Img
                      src={client.data.logo}
                      alt={client.data.name}
                      class="wall_logo"
                      transparent
                    />
                    {project && <span class="wall_study">Case study</span>}
                  </Cell>
                </li>
              );
            })}
          </ul>
        ))
      }
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    /* The heading takes about a quarter and the wall the rest, rather than the
       half each an `auto-fit` grid would hand out — the logos are the content
       here and the heading only labels them. */
    .wall_grid {
      width: 100%;
      display: grid;
      gap: var(--space-7) var(--space-8);
      grid-template-columns: minmax(0, 1fr);
      /* Top, not centre: the heading labels the wall, and a label sits at the
         head of what it labels. Centring it against a block whose height comes
         from however many logos a lane earned left it floating at a different
         place on every page. */
      align-items: start;
    }

    @media (width >= 60rem) {
      .wall_grid {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 2fr);
      }
    }

    /* A section heading, not a caption: `Heading` defaults to the h2 step and
       this block only stops it running the full column width. */
    /* No character cap: the column already decides the measure, and capping it
       again broke the heading over four ragged lines. */
    /* Nudged down by half a logo row, so the first line reads level with the
       first row of marks rather than with the empty space above them. */
    .wall_title {
      padding-top: var(--space-4);
      font-size: var(--h3);
      font-weight: var(--primary-semibold);
      text-wrap: balance;
    }

    @media (width < 60rem) {
      .wall_title {
        padding-top: 0;
      }
    }

    /* Even thirds, stated rather than fitted: an `auto-fit` grid narrows the
       columns to their content and the rules stop lining up. */
    .wall_columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }

    @media (width < 40rem) {
      .wall_columns {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* Real columns, so the rule between them runs the whole height of the wall
       rather than stopping at each logo the way a grid cell's border would. */
    .wall_column {
      display: flex;
      flex-direction: column;
      /* From the top, not centred: the last column holds one logo where the
         others hold two, and centring it left that one floating between the
         two rows instead of sitting in the first. */
      justify-content: flex-start;
      gap: var(--space-8);
      margin: 0;
      padding: var(--space-5) var(--space-6);
      border-left: var(--border-width) solid var(--border-soft);
      list-style: none;
    }

    .wall_column:first-child {
      border-left: 0;
    }

    .wall_cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-4);
      /* A reserved row height, so a logo that draws short doesn't pull its
         neighbours' pills out of line. */
      min-height: 6.5rem;
      padding: var(--space-4) var(--space-3);
      border-radius: var(--radius-card);
      color: inherit;
      text-decoration: none;
      transition: background-color var(--duration-main);
    }

    .wall_cell:focus-visible {
      outline: var(--focus-width) solid var(--text);
      outline-offset: var(--focus-offset);
    }

    @media (hover: hover) {
      .wall_cell.is-linked:hover {
        background-color: color-mix(in srgb, var(--text) 4%, transparent);
      }
    }

    /* Flattened to one colour the way `.trusted_logo` does it on the home page:
       the marks arrive black, white and coloured, and `brightness(0)` makes
       that irrelevant — trakpro.svg is white throughout and would be invisible
       otherwise. Capped by height so a wide wordmark and a squat mark read as
       the same size. */
    .wall_logo {
      /* Sized by width, the way `.trusted_logo` does it. Capping by height
         alone made the squat marks read tiny — Sustain stacks a symbol over
         three lines of type, so forty pixels tall is a fraction of the visual
         mass the same forty pixels give a single-line wordmark. The height cap
         stays as a ceiling for the tallest of them. */
      width: min(100%, 9.5rem);
      max-height: 3.5rem;
      height: auto;
      object-fit: contain;
      filter: brightness(0);
      opacity: 0.72;
      transition:
        opacity var(--duration-main),
        translate var(--duration-main) var(--ease-out);
    }

    @media (hover: hover) {
      .wall_cell.is-linked:hover .wall_logo,
      .wall_cell.is-linked:focus-visible .wall_logo {
        opacity: 1;
        translate: 0 -0.25rem;
      }
    }

    /* Always on show. It was worth trying as a hover reveal, but a label that
       only exists under a pointer is a label most readers never see — and on a
       wall whose whole job is to say "there is a story behind this logo", that
       is the wrong thing to hide. The hover lives on the logo instead. */
    .wall_study {
      padding: 0.3125rem 0.75rem;
      border: var(--border-width) solid
        color-mix(in srgb, var(--brand-500) 35%, transparent);
      border-radius: var(--radius-round);
      color: var(--brand-500);
      font-size: var(--text-tiny);
      white-space: nowrap;
      transition:
        background-color var(--duration-main),
        border-color var(--duration-main);
    }

    @media (hover: hover) {
      .wall_cell:hover .wall_study,
      .wall_cell:focus-visible .wall_study {
        background-color: color-mix(in srgb, var(--brand-500) 10%, transparent);
        border-color: var(--brand-500);
      }
    }
  }
</style>
