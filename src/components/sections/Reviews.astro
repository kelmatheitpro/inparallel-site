---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import Tabs from "@/components/inparallel/Tabs.astro";
import { activeTab } from "@/utils/tabs.ts";
import TabPanel from "@/components/inparallel/TabPanel.astro";
import type { ImageMetadata } from "astro";
import { REVIEWS } from "@/data/home.ts";
import ballerineWhite from "@/assets/inparallel/logos/ballerine-white.svg";
import ballerineWatermark from "@/assets/inparallel/logos/ballerine-watermark.svg";

/* Ballerine is the one client with a wordmark drawn for this card; the rest
   are named in type until their marks are exported. */
const marks: Record<string, { mark: ImageMetadata; watermark: ImageMetadata }> =
  {
    ballerine: { mark: ballerineWhite, watermark: ballerineWatermark },
  };

const tabs = REVIEWS.map(({ id, client }) => ({ id, label: client }));
const active = activeTab(tabs, "ballerine");
---

<Section id="reviews" theme="light" align="center">
  <Heading tag="h2" variant="h1" class="heading-split reviews_title">
    Verified reviews, <em>real stories</em>
  </Heading>

  <Tabs
    tabs={tabs}
    label="Client reviews"
    variant="pill"
    initial="ballerine"
    class="reviews_tabs"
  >
    {
      REVIEWS.map((review) => (
        <TabPanel id={review.id} active={review.id === active}>
          <figure class="reviews_card surface">
            {marks[review.id] && (
              <Img
                src={marks[review.id]!.watermark}
                class="surface-glow reviews_watermark"
                transparent
              />
            )}

            <div class="reviews_mark">
              {marks[review.id] ? (
                <Img
                  src={marks[review.id]!.mark}
                  alt={review.client}
                  class="reviews_mark_img"
                  transparent
                />
              ) : (
                <span class="reviews_mark_text">{review.client}</span>
              )}
            </div>

            <blockquote class="reviews_quote">“{review.quote}”</blockquote>

            <figcaption class="reviews_by">
              <span class="reviews_role">{review.role}</span>
              <span class="reviews_meta">
                <span>{review.client}</span>
                <span aria-hidden="true">·</span>
                <span>{review.industry}</span>
              </span>
            </figcaption>
          </figure>
        </TabPanel>
      ))
    }
  </Tabs>
</Section>

<style is:global>
  @layer components {
    .reviews_title {
      text-align: center;
    }

    /* The tab strip sits under the card in this section, unlike the services
       one above it. */
    .reviews_tabs {
      align-items: center;
      gap: var(--space-6);
    }

    .reviews_tabs .tabs_list {
      order: 2;
    }

    .reviews_card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-6);
      width: min(41.75rem, 100%);
      min-height: 26.25rem;
      margin-inline: auto;
      padding: var(--space-8);
      background-color: var(--navy-900);
      border-radius: var(--radius-large);
      color: var(--light-100);
      text-align: center;
    }

    /* The oversized mark bleeding off the bottom edge of the card. */
    .reviews_watermark {
      bottom: -1.5rem;
      left: 50%;
      translate: -50% 0;
      width: 34rem;
      max-width: 110%;
      height: auto;
      opacity: 0.08;
    }

    .reviews_mark_img {
      width: 8.125rem;
      height: auto;
    }

    .reviews_mark_text {
      font-size: var(--h6);
      font-weight: var(--primary-semibold);
    }

    .reviews_quote {
      max-width: 30rem;
      margin: 0;
      font-size: var(--h5);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-large);
    }

    .reviews_by {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      font-size: var(--text-small);
    }

    .reviews_role {
      font-weight: var(--primary-semibold);
    }

    .reviews_meta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      color: rgb(255 255 255 / 0.6);
    }
  }
</style>
