---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import {
  NAVIGATOR_MESSY,
  NAVIGATOR_CLEAN,
  NAVIGATOR_CAPTION,
} from "@/data/services.ts";

const trees = [
  { id: "messy", label: "What we inherit", nodes: NAVIGATOR_MESSY },
  { id: "clean", label: "What we hand over", nodes: NAVIGATOR_CLEAN },
];
---

{
  /* Two Navigator trees, side by side. Anyone who has opened a Webflow project
     knows which one they were handed, and no adjective gets there as fast. */
}
<Section theme="dark" containerClass="container-narrow" class="build">
  <div slot="background" class="build_field" aria-hidden="true"></div>

  <div class="build_grid" data-reveal>
    <div class="build_intro">
      <Heading tag="h2" class="heading-split">
        Anyone can ship it. <em>We hand it over readable.</em>
      </Heading>
      <Paragraph class="text-muted build_lead">
        {NAVIGATOR_CAPTION} Client-First naming, components that are actually components,
        and a CMS your marketing team can work in without opening a ticket.
      </Paragraph>
    </div>

    <div class="build_panes">
      {
        trees.map((tree) => (
          <figure class:list={["pane", tree.id]}>
            <figcaption class="pane_title">{tree.label}</figcaption>
            <ul class="pane_tree">
              {tree.nodes.map((node) => (
                <li class="pane_node" style={`--_depth:${node.depth}`}>
                  <span class="pane_label">{node.label}</span>
                </li>
              ))}
            </ul>
          </figure>
        ))
      }
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    .build {
      overflow: clip;
    }

    /* The hero's light, carried one section further down the page rather than
       stopping dead at a flat panel. */
    .build_field {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(
          60% 80% at 85% 20%,
          rgb(58 122 232 / 0.38),
          transparent 70%
        ),
        radial-gradient(
          50% 70% at 10% 90%,
          rgb(20 45 110 / 0.5),
          transparent 70%
        );
    }

    .build_grid {
      position: relative;
      z-index: 1;
      width: 100%;
      display: grid;
      gap: var(--space-7) var(--space-8);
      grid-template-columns: repeat(auto-fit, minmax(min(21rem, 100%), 1fr));
      align-items: center;
    }

    .build_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .build_lead {
      max-width: 30rem;
      font-size: var(--text-small);
    }

    .build_panes {
      display: grid;
      gap: var(--space-4);
      grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    }

    /* Glass rather than a filled box: two stacked whites so the panel is lit
       along its top edge, the way `.pill-glass` does it. */
    .pane {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin: 0;
      padding: var(--space-5);
      border: var(--border-width) solid rgb(255 255 255 / 0.16);
      border-radius: var(--radius-card);
      background-image: linear-gradient(
        to bottom,
        rgb(255 255 255 / 0.1),
        rgb(255 255 255 / 0.03)
      );
      box-shadow:
        inset 0 1px 1px 0 rgb(255 255 255 / 0.22),
        0 1.5rem 3rem -1rem rgb(3 8 24 / 0.55);
      backdrop-filter: blur(0.75rem);
    }

    .pane_title {
      font-size: var(--text-tiny);
      font-weight: var(--primary-semibold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: rgb(255 255 255 / 0.55);
    }

    .pane_tree {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
      /* A tree is the one place a monospaced face earns its keep: the indents
         line up because the characters do. */
      font-family: ui-monospace, "SF Mono", Menlo, monospace;
      font-size: 0.8125rem;
      line-height: 1.3;
    }

    .pane_node {
      padding-left: calc(var(--_depth, 0) * 0.7rem);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .pane_node::before {
      content: "";
      display: inline-block;
      width: 0.375rem;
      height: 0.375rem;
      margin-right: 0.5rem;
      border-radius: 1px;
      background-color: currentcolor;
      opacity: 0.4;
      vertical-align: middle;
    }

    .pane.messy .pane_label {
      color: rgb(255 255 255 / 0.42);
    }

    .pane.clean .pane_label {
      color: var(--brand-300);
    }

    @media (width < 48rem) {
      .pane {
        padding: var(--space-4);
      }
    }
  }
</style>
