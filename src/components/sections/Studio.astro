---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import ArrowLink from "@/components/inparallel/ArrowLink.astro";
import glowDiagonal from "@/assets/inparallel/glow-diagonal.svg";
import { STUDIO_CARDS } from "@/data/home.ts";
---

<Section id="studio" align="center">
  <Heading tag="h2" variant="h1" class="heading-split inline studio_title">
    One crew, zero handoffs, <em>fiercely honest</em>
  </Heading>

  <div class="studio_grid">
    {
      STUDIO_CARDS.map((card) => (
        <article class="studio_card">
          <div class:list={["studio_media surface", card.cutout && "cutout"]}>
            {card.cutout && (
              <Img
                src={glowDiagonal}
                class="surface-glow studio_glow"
                transparent
              />
            )}
            <Img
              src={card.image}
              alt={card.imageAlt}
              class="studio_image"
              variant="constrained"
              sizes="(width >= 50rem) 45vw, 92vw"
              transparent={card.cutout}
            />
          </div>
          <div class="studio_body">
            <h3 class="studio_card_title">{card.title}</h3>
            <p class="studio_text">{card.text}</p>
          </div>
          <ArrowLink href={card.href}>{card.linkLabel}</ArrowLink>
        </article>
      ))
    }
  </div>
</Section>

<style is:global>
  @layer components {
    .studio_title {
      text-align: center;
    }

    .studio_grid {
      width: 100%;
      display: grid;
      gap: var(--space-8);
      grid-template-columns: repeat(auto-fit, minmax(min(24rem, 100%), 1fr));
    }

    /* The heading is centred by the section; the cards under it are not. */
    .studio_card {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
      text-align: start;
    }

    .studio_media {
      width: 100%;
      height: 25rem;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border-soft);
    }

    .studio_image {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* The pair is a cut-out, so they stand on the frame's floor in front of
       the same diagonal light the hero panel gives them. */
    .studio_media.cutout {
      display: flex;
      justify-content: center;
      padding-top: var(--space-6);
    }

    .studio_media.cutout .studio_image {
      width: auto;
      object-fit: contain;
      object-position: bottom;
    }

    .studio_glow {
      top: -20%;
      left: 30%;
      width: 40%;
      height: 140%;
      max-width: none;
      rotate: var(--rake);
    }

    .studio_body {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .studio_card_title {
      font-size: var(--h4);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-small);
      letter-spacing: var(--letter-spacing-tight);
    }

    .studio_text {
      color: var(--text-muted);
      line-height: var(--line-height-large);
    }
  }
</style>
