---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import Icon from "@/components/Icon.astro";
import { CREW_CARDS } from "@/data/about.ts";
import mark from "@/assets/inparallel/mark.svg";

/**
 * How far each card is dropped below the top of the row.
 *
 * The design steps them up from left to right, so the eye climbs across the
 * set rather than reading three things stood in a line. The figures are in the
 * markup rather than picked off `:nth-child` because they are a composition,
 * not a series — a fourth card would want its own number, not the next one in
 * a pattern.
 */
const LIFTS = ["4.5rem", "2.25rem", "0rem"];
---

<Section
  id="crew"
  theme="light"
  paddingTop="large"
  paddingBottom="large"
  class="about-crew"
>
  {
    /* The mark's two bars, repeated the width of the section. They sit behind
       the cards at almost nothing, there to give the composition a grain to
       lean on rather than to be looked at. */
  }
  <span slot="background" class="about-crew_grain"></span>
  <span slot="background" class="about-crew_beam"></span>

  <div class="about-crew_head" data-reveal>
    <Heading tag="h2" variant="h2" class="about-crew_title">
      Small crew. Clear process. <span class="about-crew_title_line">
        Work that speaks for itself.
      </span>
    </Heading>
    <p class="about-crew_lead">
      No layers, no relay team. The people shaping the plan are the same people
      building the site.
    </p>
  </div>

  <div class="about-crew_grid" data-reveal>
    {
      CREW_CARDS.map((card, index) => (
        <article
          class="about-crew_card surface theme-dark"
          style={`--_lift: ${LIFTS[index] ?? "0rem"}; --_i: ${index};`}
        >
          {card.image ? (
            <Img
              src={card.image}
              alt={card.alt}
              class="about-crew_photo"
              variant="constrained"
              sizes="(min-width: 60rem) 22rem, 92vw"
            />
          ) : (
            <span class="about-crew_plate">
              <Icon src={mark} class="about-crew_plate_mark" />
            </span>
          )}

          {
            /* Two scrims rather than one: the title reads off the top of the
               picture and the copy off the bottom, and a single wash dark
               enough for both would leave no picture in between. */
          }
          <span class="about-crew_scrim"></span>
          <span class="about-crew_sheen"></span>

          <h3 class="about-crew_card_title">{card.title}</h3>
          <p class="about-crew_card_text">{card.text}</p>
        </article>
      ))
    }
  </div>
</Section>

<style is:global>
  @layer components {
    .about-crew {
      overflow: clip;
    }

    /* 116deg puts the stripes at the site's own 26° off vertical — the angle
       the mark leans at, and the one the hero beams are raked to. */
    .about-crew_grain {
      background-image: repeating-linear-gradient(
        116deg,
        transparent 0 7.5rem,
        color-mix(in srgb, var(--brand-500) 7%, transparent) 7.5rem 7.5625rem
      );
      mask-image: radial-gradient(
        120% 90% at 50% 40%,
        #000 20%,
        transparent 78%
      );
    }

    /* One bar off that same set, lit and drifting. It is the light-theme
       counterpart of the beams behind the hero, kept to a single line because
       a pale section shows far more of one than a dark section does. */
    .about-crew_beam {
      --_thickness: 0.125rem;
      width: var(--_thickness) !important;
      height: 200% !important;
      inset: -50% auto auto 18% !important;
      background-image: linear-gradient(
        to bottom,
        transparent 30%,
        color-mix(in srgb, var(--brand-500) 40%, transparent) 46%,
        color-mix(in srgb, var(--brand-500) 55%, transparent) 54%,
        transparent 70%
      );
      rotate: var(--rake);
      /* A pale section shows far more of a beam than a dark one does, and this
         one crosses the copy. Kept to a tint the text reads straight through,
         and faded out where it would otherwise pass behind a line of it. */
      opacity: 0.35;
      mask-image: radial-gradient(
        140% 60% at 50% 60%,
        #000 30%,
        transparent 75%
      );
      animation: about-crew-drift 26s -7s infinite ease-in-out;
    }

    @keyframes about-crew-drift {
      from,
      to {
        translate: 0 0;
      }
      50% {
        translate: 4rem 0;
      }
    }

    /* ---- the head ------------------------------------------------------- */
    .about-crew_head {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
    }

    /* The resting state every reveal starts from, set only where there is a
       script to bring it out of one. A reader without JavaScript — or a
       renderer that isn't running it — gets the page already arrived rather
       than a section that never does. */
    @media (scripting: enabled) {
      .about-crew_head {
        opacity: 0;
        translate: 0 1.25rem;
        transition:
          opacity var(--duration-slow) ease-out,
          translate var(--duration-slow) var(--ease-out);
      }

      .about-crew_card {
        opacity: 0;
        translate: 0 2rem;
        transition:
          opacity var(--duration-slow) calc(var(--_i) * 140ms) ease-out,
          translate var(--duration-slow) calc(var(--_i) * 140ms)
            var(--ease-out);
      }
    }

    .about-crew_head.is-revealed {
      opacity: 1;
      translate: none;
    }

    .about-crew_title {
      letter-spacing: var(--letter-spacing-tight);
    }

    /* The design breaks the heading between its two sentences. A phone has no
       room to honour that and wrap what is left sensibly, so below the width
       where both lines fit it lets the text find its own breaks — the same
       call `.heading-split.inline` makes about the accent line. */
    @media (width >= 48rem) {
      .about-crew_title_line {
        display: block;
      }
    }

    .about-crew_lead {
      max-width: 30rem;
      color: var(--text-muted);
      line-height: var(--line-height-large);
    }

    /* ---- the cards ------------------------------------------------------ */
    .about-crew_grid {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-5);
      margin-top: var(--space-6);
    }

    .about-crew_card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-6);
      min-height: clamp(20rem, 30vw, 26rem);
      padding: var(--space-5);
      margin-top: var(--_lift);
      background-color: var(--dark-900);
    }

    .about-crew_grid.is-revealed .about-crew_card {
      opacity: 1;
      translate: none;
    }

    /* The lift is a composition for a row of three. Once they stack there is
       no row left to step up, so it goes. */
    @media (width < 60rem) {
      .about-crew_grid {
        grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      }
      .about-crew_card {
        margin-top: 0;
      }
    }

    .about-crew_photo,
    .about-crew_plate {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: scale var(--duration-slow) var(--ease-out);
    }

    .about-crew_plate {
      display: flex;
      align-items: center;
      justify-content: center;
      background-image: linear-gradient(
        160deg,
        rgb(255 255 255 / 0.08),
        transparent 55%
      );
    }

    .about-crew_plate_mark {
      --_size: 2.5rem;
      width: 2.5rem;
      height: auto;
      color: var(--light-100);
      opacity: 0.12;
    }

    .about-crew_scrim {
      position: absolute;
      inset: 0;
      z-index: 0;
      background-image:
        linear-gradient(to bottom, rgb(10 13 18 / 0.8), transparent 42%),
        linear-gradient(to top, rgb(10 13 18 / 0.88), transparent 48%);
    }

    /* A raked bar of light parked off the card's left edge, sent across it on
       hover. Same angle as everything else; the card is the only thing on this
       page that catches it. */
    .about-crew_sheen {
      position: absolute;
      top: -30%;
      left: -60%;
      z-index: 0;
      width: 45%;
      height: 160%;
      background-image: linear-gradient(
        to right,
        transparent,
        rgb(255 255 255 / 0.13),
        transparent
      );
      rotate: var(--rake);
      transition: translate 900ms var(--ease-out);
    }

    .about-crew_card_title {
      font-size: var(--h5);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-medium);
      letter-spacing: var(--letter-spacing-tight);
      text-wrap: balance;
    }

    .about-crew_card_text {
      color: var(--text-muted);
      font-size: var(--text-small);
      line-height: var(--line-height-large);
    }

    @media (hover: hover) {
      .about-crew_card {
        transition:
          opacity var(--duration-slow) calc(var(--_i) * 140ms) ease-out,
          translate var(--duration-slow) calc(var(--_i) * 140ms)
            var(--ease-out);
      }

      .about-crew_grid.is-revealed .about-crew_card:hover {
        translate: 0 -0.5rem;
      }

      .about-crew_card:hover :is(.about-crew_photo, .about-crew_plate) {
        scale: 1.06;
      }

      .about-crew_card:hover .about-crew_sheen {
        translate: 320% 0;
      }
    }
  }
</style>
