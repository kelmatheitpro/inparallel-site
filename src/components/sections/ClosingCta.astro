---
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Img from "@/components/Img.astro";
import ArrowLink from "@/components/inparallel/ArrowLink.astro";
import heroGlow from "@/assets/inparallel/hero-glow.svg";
import { CLOSING } from "@/data/services.ts";
---

<Section
  theme="light"
  paddingTop="even"
  paddingBottom="even"
  containerClass="signoff_container"
>
  <div class="signoff surface theme-dark" data-reveal>
    <Img src={heroGlow} class="surface-glow signoff_glow" transparent />

    <div class="signoff_body">
      <Heading tag="h2" variant="h3" class="heading-split signoff_title">
        {CLOSING.title}
        <em>{CLOSING.titleMuted}</em>
      </Heading>
      <p class="signoff_lead">{CLOSING.lead}</p>

      <div class="signoff_actions">
        <a class="cta" href={CLOSING.cta.href}>{CLOSING.cta.label}</a>
      </div>
    </div>

    {
      /* The agencies who want hands rather than a project are a different
         reader, so they get a door out rather than the same button. */
    }
    <p class="signoff_aside">
      <span class="text-muted">{CLOSING.aside.text}</span>
      <ArrowLink href={CLOSING.aside.href}>{CLOSING.aside.label}</ArrowLink>
    </p>
  </div>
</Section>

<style is:global>
  @layer components {
    .signoff_container {
      gap: 0;
    }

    .signoff {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
      padding: var(--space-8) clamp(var(--space-6), 7vw, 6.25rem);
      background-color: var(--dark-900);
      border-radius: var(--radius-large);
    }

    .signoff_glow {
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top right;
    }

    .signoff_body {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: var(--space-5);
      max-width: 40rem;
    }

    .signoff_title {
      font-weight: var(--primary-semibold);
    }

    .signoff_lead {
      color: var(--text-muted);
      line-height: var(--line-height-large);
    }

    .signoff_actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-top: var(--space-2);
    }

    .signoff_aside {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-5);
      padding-top: var(--space-6);
      border-top: var(--border-width) solid var(--border-soft);
      font-size: var(--text-small);
    }
  }
</style>
