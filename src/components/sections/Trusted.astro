---
/**
 * "Trusted by ambitious teams": a client on camera beside the wall of logos.
 *
 * The film card is Or at Ballerine, with the one number from that study. The
 * still is a 16:9 recording set upright, which is why it takes the middle of
 * the frame rather than being letterboxed; the film itself comes from
 * `VIDEO_STORIES`, so its address is written once and the play button appears
 * by itself the day it's there.
 *
 * On a service's own page the section takes that service's colour.
 */
import Section from "@/components/Section.astro";
import SectionHead from "@/components/parallel/SectionHead.astro";
import ArrowLink from "@/components/inparallel/ArrowLink.astro";
import PlayButton from "@/components/inparallel/PlayButton.astro";
import ClientCard from "@/components/inparallel/ClientCard.astro";
import Img from "@/components/Img.astro";
import { getClients, getProjects } from "@/utils/content.ts";
import { VIDEO_STORIES } from "@/data/parallel.ts";
import { laneStyle } from "@/data/service-pages.ts";
import type { Service } from "@/data/offer.ts";

interface Props {
  /** The service whose page this is, for its colour. */
  service?: Service;
}

const { service } = Astro.props;

const clients = await getClients();

/* The heading's claim is about industries, not logos: two clients can share
   one, so it counts the distinct ones rather than the cards. */
const industries = new Set(
  clients.map(({ data }) => data.industry).filter(Boolean),
).size;

const story = VIDEO_STORIES.find(({ client }) => client === "Ballerine");
const study = (await getProjects()).find(({ id }) => id === "ballerine");
---

<Section
  id="trusted"
  gap="8"
  theme="light"
  class:list={["trusted-p", service && "has-lane"]}
  style={service ? laneStyle(service) : undefined}
>
  <SectionHead index="01" label="Clients">
    Trusted by ambitious teams <br />across {industries} industries
    <ArrowLink slot="aside" href="/work">See the case studies</ArrowLink>
  </SectionHead>

  <div class="trusted_content">
    {
      story && study && (
        <article class="trusted_film" data-anim="image">
          <Img
            src={story.poster}
            alt={`${story.name} of ${story.client}, talking about the project`}
            class="trusted_film_still"
            variant="constrained"
            sizes="(width >= 80rem) 50rem, (width >= 48rem) 92vw, min(222vw, 50rem)"
          />
          <span class="trusted_film_shade" aria-hidden="true" />
          <div class="trusted_film_body">
            <div class="trusted_film_top">
              <span class="trusted_film_tag">
                <Img
                  src={story.logo}
                  alt={story.client}
                  class="trusted_film_logo"
                  transparent
                />
              </span>
              {story.video && (
                <PlayButton
                  size="tile"
                  label={`Play ${story.name}'s story`}
                  video={story.video}
                  poster={story.poster.src}
                  caption={`${story.name} · ${story.client}`}
                  class="trusted_film_play"
                />
              )}
            </div>
            <p class="trusted_film_stats">
              <span class="trusted_film_stat">{study.data.stat}</span>
              <span class="trusted_film_label">{study.data.statLabel}</span>
            </p>
          </div>
        </article>
      )
    }

    <div class="trusted_grid" data-anim-group data-stagger="0.05">
      {
        clients.map((client) => (
          <div class="trusted_cell" data-anim="rise">
            <ClientCard client={client} />
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style is:global>
  @layer components {
    /* A service's page: the section's ink, the film's shade and the cards all
       take its colour, and nothing else about the section changes. */
    .trusted-p.has-lane {
      --text: var(--lane-dark);
      --trusted-top: color-mix(
        in srgb,
        var(--lane-accent) 34%,
        var(--lane-dark)
      );
      --trusted-bottom: var(--lane-dark);
      --trusted-shade: var(--lane-dark);
      --trusted-flag: var(--lane-dark);
      --trusted-arrow: var(--lane-accent);
      --arrow-fill: var(--lane-dark);
      --arrow-ink: var(--light-100);
      color: var(--text);
    }

    .trusted_content {
      width: 100%;
      display: grid;
      grid-template-columns: 21.875rem minmax(0, 1fr);
      gap: 1.5625rem;
    }

    /* ---- the film ------------------------------------------------------- */
    .trusted_film {
      position: relative;
      isolation: isolate;
      height: 28.125rem;
      overflow: clip;
      border-radius: 1rem;
      background-color: var(--dark-850);
    }

    .trusted_film_still {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      max-width: none;
      height: 100%;
      object-fit: cover;
      object-position: 50% 50%;
      transition: scale 0.6s var(--ease-out);
    }

    .trusted_film_shade {
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image: linear-gradient(
        to bottom,
        color-mix(
          in srgb,
          var(--trusted-shade, var(--ink-900)) 40%,
          transparent
        ),
        transparent 50%,
        color-mix(
          in srgb,
          var(--trusted-shade, var(--ink-900)) 72%,
          transparent
        )
      );
    }

    .trusted_film_body {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.5625rem;
      color: var(--light-100);
    }

    .trusted_film_top {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 1rem;
    }

    .trusted_film_tag {
      display: flex;
      padding: 0.625rem;
      background-color: var(--trusted-shade, var(--ink-900));
      border-radius: 0.5rem;
    }

    .trusted_film_logo {
      width: auto;
      height: 1.25rem;
    }

    .trusted_film_stats {
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
      margin: 0;

      /* A flex column on a `<p>`: the leading trim's pseudo-elements would be
         empty items in it, adding a gap at each end. */
      &::before,
      &::after {
        content: none;
      }
    }

    .trusted_film_stat {
      font-size: 2.75rem;
      font-weight: 600;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    .trusted_film_label {
      font-size: 1rem;
      line-height: 1.2;
      opacity: 0.72;
    }

    @media (hover: hover) {
      .trusted_film:hover .trusted_film_still {
        scale: 1.03;
      }

      .trusted_film:hover .trusted_film_play {
        scale: 1.08;

        &::after {
          opacity: 1;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .trusted_film_still {
        transition: none;
      }

      .trusted_film:hover .trusted_film_still {
        scale: 1;
      }
    }

    /* ---- the wall ------------------------------------------------------- */
    .trusted_grid {
      display: grid;
      gap: 1.5625rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
    }

    .trusted_cell {
      display: flex;
      min-width: 0;

      & > .client-card {
        width: 100%;
      }
    }

    /* ---- narrower ------------------------------------------------------- */
    /* The film goes above the wall at its own 16:9, never so wide and low that
       the head would leave the frame: the still needs 78% of its height to
       keep him whole, hair to beard, which is the height cap at the widest
       this layout runs. */
    @media (width < 80rem) {
      .trusted_content {
        grid-template-columns: minmax(0, 1fr);
      }
      .trusted_film {
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        max-height: 32.5rem;
      }
      .trusted_film_still {
        object-position: 50% 9%;
      }
      .trusted_grid {
        grid-auto-rows: 12.5rem;
      }
    }

    @media (width < 62rem) {
      .trusted_grid {
        gap: 1rem;
        grid-auto-rows: 10rem;
      }
    }

    @media (width < 48rem) {
      .trusted_film {
        aspect-ratio: 4 / 5;
        max-height: 28.125rem;
      }
      .trusted_film_body {
        padding: 1.25rem;
      }
      .trusted_grid {
        gap: 0.75rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 7.5rem;
      }
    }
  }
</style>
