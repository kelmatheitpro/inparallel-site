---
import Layout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/parallel/PageHero.astro";
import SectionHead from "@/components/parallel/SectionHead.astro";
import Todo from "@/components/pricing/Todo.astro";
import CallVisual from "@/components/contact/CallVisual.astro";
import NextSteps from "@/components/contact/NextSteps.astro";
import EnquiryForm from "@/components/contact/EnquiryForm.astro";
import ContactDetails from "@/components/contact/ContactDetails.astro";
import { BOOKING_URL } from "@/components/contact/copy.ts";
import { CONTACT_EMAIL } from "@/consts.ts";

/* Until there is a calendar to pick a time in, the call is asked for by
   email — the button says so rather than pretending to be a booking. */
const booking = BOOKING_URL ?? `mailto:${CONTACT_EMAIL}?subject=Intro%20call`;
---

<Layout
  theme="dark"
  overlap
  title="Contact"
  description="Book a free 30-minute call with the two people who'd do the work — or send a brief and hear back, usually the same day."
>
  <PageHero
    label="Contact"
    lead="Pick a time. We'll spend half an hour on your project, what you're trying to solve, and whether we're a fit."
  >
    The first 30 minutes <br />are on <span class="serif">us</span>.
    <Fragment slot="actions">
      <a class="btn" href={booking}>
        {BOOKING_URL ? "Pick a time" : "Ask for a time"}
      </a>
      <a class="btn btn-ghost" href="#enquiry">Send a brief instead</a>
      {
        !BOOKING_URL && (
          <Todo class="contact-hero_todo">
            booking link. Until inParallel's calendar is set, "Ask for a time"
            opens an email.
          </Todo>
        )
      }
    </Fragment>
    <CallVisual slot="visual" />
    <NextSteps slot="after" />
  </PageHero>

  <section
    id="enquiry"
    class="enquiry theme-light"
    aria-labelledby="enquiry-title"
  >
    <div class="enquiry_inner">
      <SectionHead
        index="01"
        label="Write to us"
        headingId="enquiry-title"
        lead="Tell us what you're building and what's in the way. You'll usually hear back the same day, from one of the two of us."
      >
        Rather write it <span class="serif">down</span>?
      </SectionHead>

      <div class="enquiry_grid">
        <EnquiryForm />
        <ContactDetails />
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @layer components {
    /* The note sits on a line of its own under the two buttons. */
    .contact-hero_todo {
      flex-basis: 100%;
      max-width: 30rem;
      color: rgb(255 255 255 / 0.7);
    }

    .enquiry {
      padding-block: var(--section-space-large, 8rem);
      background-color: var(--light-200);
    }

    .enquiry_inner {
      width: min(100% - var(--site-margin) * 2, var(--max-width-main));
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    }

    .enquiry_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: clamp(2.5rem, 2rem + 2vw, 4rem);

      @media (width >= 62rem) {
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      }
    }
  }
</style>
