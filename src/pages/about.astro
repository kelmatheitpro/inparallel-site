---
import Layout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/parallel/PageHero.astro";
import CtaBand from "@/components/parallel/CtaBand.astro";
import AboutHeroVisual from "@/components/about/AboutHeroVisual.astro";
import AboutName from "@/components/about/AboutName.astro";
import AboutPeople from "@/components/about/AboutPeople.astro";
import AboutProcess from "@/components/about/AboutProcess.astro";
import AboutMap from "@/components/about/AboutMap.astro";
import AboutValues from "@/components/about/AboutValues.astro";
import WorkInMotion from "@/components/home/WorkInMotion.astro";
import Lightbox from "@/components/inparallel/Lightbox.astro";
---

<Layout
  theme="dark"
  overlap
  title="About the studio"
  description="inParallel is Aleksandar Dumić and Darko Milošević: two co-founders of a Webflow studio in Belgrade, both planning, designing, building and growing sites for teams worldwide."
>
  <PageHero
    label="About us"
    lead="inParallel is Aleksandar Dumić and Darko Milošević: two co-founders, one Webflow studio in Belgrade, working with teams all over the world."
  >
    Two people, working as <span class="serif">one</span> team.
    <a slot="actions" class="btn" href="/contact"> Book an intro call </a>
    <a slot="actions" class="btn btn-ghost" href="#people">Meet the two of us</a
    >
    <AboutHeroVisual slot="visual" />
  </PageHero>

  <AboutName />
  <AboutPeople />
  <AboutProcess />
  <AboutMap />
  <AboutValues />
  <CtaBand />
  <WorkInMotion index="06" />

  {/* One dialog serves every play button above it. */}
  <Lightbox />
</Layout>
