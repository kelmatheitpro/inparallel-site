---
import Layout from "@/layouts/BaseLayout.astro";
import ServicesHero from "@/components/sections/ServicesHero.astro";
import ProofStrip from "@/components/sections/ProofStrip.astro";
import ServiceLanes from "@/components/sections/ServiceLanes.astro";
import QuoteEstimate from "@/components/sections/QuoteEstimate.astro";
import ComparisonTable from "@/components/sections/ComparisonTable.astro";
import ClientProof from "@/components/sections/ClientProof.astro";
import WhereWebflowStops from "@/components/sections/WhereWebflowStops.astro";
import Beliefs from "@/components/sections/Beliefs.astro";
import AlwaysIncluded from "@/components/sections/AlwaysIncluded.astro";
import DontDo from "@/components/sections/DontDo.astro";
import TwoOfUs from "@/components/sections/TwoOfUs.astro";
import ServicesFaq from "@/components/sections/ServicesFaq.astro";
import ClosingCta from "@/components/sections/ClosingCta.astro";
---

{
  /* A junction, not a catalogue. Its job is to get the visitor onto the one
     lane that matches where their site is today — so it names the four, lets
     them be compared and priced, and then argues for the studio rather than
     for any one service. Everything specific to a lane lives on its own page. */
}
<Layout
  theme="light"
  overlap
  title="Services"
  description="Four ways to work with a two-person Webflow studio — design, build, launch, or a retained crew. Fixed price, quoted within 24 hours."
>
  <ServicesHero variant="both" />
  <ProofStrip />

  {/* Pick a lane. */}
  <ServiceLanes />
  <QuoteEstimate />
  <ComparisonTable />

  {/* Then the case for us, whichever lane they took. */}
  <ClientProof />
  <WhereWebflowStops />
  <Beliefs />
  <AlwaysIncluded />
  <DontDo />
  <TwoOfUs />
  <ServicesFaq />
  <ClosingCta />
</Layout>
