---
import Layout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/parallel/PageHero.astro";
import CtaBand from "@/components/parallel/CtaBand.astro";
import Trusted from "@/components/sections/Trusted.astro";
import Lightbox from "@/components/inparallel/Lightbox.astro";
import ServiceDoors from "@/components/services/ServiceDoors.astro";
import ServiceRows from "@/components/services/ServiceRows.astro";
import CompareTable from "@/components/services/CompareTable.astro";
import ServiceFinder from "@/components/services/ServiceFinder.astro";
import ServiceFigures from "@/components/services/ServiceFigures.astro";
import WebflowLimits from "@/components/services/WebflowLimits.astro";
import ServiceFaq from "@/components/services/ServiceFaq.astro";
import { OVERVIEW_FAQ, OVERVIEW_RESULTS } from "@/data/service-pages.ts";
---

{
  /* The way in, not the catalogue: name the four, set them side by side,
     help the undecided pick one, say plainly where Webflow and we stop, and
     send each reader on to the page for their service, where the process
     and the proof live. */
}
<Layout
  theme="dark"
  overlap
  title="Webflow services: design, development, SEO and growth"
  description="Four ways in, two senior people behind them: Webflow design and development, Webflow builds from your designs, SEO and AEO, and ongoing growth."
>
  <PageHero
    label="Services"
    lead="Webflow design and development, builds from your own designs, SEO and AEO, and growth after launch. Whichever way in, the two of us do the work."
  >
    Four ways in. <br /><span class="serif">Two</span> people behind them.
    <Fragment slot="actions">
      <a class="btn" href="#services"> Explore the services </a>
      <a class="btn btn-ghost" href="/work">See our work</a>
    </Fragment>
    <ServiceDoors slot="after" />
  </PageHero>

  <Trusted />
  <ServiceRows index="02" />
  <CompareTable index="03" />
  <ServiceFinder index="04" />
  <ServiceFigures results={OVERVIEW_RESULTS} index="05" />
  <CtaBand />
  <WebflowLimits index="06" />
  <ServiceFaq items={OVERVIEW_FAQ} index="07" theme="dark" />

  {/* The one dialog the client film in the logo wall opens into. */}
  <Lightbox />
</Layout>

<style is:global>
  /* The page is dark at its root, which lights every label's strokes for a
     dark section: on cream they'd all but vanish. */
  main .trusted-p .label_slash,
  main .theme-light .label_slash {
    color: var(--brand-500);
  }
</style>
