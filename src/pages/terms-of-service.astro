---
import Layout from "@/layouts/BaseLayout.astro";
import LegalPage from "@/components/legal/LegalPage.astro";
import { Content, getHeadings } from "@/components/legal/terms-of-service.md";
---

<Layout
  theme="dark"
  overlap
  title="Terms of service"
  description="The terms that apply when you use the inParallel website or work with the studio: scope, payment, revisions and intellectual property."
>
  <LegalPage
    title="Terms of service"
    lead="The terms that apply when you use this website or work with inParallel: scope, payment, revisions and who owns what."
    headings={getHeadings()}
  >
    <Content />
  </LegalPage>
</Layout>
