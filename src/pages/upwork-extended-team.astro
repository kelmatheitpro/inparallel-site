---
import Layout from "@/layouts/BaseLayout.astro";
import ArrowCircle from "@/components/inparallel/ArrowCircle.astro";
import PageHero from "@/components/parallel/PageHero.astro";
import SectionHead from "@/components/parallel/SectionHead.astro";
import Todo from "@/components/pricing/Todo.astro";
import Questions from "@/components/pricing/Questions.astro";
import Band from "@/components/extended/Band.astro";
import TeamStrokes from "@/components/extended/TeamStrokes.astro";
import FactsBar from "@/components/extended/FactsBar.astro";
import CardRow from "@/components/extended/CardRow.astro";
import TickList from "@/components/extended/TickList.astro";
import NumberedList from "@/components/extended/NumberedList.astro";
import NotList from "@/components/extended/NotList.astro";
import MarginCalculator from "@/components/extended/MarginCalculator.astro";
import {
  DETAILS,
  HERO_FACTS,
  GUARANTEES,
  STEPS,
  PRICING_NOTE,
  UPWORK_MECHANICS,
  MECHANICS_NOTE,
  PROOF,
  SITUATIONS,
  NOT_DOING,
  FAQ,
} from "@/data/upwork.ts";

/* "Four steps, three of them ours": the first is his, the rest are ours,
   and each says so. */
const steps = STEPS.map((step, index) => ({
  ...step,
  tag: index === 0 ? "You" : "Us",
}));

const cloneLinksUnset = DETAILS.cloneOne === "#" || DETAILS.cloneTwo === "#";
---

<Layout
  theme="dark"
  overlap
  title="White-label Webflow for Upwork freelancers"
  description="Take the work you're turning down. We build Webflow sites under your name, in your workspace — your client never knows we exist."
>
  <PageHero
    label="For Upwork freelancers"
    lead="We build Webflow sites under your name. Your client never knows we exist, and your review stays yours."
  >
    You're turning down work <br />you could be&nbsp;<span class="serif"
      >taking</span
    >
    <a slot="actions" class="btn" href={DETAILS.briefHref}>
      Send a Figma link, get a quote in {DETAILS.quoteWithin}
    </a>
    <TeamStrokes
      slot="visual"
      title="In parallel with you"
      groups={[
        { label: "You", count: 1, tone: "white" },
        { label: "Us, under your name", count: 2, tone: "bright" },
      ]}
    />
    <FactsBar slot="after" facts={HERO_FACTS} />
  </PageHero>

  {
    /* Straight under the hero, not at the foot of the page: the three
       guarantees are the reason he keeps reading at all. */
  }
  <Band theme="light" id="how-it-works">
    <CardRow items={GUARANTEES} headingTag="h2" />

    <SectionHead index="01" label="How it works" headingId="steps-title">
      Four steps, <br />three of them ours
    </SectionHead>
    <NumberedList items={steps} columns={4} />
  </Band>

  {/* ---- 02: the sum ---------------------------------------------------- */}
  <Band theme="dark" id="margin" labelledby="margin-title">
    <SectionHead index="02" label="The sum" headingId="margin-title">
      What's left for you, <br />without asking us
    </SectionHead>
    <MarginCalculator />
    <p class="band_note">{PRICING_NOTE}</p>
  </Band>

  {/* ---- 03: the Upwork part nobody writes down, and the proof ---------- */}
  <Band theme="light" id="upwork" labelledby="upwork-title">
    <div class="band_split">
      <div class="band_column">
        <SectionHead
          index="03"
          label="On Upwork"
          size="h3"
          headingId="upwork-title"
        >
          How this works on Upwork
        </SectionHead>
        <TickList items={UPWORK_MECHANICS} />
        <p class="band_note">{MECHANICS_NOTE}</p>
      </div>

      <div class="band_column">
        <SectionHead
          label="The proof"
          size="h3"
          headingId="proof-title"
          lead="Everything we do is under someone else's name, so the only honest proof is a build you can open. Clone one and read the class names."
        >
          Proof, since there's no portfolio
        </SectionHead>
        <TickList items={PROOF} />
        <div class="band_notes">
          <div class="fl-links">
            <a class="fl-link" href={DETAILS.cloneOne}>
              Clone the landing page build
              <ArrowCircle bare />
            </a>
            <a class="fl-link" href={DETAILS.cloneTwo}>
              Clone the CMS build
              <ArrowCircle bare />
            </a>
          </div>
          {
            cloneLinksUnset && (
              <Todo>
                links to the two builds to clone (DETAILS.cloneOne and cloneTwo
                in src/data/upwork.ts).
              </Todo>
            )
          }
        </div>
      </div>
    </div>
  </Band>

  {/* ---- 04: the first one is free to walk away from -------------------- */}
  <Band theme="dark" id="first-project" labelledby="first-title">
    <div class="fl-first">
      <SectionHead
        index="04"
        label="The first project"
        align="center"
        headingId="first-title"
        lead="You see staging before you've paid anything. If it isn't right, you don't pay and neither of us owes the other a thing. The risk on a first job is yours to carry otherwise, and that's the only reason people say no to this."
      >
        First project: <br />you pay when you're&nbsp;happy
      </SectionHead>
      <a class="btn" href={DETAILS.briefHref}> Send the first one </a>
    </div>
  </Band>

  {/* ---- 05: when, what not, and the questions -------------------------- */}
  <Questions index="06" items={FAQ} name="freelancer-faq">
    Six questions, <br />in your words
    <Fragment slot="before">
      <SectionHead index="05" label="When to call" headingId="days-title">
        You'll want us <br />on one of these&nbsp;days
      </SectionHead>
      <CardRow items={SITUATIONS} />
      <NotList items={NOT_DOING} />
    </Fragment>
    <div slot="foot" class="fl-closing">
      <p class="fl-closing_line">
        Paste a Figma link. <br />Get a quote tomorrow.
      </p>
      <a class="btn btn-blue" href={DETAILS.briefHref}> Send it over </a>
    </div>
  </Questions>
</Layout>

<style is:global>
  @layer components {
    .fl-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.75rem;
    }

    /* A quiet underline, and a darker one drawn across it on hover from the
       left: one transform, nothing repainted. */
    .fl-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding-bottom: 0.2rem;
      border-bottom: var(--border-width) solid var(--border);
      color: var(--text);
      font-weight: 500;
      text-decoration: none;

      &::after {
        content: "";
        position: absolute;
        inset: auto 0 calc(var(--border-width) * -1);
        height: var(--border-width);
        background-color: currentcolor;
        transform: scaleX(0);
        transform-origin: 0 50%;
        transition: transform var(--duration-slow) var(--ease-out);
      }

      @media (hover: hover) {
        &:hover::after {
          transform: scaleX(1);
        }
      }

      &:focus-visible::after {
        transform: scaleX(1);
      }

      @media (prefers-reduced-motion: reduce) {
        &::after {
          transition: none;
        }
      }
    }

    .fl-first {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    }

    /* The page's last word, under the questions' heading. */
    .fl-closing {
      display: flex;
      flex-direction: column;
      align-items: start;
      gap: 1.25rem;
      margin-top: 0.75rem;
      padding-top: 1.75rem;
      border-top: var(--border-width) solid var(--border-soft);
    }

    .fl-closing_line {
      margin: 0;
      color: var(--text);
      font-size: clamp(1.35rem, 1.15rem + 0.7vw, 1.75rem);
      font-weight: 500;
      letter-spacing: -0.025em;
      line-height: 1.15;
    }
  }
</style>
