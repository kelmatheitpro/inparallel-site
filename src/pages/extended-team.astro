---
import Layout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/parallel/PageHero.astro";
import SectionHead from "@/components/parallel/SectionHead.astro";
import Todo from "@/components/pricing/Todo.astro";
import Questions from "@/components/pricing/Questions.astro";
import Band from "@/components/extended/Band.astro";
import TeamStrokes from "@/components/extended/TeamStrokes.astro";
import FactsBar from "@/components/extended/FactsBar.astro";
import CardRow from "@/components/extended/CardRow.astro";
import Models from "@/components/extended/Models.astro";
import Arrangements from "@/components/extended/Arrangements.astro";
import TickList from "@/components/extended/TickList.astro";
import NumberedList from "@/components/extended/NumberedList.astro";
import PriceTiers from "@/components/extended/PriceTiers.astro";
import NotList from "@/components/extended/NotList.astro";
import {
  DETAILS,
  HERO_FACTS,
  SCENARIOS,
  DELIVERABLES,
  PROCESS_FIT,
  RULES,
  STANDARD,
  COVERAGE,
  NOT_DOING,
  FAQ,
} from "@/data/extended-team.ts";

/* Links the owner's brief left as stand-ins: a booking page's home page, or
   nothing at all. Each is flagged on the page until it's real. */
const unsetLink = (href: string) => href === "#" || href === "https://cal.com/";
---

<Layout
  theme="dark"
  overlap
  title="Extended team for agencies"
  description="Two Webflow developers inside your team, from Monday. White-label, in your workspace, under your name — no hiring and no bench cost."
>
  <PageHero
    label="For agencies"
    lead="No hiring, no bench cost, and no mention of us in front of your client. You keep the relationship, the invoice and the credit."
  >
    Two Webflow developers <br />in your team, from&nbsp;<span class="serif"
      >Monday</span
    >
    <Fragment slot="actions">
      <a class="btn" href={DETAILS.callHref}> Book 20 minutes </a>
      <a class="btn btn-ghost" href="/contact"> Send a brief instead </a>
      {
        unsetLink(DETAILS.callHref) && (
          <Todo class="xt-hero_todo">
            booking link for "Book 20 minutes" (DETAILS.callHref in
            src/data/extended-team.ts).
          </Todo>
        )
      }
    </Fragment>
    <TeamStrokes
      slot="visual"
      title="In parallel with your team"
      groups={[
        { label: "Your team", count: 4, tone: "faint" },
        { label: "Two Webflow developers", count: 2, tone: "bright" },
      ]}
    />
    <FactsBar slot="after" facts={HERO_FACTS} />
  </PageHero>

  {/* ---- 01: who it's for ----------------------------------------------- */}
  <Band theme="light" id="who" labelledby="who-title">
    <SectionHead index="01" label="Who it's for" headingId="who-title">
      You're here because <br />one of these is true
    </SectionHead>
    <CardRow items={SCENARIOS} />
  </Band>

  {/* ---- 02: the two models, and the rest of the menu ------------------- */}
  <Band theme="dark" id="models" labelledby="models-title">
    <SectionHead index="02" label="How it runs" headingId="models-title">
      Two ways to run it, <br />and the rest on&nbsp;request
    </SectionHead>
    <Models />

    <SectionHead label="Other shapes" size="h3" headingId="arrangements-title">
      Other shapes this takes, <br />when those two don't fit
    </SectionHead>
    <Arrangements />
  </Band>

  {/* ---- 03: what you get, and how we fit ------------------------------- */}
  <Band theme="light" id="what-you-get" labelledby="get-title">
    <div class="band_split">
      <div class="band_column">
        <SectionHead
          index="03"
          label="What you get"
          size="h3"
          headingId="get-title"
          lead="“Senior developers” means nothing. These are countable."
        >
          What you actually get
        </SectionHead>
        <TickList items={DELIVERABLES} />
      </div>
      <div class="band_column">
        <SectionHead
          label="How we fit"
          size="h3"
          headingId="fit-title"
          lead="You shouldn't have to train the help. You won't."
        >
          How we fit your process
        </SectionHead>
        <TickList items={PROCESS_FIT} />
      </div>
    </div>
  </Band>

  {/* ---- 04: the rules -------------------------------------------------- */}
  <Band theme="dark" id="rules" labelledby="rules-title">
    <SectionHead index="04" label="The rules" headingId="rules-title">
      The rules, <br />written down before you&nbsp;ask
    </SectionHead>
    <NumberedList items={RULES} />
    <div class="band_notes">
      <p class="band_note">
        The NDA and the subcontractor agreement are written and ready to sign —{
          " "
        }<a href={DETAILS.ndaHref}>read them before you write to us</a>.
      </p>
      {
        unsetLink(DETAILS.ndaHref) && (
          <Todo>
            link to the NDA and subcontractor agreement (DETAILS.ndaHref).
          </Todo>
        )
      }
    </div>
  </Band>

  {/* ---- 05: the standard, and the ground it covers --------------------- */}
  <Band theme="light" id="standard" labelledby="standard-title">
    <SectionHead index="05" label="The standard" headingId="standard-title">
      What “built properly” <br />means here, exactly
    </SectionHead>
    <TickList items={STANDARD} columns={2} />
    <div class="band_notes">
      <p class="band_note">
        <a href={DETAILS.cloneHref}>Clone one of our builds</a> and look inside. It
        is a better argument than any case study, because you know what you're looking
        at.
      </p>
      {
        unsetLink(DETAILS.cloneHref) && (
          <Todo>link to a build to clone (DETAILS.cloneHref).</Todo>
        )
      }
    </div>

    <div class="xt-coverage">
      <h3 class="xt-coverage_title">What we cover</h3>
      <ul class="xt-coverage_list" role="list">
        {COVERAGE.map((item) => <li class="xt-coverage_item">{item}</li>)}
      </ul>
    </div>
  </Band>

  {/* ---- 06: price, availability, and a week to try it ------------------ */}
  <Band theme="dark" id="price" labelledby="price-title">
    <SectionHead index="06" label="Price" headingId="price-title">
      Price, <br />before you have to ask for&nbsp;it
    </SectionHead>
    <PriceTiers />
  </Band>

  {/* ---- 07: what we don't do, and the questions ------------------------ */}
  <Questions index="07" items={FAQ} name="agency-faq">
    The six questions <br />every agency&nbsp;asks
    <NotList slot="before" items={NOT_DOING} />
  </Questions>
</Layout>

<style is:global>
  @layer components {
    /* The note sits on a line of its own under the two buttons. */
    .xt-hero_todo {
      flex-basis: 100%;
      max-width: 30rem;
      color: rgb(255 255 255 / 0.7);
    }

    .xt-coverage {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
      border-top: var(--border-width) solid var(--border-soft);
    }

    .xt-coverage_title {
      margin: 0;
      font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem);
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .xt-coverage_list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* Each thing covered is a chip with a short stroke of the mark. */
    .xt-coverage_item {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.6rem;
      padding: 0 1rem 0 0.85rem;
      background-color: var(--light-100);
      border: var(--border-width) solid var(--border-soft);
      border-radius: 0.65rem;
      font-size: 0.9375rem;

      &::before {
        content: "";
        width: 0.2rem;
        height: 0.8rem;
        background-color: var(--brand-500);
        transform: skewX(calc(var(--slant) * -1));
      }
    }
  }
</style>
