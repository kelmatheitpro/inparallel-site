---
import Layout from "@/layouts/BaseLayout.astro";
import LegalPage from "@/components/legal/LegalPage.astro";
import { Content, getHeadings } from "@/components/legal/privacy-policy.md";
---

<Layout
  theme="dark"
  overlap
  title="Privacy policy"
  description="How inParallel collects, uses and protects your information when you visit this website or get in touch."
>
  <LegalPage
    title="Privacy policy"
    lead="How inParallel collects, uses and protects your information when you visit this website or get in touch."
    headings={getHeadings()}
  >
    <Content />
  </LegalPage>
</Layout>
