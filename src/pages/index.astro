---
import Layout from "@/layouts/BaseLayout.astro";
import HeroParallel from "@/components/home/HeroParallel.astro";
import WorkTracks from "@/components/home/WorkTracks.astro";
import Trusted from "@/components/sections/Trusted.astro";
import CaseStudies from "@/components/sections/CaseStudies.astro";
import ProofBand from "@/components/sections/ProofBand.astro";
import FourLanes from "@/components/home/FourLanes.astro";
import RelayParallel from "@/components/home/RelayParallel.astro";
import CtaBand from "@/components/parallel/CtaBand.astro";
import WorkInMotion from "@/components/home/WorkInMotion.astro";
import TwoStrokes from "@/components/home/TwoStrokes.astro";
import Lightbox from "@/components/inparallel/Lightbox.astro";
---

<Layout theme="dark" overlap title="Your Webflow team, in parallel with yours">
  <HeroParallel booking="/contact" />
  <WorkTracks />
  <Trusted />
  <CaseStudies />
  <ProofBand />
  <FourLanes />
  <RelayParallel />
  <CtaBand />
  <WorkInMotion />
  <TwoStrokes />
  {/* One dialog serves every play button above it. */}
  <Lightbox />
</Layout>
